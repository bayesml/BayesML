#: bayesml.sparselinearregression:1 of
msgid ""
"This module provides the sparse linear regression model with the Laplace "
"prior distribution (represented as a Gaussian scale mixture)."
msgstr ""

#: bayesml.sparselinearregression:6 of
msgid "Stochastic Data Generative Model"
msgstr ""

#: bayesml.sparselinearregression:8 of
msgid "The stochastic data generative model is as follows:"
msgstr ""

#: bayesml.sparselinearregression:10 of
#, python-brace-format
msgid ":math:`d \\in \\mathbb{N}`: a dimension of explanatory variables"
msgstr ""

#: bayesml.sparselinearregression:11 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{x} \\in \\mathbb{R}^d`: an explanatory variable. If "
"you consider an intercept term, it should be included as one of the "
"elements of :math:`\\boldsymbol{x}`."
msgstr ""

#: bayesml.sparselinearregression:12 of
#, python-brace-format
msgid ":math:`y \\in \\mathbb{R}`: an objective variable"
msgstr ""

#: bayesml.sparselinearregression:13 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{\\theta} \\in \\mathbb{R}^d`: a regression "
"coefficient vector"
msgstr ""

#: bayesml.sparselinearregression:14 of
#, python-brace-format
msgid ":math:`\\tau \\in \\mathbb{R}_{>0}`: a precision parameter"
msgstr ""

#: bayesml.sparselinearregression:15 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{v} = (v_1, \\ldots, v_d)^\\top \\in "
"\\mathbb{R}_{>0}^d`: latent scale variables"
msgstr ""

#: bayesml.sparselinearregression:17 of
msgid ""
"p(y | \\boldsymbol{x}, \\boldsymbol{\\theta}, \\tau)\n"
"&= \\mathcal{N}(y | \\boldsymbol{x}^{\\top}\\boldsymbol{\\theta}, "
"\\tau^{-1}) \\\\\n"
"&= \\sqrt{\\frac{\\tau}{2\\pi}}\n"
"\\exp\\left\\{\n"
"    -\\frac{\\tau}{2}(y-\\boldsymbol{x}^{\\top}\\boldsymbol{\\theta})^2\n"
"\\right\\}.\n"
"\n"
msgstr ""

#: bayesml.sparselinearregression:25 of
#, python-brace-format
msgid ""
"\\mathbb{E}[y | \\boldsymbol{x}, \\boldsymbol{\\theta}, \\tau] &= "
"\\boldsymbol{x}^{\\top}\\boldsymbol{\\theta}, \\\\\n"
"\\mathbb{V}[y | \\boldsymbol{x}, \\boldsymbol{\\theta}, \\tau] &= "
"\\tau^{-1}.\n"
"\n"
msgstr ""

#: bayesml.sparselinearregression:30 of
msgid "Prior Distribution"
msgstr ""

#: bayesml.sparselinearregression:32 of
msgid "The prior distribution is as follows:"
msgstr ""

#: bayesml.sparselinearregression:34 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{\\lambda}_0 = (\\lambda_{0,1}, \\ldots, "
"\\lambda_{0,d})^\\top \\in \\mathbb{R}_{>0}^d`: a hyperparameter vector "
"(Laplace regularization strength for each dimension)"
msgstr ""

#: bayesml.sparselinearregression:35 of
#, python-brace-format
msgid ":math:`\\alpha_0 \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ""

#: bayesml.sparselinearregression:36 of
#, python-brace-format
msgid ":math:`\\beta_0 \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ""

#: bayesml.sparselinearregression:37 of
msgid ":math:`\\Gamma(\\cdot)`: the gamma function"
msgstr ""

#: bayesml.sparselinearregression:39 of
msgid ""
"p(\\boldsymbol{\\theta} | \\tau, \\boldsymbol{v})\n"
"&= \\mathcal{N}(\\boldsymbol{\\theta} | \\boldsymbol{0}, \\tau^{-1} "
"\\mathrm{diag}(\\boldsymbol{v})) \\\\\n"
"&= \\left(\\frac{\\tau}{2\\pi}\\right)^{d/2}\n"
"\\left(\\prod_{j=1}^d v_j\\right)^{-1/2}\n"
"\\exp\\left\\{\n"
"    -\\frac{\\tau}{2}\\boldsymbol{\\theta}^\\top\n"
"    \\mathrm{diag}(\\boldsymbol{v})^{-1}\n"
"    \\boldsymbol{\\theta}\n"
"\\right\\}, \\\\\n"
"p(\\boldsymbol{v} | \\boldsymbol{\\lambda}_0)\n"
"&= \\prod_{j=1}^d \\mathrm{Exp}\\left(v_j \\middle| "
"\\frac{\\lambda_{0,j}^2}{2}\\right)\n"
"= \\prod_{j=1}^d "
"\\frac{\\lambda_{0,j}^2}{2}\\exp\\left(-\\frac{\\lambda_{0,j}^2}{2}v_j\\right),"
" \\\\\n"
"p(\\tau | \\alpha_0, \\beta_0)\n"
"&= \\mathrm{Gam}(\\tau | \\alpha_0, \\beta_0)\n"
"= "
"\\frac{\\beta_0^{\\alpha_0}}{\\Gamma(\\alpha_0)}\\tau^{\\alpha_0-1}\\exp(-\\beta_0\\tau)."
"\n"
"\n"
msgstr ""

#: bayesml.sparselinearregression:56 of
msgid ""
"Marginalizing out each :math:`v_j` yields the Laplace prior on "
":math:`\\theta_j`:"
msgstr ""

#: bayesml.sparselinearregression:58 of
msgid ""
"p(\\theta_j | \\tau, \\lambda_{0,j})\n"
"&= \\int_0^\\infty p(\\theta_j | \\tau, v_j) p(v_j | \\lambda_{0,j})\\, "
"dv_j \\\\\n"
"&= \\frac{\\lambda_{0,j} \\sqrt{\\tau}}{2}\n"
"\\exp\\left(-\\lambda_{0,j} \\sqrt{\\tau}\\, |\\theta_j|\\right).\n"
"\n"
msgstr ""

#: bayesml.sparselinearregression:65 of
msgid "Posterior Distribution"
msgstr ""

#: bayesml.sparselinearregression:67 of
msgid ""
"The approximate posterior distribution in the :math:`t`-th iteration of a"
" variational Bayesian method is as follows:"
msgstr ""

#: bayesml.sparselinearregression:69 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{X} = (\\boldsymbol{x}_1, \\ldots, "
"\\boldsymbol{x}_n)^\\top \\in \\mathbb{R}^{n \\times d}`: given "
"explanatory variables"
msgstr ""

#: bayesml.sparselinearregression:70 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{y} = (y_1, \\ldots, y_n)^\\top \\in \\mathbb{R}^n`: "
"given objective variables"
msgstr ""

#: bayesml.sparselinearregression:71 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\mu}_n^{(t)} \\in \\mathbb{R}^d`: a hyperparameter"
msgstr ""

#: bayesml.sparselinearregression:72 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{\\Lambda}_n^{(t)} \\in \\mathbb{R}^{d \\times d}`: a "
"hyperparameter (a positive definite matrix)"
msgstr ""

#: bayesml.sparselinearregression:73 of
#, python-brace-format
msgid ":math:`\\alpha_n^{(t)} \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ""

#: bayesml.sparselinearregression:74 of
#, python-brace-format
msgid ":math:`\\beta_n^{(t)} \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ""

#: bayesml.sparselinearregression:75 of
#, python-brace-format
msgid ""
":math:`a_{n,j}^{(t)} \\in \\mathbb{R}_{>0}`: a hyperparameter for "
":math:`q(v_j)`"
msgstr ""

#: bayesml.sparselinearregression:76 of
#, python-brace-format
msgid ""
":math:`b_{n,j}^{(t)} \\in \\mathbb{R}_{>0}`: a hyperparameter for "
":math:`q(v_j)`"
msgstr ""

#: bayesml.sparselinearregression:77 of
#, python-brace-format
msgid ":math:`K_{\\nu}(\\cdot)`: the modified Bessel function of the second kind"
msgstr ""

#: bayesml.sparselinearregression:79 of
msgid ""
"&q(\\boldsymbol{\\theta}, \\tau, \\boldsymbol{v}) \\nonumber \\\\\n"
"&= \\mathcal{N}\\left(\n"
"    \\boldsymbol{\\theta} \\middle|\n"
"    \\boldsymbol{\\mu}_n^{(t)},\n"
"    (\\tau \\boldsymbol{\\Lambda}_n^{(t)})^{-1}\n"
"\\right)\n"
"\\mathrm{Gam}(\\tau | \\alpha_n^{(t)}, \\beta_n^{(t)})  \\prod_{j=1}^d "
"\\mathrm{GIG}\\left(\n"
"    v_j \\middle| 1/2,\\, a_{n,j}^{(t)},\\, b_{n,j}^{(t)}\n"
"\\right) \\\\\n"
"&= \\frac{|\\tau \\boldsymbol{\\Lambda}_n^{(t)}|^{1/2}}{(2\\pi)^{d/2}} "
"\\exp \\left\\{ -\\frac{\\tau}{2}(\\boldsymbol{\\theta} "
"-\\boldsymbol{\\mu}_n^{(t)})^\\top \\boldsymbol{\\Lambda}_n^{(t)} "
"(\\boldsymbol{\\theta} - \\boldsymbol{\\mu}_n^{(t)}) \\right\\} \\\\\n"
"&\\qquad \\times "
"\\frac{(\\beta_n^{(t)})^{\\alpha_n^{(t)}}}{\\Gamma(\\alpha_n^{(t)})}\\tau^{\\alpha_n^{(t)}-1}\\exp\\{-\\beta_n^{(t)}\\tau\\}"
" \\nonumber \\\\\n"
"&\\qquad \\times \\prod_{j=1}^d "
"\\frac{(a_{n,j}^{(t)}/b_{n,j}^{(t)})^{1/4}}{2K_{1/2}\\left(\\sqrt{a_{n,j}^{(t)}"
" b_{n,j}^{(t)}}\\right)} v_j^{-1/2} "
"\\exp\\left\\{-\\frac{1}{2}(a_{n,j}^{(t)} v_j + b_{n,j}^{(t)} "
"v_j^{-1})\\right\\}\n"
"\n"
msgstr ""

#: bayesml.sparselinearregression:93 of
msgid ""
"where :math:`\\mathrm{GIG}(x | p, a, b) = "
"\\frac{(a/b)^{p/2}}{2K_p(\\sqrt{ab})} x^{p-1} "
"\\exp\\left\\{-\\frac{1}{2}(ax + bx^{-1})\\right\\}`."
msgstr ""

#: bayesml.sparselinearregression:95 of
msgid "The updating rule of the hyperparameters is as follows."
msgstr ""

#: bayesml.sparselinearregression:97 of
msgid ""
"\\boldsymbol{\\Lambda}_n^{(t+1)}\n"
"&= \\boldsymbol{X}^\\top \\boldsymbol{X}\n"
"+ \\mathrm{diag}\\left(\n"
"    \\sqrt{\\frac{a_{n,1}^{(t)}}{b_{n,1}^{(t)}}},\n"
"    \\ldots,\n"
"    \\sqrt{\\frac{a_{n,d}^{(t)}}{b_{n,d}^{(t)}}}\n"
"\\right), \\\\\n"
"\\boldsymbol{\\mu}_n^{(t+1)}\n"
"&= (\\boldsymbol{\\Lambda}_n^{(t+1)})^{-1} \\boldsymbol{X}^\\top "
"\\boldsymbol{y}, \\\\\n"
"\\alpha_n^{(t+1)}\n"
"&= \\alpha_0 + \\frac{n}{2}, \\\\\n"
"\\beta_n^{(t+1)}\n"
"&= \\beta_0 + \\frac{1}{2}\n"
"\\left(\n"
"    \\boldsymbol{y}^\\top \\boldsymbol{y}\n"
"    - (\\boldsymbol{\\mu}_n^{(t+1)})^\\top "
"\\boldsymbol{\\Lambda}_n^{(t+1)} \\boldsymbol{\\mu}_n^{(t+1)}\n"
"\\right), \\\\\n"
"a_{n,j}^{(t+1)}\n"
"&= \\lambda_{0,j}^2, \\\\\n"
"b_{n,j}^{(t+1)}\n"
"&= \\frac{\\alpha_n^{(t+1)}}{\\beta_n^{(t+1)}} (\\mu_{n,j}^{(t+1)})^2\n"
"+ \\left((\\boldsymbol{\\Lambda}_n^{(t+1)})^{-1}\\right)_{jj}.\n"
"\n"
msgstr ""

#: bayesml.sparselinearregression:121 of
msgid "Accordingly,"
msgstr ""

#: bayesml.sparselinearregression:123 of
#, python-brace-format
msgid ""
"\\mathbb{E}[\\boldsymbol{\\theta} | \\boldsymbol{X}, \\boldsymbol{y}]\n"
"&\\approx \\boldsymbol{\\mu}_n, \\\\\n"
"\\mathbb{E}[\\tau | \\boldsymbol{X}, \\boldsymbol{y}]\n"
"&\\approx \\frac{\\alpha_n}{\\beta_n}.\n"
"\n"
msgstr ""

#: bayesml.sparselinearregression:130 of
msgid "Predictive Distribution"
msgstr ""

#: bayesml.sparselinearregression:132 of
msgid "The approximate predictive distribution is as follows:"
msgstr ""

#: bayesml.sparselinearregression:134 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{x}_{n+1} \\in \\mathbb{R}^d`: a new explanatory "
"variable"
msgstr ""

#: bayesml.sparselinearregression:135 of
#, python-brace-format
msgid ":math:`y_{n+1} \\in \\mathbb{R}`: a new objective variable"
msgstr ""

#: bayesml.sparselinearregression:136 of
msgid ""
":math:`m_{\\mathrm{p}} \\in \\mathbb{R}`: a parameter of the predictive "
"distribution"
msgstr ""

#: bayesml.sparselinearregression:137 of
msgid ""
":math:`\\lambda_{\\mathrm{p}} \\in \\mathbb{R}_{>0}`: a parameter of the "
"predictive distribution"
msgstr ""

#: bayesml.sparselinearregression:138 of
msgid ""
":math:`\\nu_{\\mathrm{p}} \\in \\mathbb{R}_{>0}`: a parameter of the "
"predictive distribution"
msgstr ""

#: bayesml.sparselinearregression:140 of
msgid ""
"&p(y_{n+1} | \\boldsymbol{X}, \\boldsymbol{y}, \\boldsymbol{x}_{n+1}) "
"\\nonumber \\\\\n"
"&\\approx \\mathrm{St}\\left(y_{n+1} | m_{\\mathrm{p}}, "
"\\lambda_{\\mathrm{p}}, \\nu_{\\mathrm{p}}\\right) \\nonumber \\\\\n"
"&= \\frac{\\Gamma (\\nu_\\mathrm{p} / 2 + 1/2 )}{\\Gamma "
"(\\nu_\\mathrm{p} / 2)} \\left( \\frac{\\lambda_\\mathrm{p}}{\\pi "
"\\nu_\\mathrm{p}} \\right)^{1/2} \\left( 1 + \\frac{\\lambda_\\mathrm{p} "
"(y_{n+1} - m_\\mathrm{p})^2}{\\nu_\\mathrm{p}} "
"\\right)^{-\\nu_\\mathrm{p}/2 - 1/2},\n"
"\n"
msgstr ""

#: bayesml.sparselinearregression:145 of
msgid ""
"\\mathbb{E}[y_{n+1} | \\boldsymbol{X}, \\boldsymbol{y}, "
"\\boldsymbol{x}_{n+1}] &\\approx m_{\\mathrm{p}} \\quad "
"(\\nu_{\\mathrm{p}} > 1), \\\\\n"
"\\mathbb{V}[y_{n+1} | \\boldsymbol{X}, \\boldsymbol{y}, "
"\\boldsymbol{x}_{n+1}] &\\approx \\frac{1}{\\lambda_{\\mathrm{p}}} "
"\\frac{\\nu_{\\mathrm{p}}}{\\nu_{\\mathrm{p}} - 2} \\quad "
"(\\nu_{\\mathrm{p}} > 2),\n"
"\n"
msgstr ""

#: bayesml.sparselinearregression:149 of
msgid ""
"where the parameters are obtained from the hyperparameters of the "
"posterior distribution as follows:"
msgstr ""

#: bayesml.sparselinearregression:151 of
msgid ""
"m_{\\mathrm{p}} &= \\boldsymbol{x}_{n+1}^{\\top} \\boldsymbol{\\mu}_n, "
"\\\\\n"
"\\lambda_{\\mathrm{p}} &= \\frac{\\alpha_n}{\\beta_n}\\left(1 + "
"\\boldsymbol{x}_{n+1}^{\\top} \\boldsymbol{\\Lambda}_n^{-1} "
"\\boldsymbol{x}_{n+1}\\right)^{-1}, \\\\\n"
"\\nu_{\\mathrm{p}} &= 2\\alpha_n.\n"
"\n"
msgstr ""

