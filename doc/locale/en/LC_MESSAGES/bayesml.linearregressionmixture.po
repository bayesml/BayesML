#: bayesml.linearregressionmixture:1 of
msgid ""
"This module provides the mixture of linear regression model with the "
"normal-gamma prior distribution and the Dirichlet prior distribution."
msgstr ""

#: bayesml.linearregressionmixture:6 of
msgid "Stochastic Data Generative Model"
msgstr ""

#: bayesml.linearregressionmixture:8 of
msgid "The stochastic data generative model is as follows:"
msgstr ""

#: bayesml.linearregressionmixture:10 of
#, python-brace-format
msgid ":math:`K \\in \\mathbb{N}`: number of latent classes"
msgstr ""

#: bayesml.linearregressionmixture:11 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{z} \\in \\{ 0, 1 \\}^K`: a one-hot vector "
"representing the latent class (latent variable)"
msgstr ""

#: bayesml.linearregressionmixture:12 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{\\pi} \\in [0, 1]^K`: a parameter for latent classes,"
" (:math:`\\sum_{k=1}^K \\pi_k=1`)"
msgstr ""

#: bayesml.linearregressionmixture:13 of
#, python-brace-format
msgid ":math:`D \\in \\mathbb{N}`: a dimension of data"
msgstr ""

#: bayesml.linearregressionmixture:14 of
#, python-brace-format
msgid ":math:`y\\in\\mathbb{R}`: an objective variable"
msgstr ""

#: bayesml.linearregressionmixture:15 of
#, python-brace-format
msgid ":math:`\\boldsymbol{x} \\in \\mathbb{R}^D`: a data point"
msgstr ""

#: bayesml.linearregressionmixture:16 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\theta}_k\\in\\mathbb{R}^{D}`: a parameter"
msgstr ""

#: bayesml.linearregressionmixture:17 of
msgid ":math:`\\boldsymbol{\\theta} = \\{ \\boldsymbol{\\theta}_k \\}_{k=1}^K`"
msgstr ""

#: bayesml.linearregressionmixture:18 of
#, python-brace-format
msgid ":math:`\\tau_k \\in \\mathbb{R}_{>0}` : a parameter"
msgstr ""

#: bayesml.linearregressionmixture:19 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\tau} = \\{ \\tau_k \\}_{k=1}^K`"
msgstr ""

#: bayesml.linearregressionmixture:21 of
msgid ""
"p(\\boldsymbol{z} | \\boldsymbol{\\pi}) &= "
"\\mathrm{Cat}(\\boldsymbol{z}|\\boldsymbol{\\pi}) = \\prod_{k=1}^K "
"\\pi_k^{z_k},\\\\\n"
"p(y | \\boldsymbol{x}, \\boldsymbol{\\theta}, \\boldsymbol{\\tau}, "
"\\boldsymbol{z}) &= \\prod_{k=1}^K \\mathcal{N}(y | "
"\\boldsymbol{\\theta}^\\top_k \\boldsymbol{x},\\tau_k^{-1})^{z_k} \\\\\n"
"&= \\prod_{k=1}^K \\left( \\sqrt{\\frac{\\tau_k}{2\\pi}} \\exp \\left\\{ "
"-\\frac{\\tau_k}{2}(y - \\boldsymbol{\\theta}^\\top_k\\boldsymbol{x})^2 "
"\\right\\} \\right)^{z_k}.\n"
"\n"
msgstr ""

#: bayesml.linearregressionmixture:27 of
msgid "Prior Distribution"
msgstr ""

#: bayesml.linearregressionmixture:29 of
msgid "The prior distribution is as follows:"
msgstr ""

#: bayesml.linearregressionmixture:31 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\mu}_0 \\in \\mathbb{R}^{D}`: a hyperparameter"
msgstr ""

#: bayesml.linearregressionmixture:32 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{\\Lambda}_0 \\in \\mathbb{R}^{D\\times D}`: a "
"hyperparameter (a positive definite matrix)"
msgstr ""

#: bayesml.linearregressionmixture:33 of
#, python-brace-format
msgid ":math:`\\alpha_0 \\in \\mathbb{R}_{> 0}`: a hyperparameter"
msgstr ""

#: bayesml.linearregressionmixture:34 of
#, python-brace-format
msgid ":math:`\\beta_0\\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ""

#: bayesml.linearregressionmixture:35 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\gamma}_0 \\in \\mathbb{R}_{>0}^K`: a hyper parameter"
msgstr ""

#: bayesml.linearregressionmixture:36 of
msgid ":math:`\\Gamma (\\cdot)`: the gamma function"
msgstr ""

#: bayesml.linearregressionmixture:38 of
msgid ""
"p(\\boldsymbol{\\theta},\\boldsymbol{\\tau},\\boldsymbol{\\pi}) &= "
"\\left\\{ \\prod_{k=1}^K "
"\\mathcal{N}(\\boldsymbol{\\theta}_k|\\boldsymbol{\\mu}_0,(\\tau_k "
"\\boldsymbol{\\Lambda}_0)^{-1})\\mathrm{Gam}(\\tau_k|\\alpha_0, \\beta_0)"
" \\right\\} \\mathrm{Dir}(\\boldsymbol{\\pi}|\\boldsymbol{\\gamma}_0) "
"\\\\\n"
"&= \\Biggl[ \\prod_{k=1}^K  \\frac{|\\tau_k "
"\\boldsymbol{\\Lambda}_0|^{1/2}}{(2\\pi)^{d/2}} \\exp \\left\\{ "
"-\\frac{\\tau_k}{2}(\\boldsymbol{\\theta}_k -\\boldsymbol{\\mu}_0)^\\top "
"\\boldsymbol{\\Lambda}_0 (\\boldsymbol{\\theta}_k - \\boldsymbol{\\mu}_0)"
" \\right\\} \\\\\n"
"&\\qquad \\times "
"\\frac{\\beta_0^{\\alpha_0}}{\\Gamma(\\alpha_0)}\\tau_k^{\\alpha_0-1}\\exp\\{-\\beta_0\\tau_k\\}"
" \\Biggl] C(\\boldsymbol{\\gamma}_0)\\prod_{k=1}^K "
"\\pi_k^{\\gamma_{0,k}-1},\\\\\n"
"\n"
msgstr ""

#: bayesml.linearregressionmixture:43 of
#, python-brace-format
msgid "where :math:`C(\\boldsymbol{\\gamma}_0)` are defined as follows:"
msgstr ""

#: bayesml.linearregressionmixture:45 of
msgid ""
"C(\\boldsymbol{\\gamma}_0) = \\frac{\\Gamma(\\sum_{k=1}^K "
"\\gamma_{0,k})}{\\Gamma(\\gamma_{0,1})\\cdots\\Gamma(\\gamma_{0,K})}.\n"
"\n"
msgstr ""

#: bayesml.linearregressionmixture:49 of
msgid "Posterior Distribution"
msgstr ""

#: bayesml.linearregressionmixture:51 of
msgid ""
"The apporoximate posterior distribution in the :math:`t`-th iteration of "
"a variational Bayesian method is as follows:"
msgstr ""

#: bayesml.linearregressionmixture:53 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{X} = [\\boldsymbol{x}_1, \\boldsymbol{x}_2, \\dots , "
"\\boldsymbol{x}_n]^\\top \\in \\mathbb{R}^{n \\times D}`: given "
"explanatory variables"
msgstr ""

#: bayesml.linearregressionmixture:54 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{z}^n = (\\boldsymbol{z}_1, \\boldsymbol{z}_2, \\dots "
", \\boldsymbol{z}_n) \\in \\{ 0, 1 \\}^{K \\times n}`: latent classes of "
"given data"
msgstr ""

#: bayesml.linearregressionmixture:55 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{r}_i^{(t)} = (r_{i,1}^{(t)}, r_{i,2}^{(t)}, \\dots , "
"r_{i,K}^{(t)}) \\in [0,1]^K`: a parameter for :math:`i`-th latent class "
"(:math:`\\sum_{k=1}^K r_{i,k}^{(t)} = 1`)"
msgstr ""

#: bayesml.linearregressionmixture:56 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{y} = [y_1, y_2, \\dots , y_n]^\\top \\in "
"\\mathbb{R}^n`: given objective variables"
msgstr ""

#: bayesml.linearregressionmixture:57 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{\\mu}_{n,k}^{(t)} \\in \\mathbb{R}^{D}`: a "
"hyperparameter"
msgstr ""

#: bayesml.linearregressionmixture:58 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{\\Lambda}_{n,k}^{(t)} \\in \\mathbb{R}^{D\\times D}`:"
" a hyperparameter (a positive definite matrix)"
msgstr ""

#: bayesml.linearregressionmixture:59 of
#, python-brace-format
msgid ":math:`\\alpha_{n,k}^{(t)} \\in \\mathbb{R}_{> 0}`: a hyperparameter"
msgstr ""

#: bayesml.linearregressionmixture:60 of
#, python-brace-format
msgid ":math:`\\beta_{n,k}^{(t)} \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ""

#: bayesml.linearregressionmixture:61 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{\\gamma}_n^{(t)} \\in \\mathbb{R}_{>0}^K`: a hyper "
"parameter"
msgstr ""

#: bayesml.linearregressionmixture:62 of
msgid ":math:`\\psi (\\cdot)`: the digamma function"
msgstr ""

#: bayesml.linearregressionmixture:64 of
msgid ""
"&q(\\boldsymbol{z}^n, "
"\\boldsymbol{\\theta},\\boldsymbol{\\tau},\\boldsymbol{\\pi}) \\nonumber "
"\\\\\n"
"&= \\left\\{ \\prod_{i=1}^n "
"\\mathrm{Cat}(\\boldsymbol{z}_i|\\boldsymbol{r}_i^{(t)}) \\right\\} "
"\\left\\{ \\prod_{k=1}^K "
"\\mathcal{N}(\\boldsymbol{\\theta}_k|\\boldsymbol{\\mu}_{n,k}^{(t)},(\\tau_k"
" "
"\\boldsymbol{\\Lambda}_{n,k}^{(t)})^{-1})\\mathrm{Gam}(\\tau_k|\\alpha_{n,k}^{(t)},"
" \\beta_{n,k}^{(t)}) \\right\\} \\\\\n"
"&\\qquad \\times "
"\\mathrm{Dir}(\\boldsymbol{\\pi}|\\boldsymbol{\\gamma}_{n,k}^{(t)}) \\\\"
"\n"
"&= \\Biggl[ \\prod_{i=1}^n \\prod_{k=1}^K (r_{i,k}^{(t)})^{z_{i,k}} "
"\\Biggr] \\Biggl[ \\prod_{k=1}^K  \\frac{|\\tau_k "
"\\boldsymbol{\\Lambda}_{n,k}^{(t)}|^{1/2}}{(2\\pi)^{d/2}} \\exp \\left\\{"
" -\\frac{\\tau_k}{2}(\\boldsymbol{\\theta}_k "
"-\\boldsymbol{\\mu}_{n,k}^{(t)})^\\top \\boldsymbol{\\Lambda}_{n,k}^{(t)}"
" (\\boldsymbol{\\theta}_k - \\boldsymbol{\\mu}_{n,k}^{(t)}) \\right\\} "
"\\\\\n"
"&\\qquad \\times "
"\\frac{(\\beta_{n,k}^{(t)})^{\\alpha_{n,k}^{(t)}}}{\\Gamma(\\alpha_{n,k}^{(t)})}\\tau_k^{\\alpha_{n,k}^{(t)}-1}\\exp\\{-\\beta_{n,k}^{(t)}\\tau_k\\}"
" \\Biggl] C(\\boldsymbol{\\gamma}_n)\\prod_{k=1}^K "
"\\pi_k^{\\gamma_{n,k}-1},\\\\\n"
"\n"
msgstr ""

#: bayesml.linearregressionmixture:71 of
msgid "where the updating rules of the hyperparameters are as follows:"
msgstr ""

#: bayesml.linearregressionmixture:73 of
msgid ""
"N_{k}^{(t)} &= \\sum_{i=1}^{n} r_{i,k}^{(t)}, \\\\\n"
"\\boldsymbol{R}_k^{(t)} &= \\mathrm{diag} (r_{1,k}^{(t)}, r_{2,k}^{(t)}, "
"\\dots , r_{n,k}^{(t)}), \\\\\n"
"\\boldsymbol{\\Lambda}_{n,k}^{(t+1)} &= \\boldsymbol{\\Lambda}_0 + "
"\\boldsymbol{X}^\\top \\boldsymbol{R}_k^{(t)} \\boldsymbol{X}, \\\\\n"
"\\boldsymbol{\\mu}_{n,k}^{(t+1)} &= \\left( "
"\\boldsymbol{\\Lambda}_{n,k}^{(t+1)} \\right)^{-1} \\left( "
"\\boldsymbol{\\Lambda}_0 \\boldsymbol{\\mu}_0 + \\boldsymbol{X}^\\top "
"\\boldsymbol{R}_k^{(t)} \\boldsymbol{y} \\right), \\\\\n"
"\\alpha_{n,k}^{(t+1)} &= \\alpha_0 + \\frac{1}{2} N_k^{(t)}, \\\\\n"
"\\beta_{n,k}^{(t+1)} &= \\beta_0 + \\frac{1}{2} \\left( "
"-(\\boldsymbol{\\mu}_{n,k}^{(t+1)})^\\top "
"\\boldsymbol{\\Lambda}_{n,k}^{(t+1)} \\boldsymbol{\\mu}_{n,k}^{(t+1)} + "
"\\boldsymbol{y}^\\top \\boldsymbol{R}_k^{(t)} \\boldsymbol{y} + "
"\\boldsymbol{\\mu}_0^\\top \\boldsymbol{\\Lambda}_0 \\boldsymbol{\\mu}_0 "
"\\right), \\\\\n"
"\\gamma_{n,k}^{(t+1)} &= \\gamma_0 + N_{k}^{(t)}, \\\\\n"
"\\ln \\rho_{i,k}^{(t+1)} &= \\psi (\\gamma_{n,k}^{(t+1)}) - \\psi \\left("
" {\\textstyle \\sum_{k=1}^K \\gamma_{n,k}^{(t+1)}} \\right) \\nonumber "
"\\\\\n"
"&\\qquad - \\frac{1}{2} \\ln (2 \\pi) - \\frac{1}{2} \\left( \\psi "
"(\\alpha_{n,k}^{(t+1)}) - \\ln \\beta_{n,k}^{(t+1)} \\right) \\nonumber "
"\\\\\n"
"&\\qquad -\\frac{1}{2} \\left( "
"\\frac{\\alpha_{n,k}^{(t+1)}}{\\beta_{n,k}^{(t+1)}} \\left(y_i - "
"(\\boldsymbol{\\mu}_{n,k}^{(t+1)})^\\top \\boldsymbol{x}_i \\right)^2 + "
"\\boldsymbol{x}_i^\\top \\boldsymbol{\\Lambda}_{n,k}^{(t+1)} "
"\\boldsymbol{x}_i \\right), \\\\\n"
"r_{i,k}^{(t+1)} &= \\frac{\\rho_{i,k}^{(t+1)}}{\\sum_{k=1}^K "
"\\rho_{i,k}^{(t+1)}}.\n"
"\n"
msgstr ""

#: bayesml.linearregressionmixture:87 of
msgid "Predictive Distribution"
msgstr ""

#: bayesml.linearregressionmixture:89 of
msgid "The predictive distribution is as follows:"
msgstr ""

#: bayesml.linearregressionmixture:91 of
#, python-brace-format
msgid ":math:`\\boldsymbol{x}_{n+1}\\in \\mathbb{R}^D`: a new data point"
msgstr ""

#: bayesml.linearregressionmixture:92 of
#, python-brace-format
msgid ":math:`y_{n+1}\\in \\mathbb{R}`: a new objective variable"
msgstr ""

#: bayesml.linearregressionmixture:93 of
msgid ":math:`m_{\\mathrm{p},k}\\in \\mathbb{R}`: a parameter"
msgstr ""

#: bayesml.linearregressionmixture:94 of
msgid ":math:`\\lambda_{\\mathrm{p},k}\\in \\mathbb{R}_{>0}`: a parameter"
msgstr ""

#: bayesml.linearregressionmixture:95 of
msgid ":math:`\\nu_{\\mathrm{p},k}\\in \\mathbb{R}_{>0}`: a parameter"
msgstr ""

#: bayesml.linearregressionmixture:97 of
msgid ""
"&p(y_{n+1} | \\boldsymbol{X}, \\boldsymbol{y}, \\boldsymbol{x}_{n+1} ) "
"\\nonumber \\\\\n"
"&= \\frac{1}{\\sum_{k+1}^K \\gamma_{n,k}^{(t)}} \\sum_{k=1}^K "
"\\gamma_{n,k}^{(t)} \\mathrm{St}\\left(y_{n+1} \\mid m_{\\mathrm{p},k}, "
"\\lambda_{\\mathrm{p},k}, \\nu_{\\mathrm{p},k}\\right) \\\\\n"
"&= \\frac{1}{\\sum_{k+1}^K \\gamma_{n,k}^{(t)}} \\sum_{k=1}^K "
"\\gamma_{n,k}^{(t)} \\frac{\\Gamma (\\nu_{\\mathrm{p},k} / 2 + 1/2 "
")}{\\Gamma (\\nu_{\\mathrm{p},k} / 2)} \\left( "
"\\frac{\\lambda_{\\mathrm{p},k}}{\\pi \\nu_{\\mathrm{p},k}} "
"\\right)^{1/2} \\left( 1 + \\frac{\\lambda_{\\mathrm{p},k} (y_{n+1} - "
"m_{\\mathrm{p},k})^2}{\\nu_{\\mathrm{p},k}} "
"\\right)^{-\\nu_{\\mathrm{p},k}/2 - 1/2},\n"
"\n"
msgstr ""

#: bayesml.linearregressionmixture:102 of
msgid ""
"where the parameters are obtained from the hyperparameters of the "
"posterior distribution as follows."
msgstr ""

#: bayesml.linearregressionmixture:104 of
msgid ""
"m_{\\mathrm{p},k} &= \\boldsymbol{x}_{n+1}^{\\top} "
"\\boldsymbol{\\mu}_{n,k}^{(t)}, \\\\\n"
"\\lambda_{\\mathrm{p},k} &= "
"\\frac{\\alpha_{n,k}^{(t)}}{\\beta_{n,k}^{(t)}}\\left(1+\\boldsymbol{x}_{n+1}^{\\top}"
" \\boldsymbol{\\Lambda}_{n,k}^{(t)} \\boldsymbol{x}_{n+1}\\right)^{-1}, "
"\\\\\n"
"\\nu_{\\mathrm{p},k} &= 2 \\alpha_{n,k}^{(t)}.\n"
"\n"
msgstr ""

