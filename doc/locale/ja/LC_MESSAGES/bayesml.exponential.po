msgid "bayesml.exponential package"
msgstr "bayesml.exponential package"

#: ../../bayesml.exponential.rst:7
msgid "Module contents"
msgstr "モジュール内容"

#: bayesml.exponential:1 of
msgid "The exponential distribution with the gamma prior distribution."
msgstr "ガンマ事前分布を仮定した指数分布"

#: bayesml.exponential:3 of
msgid "The stochastic data generative model is as follows:"
msgstr "確率的データ生成モデルは以下の通りです："

#: bayesml.exponential:5 of
#, python-brace-format
msgid ":math:`x \\in \\mathbb{R}_{\\geq 0}`: a data point"
msgstr ":math:`x \\in \\mathbb{R}_{\\geq 0}`: データ点"

#: bayesml.exponential:6 of
#, python-brace-format
msgid ":math:`\\lambda \\in \\mathbb{R}_{>0}`: a parameter"
msgstr ":math:`\\lambda \\in \\mathbb{R}_{>0}`: パラメータ"

#: bayesml.exponential:8 of
#, python-brace-format
msgid ""
"p(x | \\lambda) = \\mathrm{Exp}(x|\\lambda) = \\lambda\\exp(-\\lambda x).\n"
"\n"
msgstr ""
"p(x | \\lambda) = \\mathrm{Exp}(x|\\lambda) = \\lambda\\exp(-\\lambda x).\n"
"\n"

#: bayesml.exponential:11 of
#, python-brace-format
msgid ""
"\\mathbb{E}[x] &= \\frac{1}{\\lambda}, \\\\\n"
"\\mathbb{V}[x] &= \\frac{1}{\\lambda^2}.\n"
"\n"
msgstr ""
"\\mathbb{E}[x] &= \\frac{1}{\\lambda}, \\\\\n"
"\\mathbb{V}[x] &= \\frac{1}{\\lambda^2}.\n"
"\n"

#: bayesml.exponential:16 of
msgid "The prior distribution is as follows:"
msgstr "事前分布は以下の通りです："

#: bayesml.exponential:18 of
#, python-brace-format
msgid ":math:`\\alpha_0 \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\alpha_0 \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.exponential:19 of
#, python-brace-format
msgid ":math:`\\beta_0 \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\beta_0 \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.exponential:20 of
#, python-brace-format
msgid ""
":math:`\\Gamma(\\cdot): \\mathbb{R}_{>0} \\to \\mathbb{R}_{>0}`: the Gamma "
"function"
msgstr ""
":math:`\\Gamma(\\cdot): \\mathbb{R}_{>0} \\to \\mathbb{R}_{>0}`: ガンマ関数"

#: bayesml.exponential:22 of
msgid ""
"p(\\lambda) = \\mathrm{Gam}(\\lambda|\\alpha_0,\\beta_0) = "
"\\frac{\\beta_0^{\\alpha_0}}{\\Gamma (\\alpha_0)} \\lambda^{\\alpha_0 - 1} "
"\\exp \\{ -\\beta_0 \\lambda \\},\n"
"\n"
msgstr ""
"p(\\lambda) = \\mathrm{Gam}(\\lambda|\\alpha_0,\\beta_0) = "
"\\frac{\\beta_0^{\\alpha_0}}{\\Gamma (\\alpha_0)} \\lambda^{\\alpha_0 - 1} "
"\\exp \\{ -\\beta_0 \\lambda \\},\n"
"\n"

#: bayesml.exponential:25 of
#, python-brace-format
msgid ""
"\\mathbb{E}[\\lambda] &= \\frac{\\alpha_0}{\\beta_0}, \\\\\n"
"\\mathbb{V}[\\lambda] &= \\frac{\\alpha_0}{\\beta_0^2}.\n"
"\n"
msgstr ""
"\\mathbb{E}[\\lambda] &= \\frac{\\alpha_0}{\\beta_0}, \\\\\n"
"\\mathbb{V}[\\lambda] &= \\frac{\\alpha_0}{\\beta_0^2}.\n"
"\n"

#: bayesml.exponential:30 of
msgid "The posterior distribution is as follows:"
msgstr "事後分布は以下の通りです："

#: bayesml.exponential:32 of
#, python-brace-format
msgid ""
":math:`x^n = (x_1, x_2, \\dots , x_n) \\in \\mathbb{R}_{\\geq 0}^n`: given "
"data"
msgstr ""
":math:`x^n = (x_1, x_2, \\dots , x_n) \\in \\mathbb{R}_{\\geq 0}^n`: 与えられ"
"たデータ"

#: bayesml.exponential:33 of
#, python-brace-format
msgid ":math:`\\alpha_n \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\alpha_n \\in \\mathbb{R}_{>0}`:ハイパーパラメータ"

#: bayesml.exponential:34 of
#, python-brace-format
msgid ":math:`\\beta_n \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\beta_n \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.exponential:36 of
msgid ""
"p(\\lambda | x^n) = \\mathrm{Gam}(\\lambda|\\alpha_n,\\beta_n) = "
"\\frac{\\beta_n^{\\alpha_n}}{\\Gamma (\\alpha_n)} \\lambda^{\\alpha_n - 1} "
"\\exp \\{ -\\beta_n \\lambda \\},\n"
"\n"
msgstr ""
"p(\\lambda | x^n) = \\mathrm{Gam}(\\lambda|\\alpha_n,\\beta_n) = "
"\\frac{\\beta_n^{\\alpha_n}}{\\Gamma (\\alpha_n)} \\lambda^{\\alpha_n - 1} "
"\\exp \\{ -\\beta_n \\lambda \\},\n"
"\n"

#: bayesml.exponential:39 of
#, python-brace-format
msgid ""
"\\mathbb{E}[\\lambda | x^n] &= \\frac{\\alpha_n}{\\beta_n}, \\\\\n"
"\\mathbb{V}[\\lambda | x^n] &= \\frac{\\alpha_n}{\\beta_n^2},\n"
"\n"
msgstr ""
"\\mathbb{E}[\\lambda | x^n] &= \\frac{\\alpha_n}{\\beta_n}, \\\\\n"
"\\mathbb{V}[\\lambda | x^n] &= \\frac{\\alpha_n}{\\beta_n^2},\n"
"\n"

#: bayesml.exponential:43 of
msgid "where the updating rule of the hyperparameters is"
msgstr "ここでハイパーパラメータの更新式は以下で与えられます"

#: bayesml.exponential:45 of
#, python-brace-format
msgid ""
"\\alpha_n &= \\alpha_0 + n,\\\\\n"
"\\beta_n &= \\beta_0 + \\sum_{i=1}^n x_i.\n"
"\n"
msgstr ""
"\\alpha_n &= \\alpha_0 + n,\\\\\n"
"\\beta_n &= \\beta_0 + \\sum_{i=1}^n x_i.\n"
"\n"

#: bayesml.exponential:50 of
msgid "The predictive distribution is as follows:"
msgstr "予測分布は以下の通りです："

#: bayesml.exponential:52 of
#, python-brace-format
msgid ":math:`x_{n+1} \\in \\mathbb{R}_{\\geq 0}`: a new data point"
msgstr ":math:`x_{n+1} \\in \\mathbb{R}_{\\geq 0}`: 新たなデータ点"

#: bayesml.exponential:53 of
#, python-brace-format
msgid ""
":math:`\\kappa_\\mathrm{p} \\in \\mathbb{R}_{>0}`: the hyperparameter of the "
"posterior"
msgstr ""
":math:`\\kappa_\\mathrm{p} \\in \\mathbb{R}_{>0}`: 事後分布のハイパーパラメー"
"タ"

#: bayesml.exponential:54 of
#, python-brace-format
msgid ""
":math:`\\lambda_\\mathrm{p} \\in \\mathbb{R}_{>0}`: the hyperparameter of "
"the posterior"
msgstr ""
":math:`\\lambda_\\mathrm{p} \\in \\mathbb{R}_{>0}`: 事後分布のハイパーパラ"
"メータ"

#: bayesml.exponential:56 of
msgid ""
"p(x_{n+1}|x^n)=\\mathrm{Lomax}(x_{n+1}|\\kappa_\\mathrm{p},"
"\\lambda_\\mathrm{p}) = \\frac{\\kappa_\\mathrm{p}}{\\lambda_\\mathrm{p}}"
"\\left(1+\\frac{x_{n+1}}{\\lambda_\\mathrm{p}}\\right)^{-(\\kappa_\\mathrm{p}"
"+1)},\n"
"\n"
msgstr ""
"p(x_{n+1}|x^n)=\\mathrm{Lomax}(x_{n+1}|\\kappa_\\mathrm{p},"
"\\lambda_\\mathrm{p}) = \\frac{\\kappa_\\mathrm{p}}{\\lambda_\\mathrm{p}}"
"\\left(1+\\frac{x_{n+1}}{\\lambda_\\mathrm{p}}\\right)^{-(\\kappa_\\mathrm{p}"
"+1)},\n"
"\n"

#: bayesml.exponential:59 of
msgid ""
"\\mathbb{E}[x_{n+1} | x^n] &=\n"
"\\begin{cases}\n"
"\\frac{\\lambda_\\mathrm{p}}{\\kappa_\\mathrm{p}-1}, & \\kappa_\\mathrm{p}"
">1,\\\\\n"
"\\mathrm{undefined}, & \\text{otherwise},\n"
"\\end{cases}\\\\\n"
"\\mathbb{V}[x_{n+1} | x^n] &=\n"
"\\begin{cases}\n"
"\\frac{\\lambda_\\mathrm{p}^2 \\kappa_\\mathrm{p}}"
"{(\\kappa_\\mathrm{p}-1)^2(\\kappa_\\mathrm{p}-2)}, & \\kappa_\\mathrm{p}"
">2,\\\\\n"
"\\infty, & 1<\\kappa_\\mathrm{p}\\leq 2,\\\\\n"
"\\mathrm{undefined}, & \\text{otherwise},\n"
"\\end{cases}\n"
"\n"
msgstr ""
"\\mathbb{E}[x_{n+1} | x^n] &=\n"
"\\begin{cases}\n"
"\\frac{\\lambda_\\mathrm{p}}{\\kappa_\\mathrm{p}-1}, & \\kappa_\\mathrm{p}"
">1,\\\\\n"
"\\mathrm{undefined}, & \\text{otherwise},\n"
"\\end{cases}\\\\\n"
"\\mathbb{V}[x_{n+1} | x^n] &=\n"
"\\begin{cases}\n"
"\\frac{\\lambda_\\mathrm{p}^2 \\kappa_\\mathrm{p}}"
"{(\\kappa_\\mathrm{p}-1)^2(\\kappa_\\mathrm{p}-2)}, & \\kappa_\\mathrm{p}"
">2,\\\\\n"
"\\infty, & 1<\\kappa_\\mathrm{p}\\leq 2,\\\\\n"
"\\mathrm{undefined}, & \\text{otherwise},\n"
"\\end{cases}\n"
"\n"

#: bayesml.exponential:72 of
msgid ""
"where the parameters are obtained from the hyperparameters of the posterior "
"distribution as follows:"
msgstr ""
"ここで、パラメータは事後分布のハイパーパラメータから以下のように求められます:"

#: bayesml.exponential:74 of
#, python-brace-format
msgid ""
"&\\kappa_\\mathrm{p} = \\alpha_n, \\\\\n"
"&\\lambda_\\mathrm{p} = \\beta_n.\n"
"\n"
msgstr ""
"&\\kappa_\\mathrm{p} = \\alpha_n, \\\\\n"
"&\\lambda_\\mathrm{p} = \\beta_n.\n"
"\n"

