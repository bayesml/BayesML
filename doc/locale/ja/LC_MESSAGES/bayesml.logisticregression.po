#: bayesml.logisticregression:1 of
msgid "The logistic regression model with the Gaussian prior distribution."
msgstr ""

#: bayesml.logisticregression:3 of
msgid "The stochastic data generative model is as follows:"
msgstr ""

#: bayesml.logisticregression:5 of
msgid ":math:`d \\in \\mathbb N`: a dimension"
msgstr ""

#: bayesml.logisticregression:6 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{x} \\in \\mathbb{R}^d`: an explanatory variable. If "
"you consider an intercept term, it should be included as one of the "
"elements of :math:`\\boldsymbol{x}`."
msgstr ""

#: bayesml.logisticregression:7 of
#, python-brace-format
msgid ":math:`y\\in\\{ 0, 1\\}`: an objective variable"
msgstr ""

#: bayesml.logisticregression:8 of
#, python-brace-format
msgid ":math:`\\boldsymbol{w}\\in\\mathbb{R}^{d}`: a parameter"
msgstr ""

#: bayesml.logisticregression:10 of
msgid ""
"p(y|\\boldsymbol{x},\\boldsymbol{w}) = \\sigma( \\boldsymbol{w}^\\top "
"\\boldsymbol{x} )^y \\left\\{ 1 - \\sigma( \\boldsymbol{w}^\\top "
"\\boldsymbol{x} ) \\right\\}^{1 - y},\n"
"\n"
msgstr ""

#: bayesml.logisticregression:13 of
msgid ""
"where :math:`\\sigma(\\cdot)` is defined as follows (called a sigmoid "
"function):"
msgstr ""

#: bayesml.logisticregression:15 of
#, python-brace-format
msgid ""
"\\sigma(a) = \\frac{1}{1+\\exp(-a)}.\n"
"\n"
msgstr ""

#: bayesml.logisticregression:18 of
msgid "The prior distribution is as follows:"
msgstr ""

#: bayesml.logisticregression:20 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\mu}_0 \\in \\mathbb{R}^d`: a hyperparameter"
msgstr ""

#: bayesml.logisticregression:21 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{\\Lambda}_0 \\in \\mathbb{R}^{d\\times d}`: a "
"hyperparameter (a positive definite matrix)"
msgstr ""

#: bayesml.logisticregression:23 of
msgid ""
"p(\\boldsymbol{w}) &= \\mathcal{N}(\\boldsymbol{w}|\\boldsymbol{\\mu}_0, "
"\\boldsymbol{\\Lambda}_0^{-1})\\\\\n"
"&= \\frac{|\\boldsymbol{\\Lambda}_0|^{1/2}}{(2 \\pi)^{d/2}} \\exp "
"\\left\\{ -\\frac{1}{2} (\\boldsymbol{w} - \\boldsymbol{\\mu}_0)^\\top "
"\\boldsymbol{\\Lambda}_0 (\\boldsymbol{w} - \\boldsymbol{\\mu}_0) "
"\\right\\}.\n"
"\n"
msgstr ""

#: bayesml.logisticregression:27 of
msgid ""
"The apporoximate posterior distribution in the :math:`t`-th iteration of "
"a variational Bayesian method is as follows:"
msgstr ""

#: bayesml.logisticregression:29 of
msgid ":math:`n \\in \\mathbb N`: a sample size"
msgstr ""

#: bayesml.logisticregression:30 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{x}^n = (\\boldsymbol{x}_1, \\boldsymbol{x}_2, \\dots "
", \\boldsymbol{x}_n) \\in \\mathbb{R}^{n \\times d}`"
msgstr ""

#: bayesml.logisticregression:31 of
#, python-brace-format
msgid ":math:`\\boldsymbol{y}^n = (y_1, y_2, \\dots , y_n) \\in \\{0,1\\}^n`"
msgstr ""

#: bayesml.logisticregression:32 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\mu}_n^{(t)}\\in \\mathbb{R}^d`: a hyperparameter"
msgstr ""

#: bayesml.logisticregression:33 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{\\Lambda}_n^{(t)} \\in \\mathbb{R}^{d\\times d}`: a "
"hyperparameter (a positive definite matrix)"
msgstr ""

#: bayesml.logisticregression:35 of
msgid ""
"q(\\boldsymbol{w}) &= "
"\\mathcal{N}(\\boldsymbol{w}|\\boldsymbol{\\mu}_n^{(t)}, "
"(\\boldsymbol{\\Lambda}_n^{(t)})^{-1})\\\\\n"
"&= \\frac{|\\boldsymbol{\\Lambda}_n^{(t)}|^{1/2}}{(2 \\pi)^{d/2}} \\exp "
"\\left\\{ -\\frac{1}{2} (\\boldsymbol{w} - "
"\\boldsymbol{\\mu}_n^{(t)})^\\top \\boldsymbol{\\Lambda}_n^{(t)} "
"(\\boldsymbol{w} - \\boldsymbol{\\mu}_n^{(t)}) \\right\\},\n"
"\n"
msgstr ""

#: bayesml.logisticregression:39 of
msgid "where the updating rules of the hyperparameters are as follows:"
msgstr ""

#: bayesml.logisticregression:41 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{\\xi}^{(t)} = (\\xi_{1}^{(t)}, \\xi_{2}^{(t)}, "
"\\dots, \\xi_{n}^{(t)}) \\in \\mathbb{R}_{\\geq 0}^n`: a variational "
"parameter"
msgstr ""

#: bayesml.logisticregression:43 of
msgid ""
"\\boldsymbol{\\Lambda}_n^{(t+1)} &= \\boldsymbol{\\Lambda}_0 + 2 "
"\\sum_{i=1}^{n} \\lambda(\\xi_i^{(t)}) \\boldsymbol{x}_i "
"\\boldsymbol{x}_i^\\top,\\\\\n"
"\\boldsymbol{\\mu}_n^{(t+1)} &= "
"\\left(\\boldsymbol{\\Lambda}_n^{(t+1)}\\right)^{-1} "
"\\left(\\boldsymbol{\\Lambda}_0 \\boldsymbol{\\mu}_0 + \\sum_{i=1}^{n} "
"(y_i - 1/2) \\boldsymbol{x}_{i} \\right),\\\\\n"
"\\xi_i^{(t+1)} &= \\left[ \\boldsymbol{x}_{i}^\\top \\left\\{ "
"\\left(\\boldsymbol{\\Lambda}_n^{(t+1)} \\right)^{-1} + "
"\\boldsymbol{\\mu}_n^{(t+1)} \\boldsymbol{\\mu}_n^{(t+1)\\top} \\right\\}"
" \\boldsymbol{x}_{i} \\right]^{1/2}, \n"
"\n"
msgstr ""

#: bayesml.logisticregression:48 of
msgid "where :math:`\\lambda(\\cdot)` is defined as follows:"
msgstr ""

#: bayesml.logisticregression:50 of
msgid ""
"\\lambda(\\xi) = \\frac{1}{2\\xi} \\left\\{ \\sigma(\\xi) - \\frac{1}{2} "
"\\right\\}.\n"
"\n"
msgstr ""

#: bayesml.logisticregression:53 of
msgid "The approximate predictive distribution is as follows:"
msgstr ""

#: bayesml.logisticregression:55 of
#, python-brace-format
msgid ":math:`\\boldsymbol{x}_{n+1}\\in \\mathbb{R}^d`: a new data point"
msgstr ""

#: bayesml.logisticregression:56 of
#, python-brace-format
msgid ":math:`y_{n+1}\\in \\{ 0, 1\\}`: a new objective variable"
msgstr ""

#: bayesml.logisticregression:58 of
msgid ""
"p(y_{n+1} | \\boldsymbol{x}^n, \\boldsymbol{y}^n, \\boldsymbol{x}_{n+1} )"
" = \\sigma \\left( \\kappa(\\sigma_\\mathrm{p}^2) \\mu_\\mathrm{p} "
"\\right)^y \\left\\{ 1 - \\sigma \\left( \\kappa(\\sigma_\\mathrm{p}^2) "
"\\mu_\\mathrm{p} \\right) \\right\\}^{1 - y},\n"
"\n"
msgstr ""

#: bayesml.logisticregression:61 of
#, python-brace-format
msgid ""
"where :math:`\\sigma_\\mathrm{p}^2`, :math:`\\mu_\\mathrm{p}` are "
"obtained from the hyperparameters of the approximate posterior "
"distribution as follows:"
msgstr ""

#: bayesml.logisticregression:63 of
#, python-brace-format
msgid ""
"\\sigma_\\mathrm{p}^2 &= \\boldsymbol{x}_{n+1}^\\top "
"(\\boldsymbol{\\Lambda}_n^{(t)})^{-1} \\boldsymbol{x}_{n+1} , \\\\\n"
"\\mu_\\mathrm{p} &= \\boldsymbol{x}_{n+1}^\\top "
"\\boldsymbol{\\mu}_n^{(t)}, \n"
"\n"
msgstr ""

#: bayesml.logisticregression:67 of
msgid "and :math:`\\kappa(\\cdot)` is defined as"
msgstr ""

#: bayesml.logisticregression:69 of
#, python-brace-format
msgid ""
"\\kappa(\\sigma^2) = (1 + \\pi \\sigma^2 / 8)^{-1/2}.\n"
"\n"
msgstr ""

