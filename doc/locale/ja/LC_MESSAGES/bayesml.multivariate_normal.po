#: ../../bayesml.multivariate_normal.rst:2
msgid "bayesml.multivariate\\_normal package"
msgstr "bayesml.multivariate\\_normal package"

#: ../../bayesml.multivariate_normal.rst:7
msgid "Module contents"
msgstr "モジュール内容"

#: bayesml.multivariate_normal:1 of
msgid ""
"The multivariate normal distribution with normal-wishart prior distribution."
msgstr "正規・ウィシャート事前分布を持つ多変量正規分布。"

#: bayesml.multivariate_normal:3 of
msgid "The stochastic data generative model is as follows:"
msgstr "確率的データ生成モデルは以下の通りです："

#: bayesml.multivariate_normal:5 of
#, python-brace-format
msgid ":math:`D \\in \\mathbb{N}`: a dimension of data"
msgstr ":math:`D \\in \\mathbb{N}`: データの次元"

#: bayesml.multivariate_normal:6 of
#, python-brace-format
msgid ":math:`\\boldsymbol{x} \\in \\mathbb{R}^D`: a data point"
msgstr ":math:`\\boldsymbol{x} \\in \\mathbb{R}^D`: データ点"

#: bayesml.multivariate_normal:7 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\mu} \\in \\mathbb{R}^D`: a parameter"
msgstr ":math:`\\boldsymbol{\\mu} \\in \\mathbb{R}^D`: パラメータ"

#: bayesml.multivariate_normal:8 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{\\Lambda} \\in \\mathbb{R}^{D\\times D}` : a parameter (a "
"positive definite matrix)"
msgstr ""
":math:`\\boldsymbol{\\Lambda} \\in \\mathbb{R}^{D\\times D}` : パラメータ（正"
"定値行列）"

#: bayesml.multivariate_normal:9 of
#, python-brace-format
msgid ""
":math:`| \\boldsymbol{\\Lambda} | \\in \\mathbb{R}`: the determinant "
"of :math:`\\boldsymbol{\\Lambda}`"
msgstr ""
":math:`| \\boldsymbol{\\Lambda} | \\in \\mathbb{R}"
"`: :math:`\\boldsymbol{\\Lambda}`の行列式"

#: bayesml.multivariate_normal:11 of
msgid ""
"p(\\boldsymbol{x} | \\boldsymbol{\\mu}, \\boldsymbol{\\Lambda}) &= "
"\\mathcal{N}(\\boldsymbol{x}|\\boldsymbol{\\mu},\\boldsymbol{\\Lambda}^{-1}) "
"\\\\\n"
"&= \\frac{| \\boldsymbol{\\Lambda} |^{1/2}}{(2\\pi)^{D/2}} \\exp \\left\\{ -"
"\\frac{1}{2}(\\boldsymbol{x}-\\boldsymbol{\\mu})^\\top \\boldsymbol{\\Lambda} "
"(\\boldsymbol{x}-\\boldsymbol{\\mu}) \\right\\},\n"
"\n"
msgstr ""
"p(\\boldsymbol{x} | \\boldsymbol{\\mu}, \\boldsymbol{\\Lambda}) &= "
"\\mathcal{N}(\\boldsymbol{x}|\\boldsymbol{\\mu},\\boldsymbol{\\Lambda}^{-1}) "
"\\\\\n"
"&= \\frac{| \\boldsymbol{\\Lambda} |^{1/2}}{(2\\pi)^{D/2}} \\exp \\left\\{ -"
"\\frac{1}{2}(\\boldsymbol{x}-\\boldsymbol{\\mu})^\\top \\boldsymbol{\\Lambda} "
"(\\boldsymbol{x}-\\boldsymbol{\\mu}) \\right\\},\n"
"\n"

#: bayesml.multivariate_normal:15 of
#, python-brace-format
msgid ""
"\\mathbb{E} [\\boldsymbol{x} | \\boldsymbol{\\mu}, \\boldsymbol{\\Lambda}] &= "
"\\boldsymbol{\\mu}, \\\\\n"
"\\mathrm{Cov} [\\boldsymbol{x} | \\boldsymbol{\\mu}, \\boldsymbol{\\Lambda}] "
"&= \\boldsymbol{\\Lambda}^{-1}.\n"
"\n"
msgstr ""
"\\mathbb{E} [\\boldsymbol{x} | \\boldsymbol{\\mu}, \\boldsymbol{\\Lambda}] &= "
"\\boldsymbol{\\mu}, \\\\\n"
"\\mathrm{Cov} [\\boldsymbol{x} | \\boldsymbol{\\mu}, \\boldsymbol{\\Lambda}] "
"&= \\boldsymbol{\\Lambda}^{-1}.\n"
"\n"

#: bayesml.multivariate_normal:19 of
msgid "The prior distribution is as follows:"
msgstr "事前分布は以下の通りです："

#: bayesml.multivariate_normal:21 of
#, python-brace-format
msgid ":math:`\\boldsymbol{m}_0 \\in \\mathbb{R}^{D}`: a hyperparameter"
msgstr ":math:`\\boldsymbol{m}_0 \\in \\mathbb{R}^{D}`: ハイパーパラメータ"

#: bayesml.multivariate_normal:22 of
#, python-brace-format
msgid ":math:`\\kappa_0 \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\kappa_0 \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.multivariate_normal:23 of
#, python-brace-format
msgid ":math:`\\nu_0 \\in \\mathbb{R}`: a hyperparameter (:math:`\\nu_0 > D-1`)"
msgstr ""
":math:`\\nu_0 \\in \\mathbb{R}`: ハイパーパラメータ（:math:`\\nu_0 > D-1`）"

#: bayesml.multivariate_normal:24 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{W}_0 \\in \\mathbb{R}^{D\\times D}`: a hyperparameter (a "
"positive definite matrix)"
msgstr ""
":math:`\\boldsymbol{W}_0 \\in \\mathbb{R}^{D\\times D}`: ハイパーパラメータ"
"（正定値行列）"

#: bayesml.multivariate_normal:25 of
#, python-brace-format
msgid ":math:`\\mathrm{Tr} \\{ \\cdot \\}`: a trace of a matrix"
msgstr ":math:`\\mathrm{Tr} \\{ \\cdot \\}`: 行列のトレース"

#: bayesml.multivariate_normal:26 of
msgid ":math:`\\Gamma (\\cdot)`: the gamma function"
msgstr ":math:`\\Gamma (\\cdot)`: ガンマ関数"

#: bayesml.multivariate_normal:28 of
msgid ""
"p(\\boldsymbol{\\mu},\\boldsymbol{\\Lambda}) &= \\mathcal{N}"
"(\\boldsymbol{\\mu}|\\boldsymbol{m}_0,(\\kappa_0 \\boldsymbol{\\Lambda})^{-1})"
"\\mathcal{W}(\\boldsymbol{\\Lambda}|\\boldsymbol{W}_0, \\nu_0) \\\\\n"
"&= \\left( \\frac{\\kappa_0}{2\\pi} \\right)^{D/2} |\\boldsymbol{\\Lambda}|"
"^{1/2} \\exp \\left\\{ -\\frac{\\kappa_0}{2}(\\boldsymbol{\\mu}-"
"\\boldsymbol{m}_0)^\\top \\boldsymbol{\\Lambda} (\\boldsymbol{\\mu}-"
"\\boldsymbol{m}_0) \\right\\} \\\\\n"
"&\\qquad \\times B(\\boldsymbol{W}_0, \\nu_0) | \\boldsymbol{\\Lambda} |"
"^{(\\nu_0 - D - 1) / 2} \\exp \\left\\{ -\\frac{1}{2} \\mathrm{Tr} \\"
"{ \\boldsymbol{W}_0^{-1} \\boldsymbol{\\Lambda} \\} \\right\\},\\\\\n"
"\n"
msgstr ""
"p(\\boldsymbol{\\mu},\\boldsymbol{\\Lambda}) &= \\mathcal{N}"
"(\\boldsymbol{\\mu}|\\boldsymbol{m}_0,(\\kappa_0 \\boldsymbol{\\Lambda})^{-1})"
"\\mathcal{W}(\\boldsymbol{\\Lambda}|\\boldsymbol{W}_0, \\nu_0) \\\\\n"
"&= \\left( \\frac{\\kappa_0}{2\\pi} \\right)^{D/2} |\\boldsymbol{\\Lambda}|"
"^{1/2} \\exp \\left\\{ -\\frac{\\kappa_0}{2}(\\boldsymbol{\\mu}-"
"\\boldsymbol{m}_0)^\\top \\boldsymbol{\\Lambda} (\\boldsymbol{\\mu}-"
"\\boldsymbol{m}_0) \\right\\} \\\\\n"
"&\\qquad \\times B(\\boldsymbol{W}_0, \\nu_0) | \\boldsymbol{\\Lambda} |"
"^{(\\nu_0 - D - 1) / 2} \\exp \\left\\{ -\\frac{1}{2} \\mathrm{Tr} \\"
"{ \\boldsymbol{W}_0^{-1} \\boldsymbol{\\Lambda} \\} \\right\\},\\\\\n"
"\n"

#: bayesml.multivariate_normal:33 of
#, python-brace-format
msgid ""
"\\mathbb{E}[\\boldsymbol{\\mu}] &= \\boldsymbol{m}_0 & (\\nu_n > D), \\\\\n"
"\\mathrm{Cov}[\\boldsymbol{\\mu}] &= \\frac{1}{\\kappa_0 (\\nu_0 - D - 1)} "
"\\boldsymbol{W}_0^{-1} & (\\nu_n > D + 1), \\\\\n"
"\\mathbb{E}[\\boldsymbol{\\Lambda}] &= \\nu_0 \\boldsymbol{W}_0,\n"
"\n"
msgstr ""
"\\mathbb{E}[\\boldsymbol{\\mu}] &= \\boldsymbol{m}_0 & (\\nu_n > D), \\\\\n"
"\\mathrm{Cov}[\\boldsymbol{\\mu}] &= \\frac{1}{\\kappa_0 (\\nu_0 - D - 1)} "
"\\boldsymbol{W}_0^{-1} & (\\nu_n > D + 1), \\\\\n"
"\\mathbb{E}[\\boldsymbol{\\Lambda}] &= \\nu_0 \\boldsymbol{W}_0,\n"
"\n"

#: bayesml.multivariate_normal:38 of
#, python-brace-format
msgid "where :math:`B(\\boldsymbol{W}_0, \\nu_0)` is defined as follows:"
msgstr "ここで、:math:`B(\\boldsymbol{W}_0, \\nu_0)` は次のように定義されます："

#: bayesml.multivariate_normal:40 of
#, python-brace-format
msgid ""
"B(\\boldsymbol{W}_0, \\nu_0) = | \\boldsymbol{W}_0 |^{-\\nu_0 / 2} "
"\\left( 2^{\\nu_0 D / 2} \\pi^{D(D-1)/4} \\prod_{i=1}^D \\Gamma "
"\\left( \\frac{\\nu_0 + 1 - i}{2} \\right) \\right)^{-1}.\n"
"\n"
msgstr ""
"B(\\boldsymbol{W}_0, \\nu_0) = | \\boldsymbol{W}_0 |^{-\\nu_0 / 2} "
"\\left( 2^{\\nu_0 D / 2} \\pi^{D(D-1)/4} \\prod_{i=1}^D \\Gamma "
"\\left( \\frac{\\nu_0 + 1 - i}{2} \\right) \\right)^{-1}.\n"
"\n"

#: bayesml.multivariate_normal:43 of
msgid "The posterior distribution is as follows:"
msgstr "事後分布は以下の通りです："

#: bayesml.multivariate_normal:45 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{x}^n = (\\boldsymbol{x}_1, \\boldsymbol{x}_2, \\dots , "
"\\boldsymbol{x}_n) \\in \\mathbb{R}^{D\\times n}`: given data"
msgstr ""
":math:`\\boldsymbol{x}^n = (\\boldsymbol{x}_1, \\boldsymbol{x}_2, \\dots , "
"\\boldsymbol{x}_n) \\in \\mathbb{R}^{D\\times n}`: 与えられたデータ"

#: bayesml.multivariate_normal:46 of
#, python-brace-format
msgid ":math:`\\boldsymbol{m}_n \\in \\mathbb{R}^{D}`: a hyperparameter"
msgstr ":math:`\\boldsymbol{m}_n \\in \\mathbb{R}^{D}`: ハイパーパラメータ"

#: bayesml.multivariate_normal:47 of
#, python-brace-format
msgid ":math:`\\kappa_n \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\kappa_n \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.multivariate_normal:48 of
#, python-brace-format
msgid ":math:`\\nu_n \\in \\mathbb{R}`: a hyperparameter :math:`(\\nu_n > D-1)`"
msgstr ""
":math:`\\nu_n \\in \\mathbb{R}`: ハイパーパラメータ :math:`(\\nu_n > D-1)`"

#: bayesml.multivariate_normal:49 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{W}_n \\in \\mathbb{R}^{D\\times D}`: a hyperparameter (a "
"positive definite matrix)"
msgstr ""
":math:`\\boldsymbol{W}_n \\in \\mathbb{R}^{D\\times D}`: ハイパーパラメータ"
"（正定値行列）"

#: bayesml.multivariate_normal:51 of
msgid ""
"p(\\boldsymbol{\\mu},\\boldsymbol{\\Lambda} | \\boldsymbol{x}^n) &= "
"\\mathcal{N}(\\boldsymbol{\\mu}|\\boldsymbol{m}_n,(\\kappa_n "
"\\boldsymbol{\\Lambda})^{-1})\\mathcal{W}(\\boldsymbol{\\Lambda}|"
"\\boldsymbol{W}_n, \\nu_n) \\\\\n"
"&= \\left( \\frac{\\kappa_n}{2\\pi} \\right)^{D/2} |\\boldsymbol{\\Lambda}|"
"^{1/2} \\exp \\left\\{ -\\frac{\\kappa_n}{2}(\\boldsymbol{\\mu}-"
"\\boldsymbol{m}_n)^\\top \\boldsymbol{\\Lambda} (\\boldsymbol{\\mu}-"
"\\boldsymbol{m}_n) \\right\\} \\\\\n"
"&\\qquad \\times B(\\boldsymbol{W}_n, \\nu_n) | \\boldsymbol{\\Lambda} |"
"^{(\\nu_n - D - 1) / 2} \\exp \\left\\{ -\\frac{1}{2} \\mathrm{Tr} \\"
"{ \\boldsymbol{W}_n^{-1} \\boldsymbol{\\Lambda} \\} \\right\\},\n"
"\n"
msgstr ""
"p(\\boldsymbol{\\mu},\\boldsymbol{\\Lambda} | \\boldsymbol{x}^n) &= "
"\\mathcal{N}(\\boldsymbol{\\mu}|\\boldsymbol{m}_n,(\\kappa_n "
"\\boldsymbol{\\Lambda})^{-1})\\mathcal{W}(\\boldsymbol{\\Lambda}|"
"\\boldsymbol{W}_n, \\nu_n) \\\\\n"
"&= \\left( \\frac{\\kappa_n}{2\\pi} \\right)^{D/2} |\\boldsymbol{\\Lambda}|"
"^{1/2} \\exp \\left\\{ -\\frac{\\kappa_n}{2}(\\boldsymbol{\\mu}-"
"\\boldsymbol{m}_n)^\\top \\boldsymbol{\\Lambda} (\\boldsymbol{\\mu}-"
"\\boldsymbol{m}_n) \\right\\} \\\\\n"
"&\\qquad \\times B(\\boldsymbol{W}_n, \\nu_n) | \\boldsymbol{\\Lambda} |"
"^{(\\nu_n - D - 1) / 2} \\exp \\left\\{ -\\frac{1}{2} \\mathrm{Tr} \\"
"{ \\boldsymbol{W}_n^{-1} \\boldsymbol{\\Lambda} \\} \\right\\},\n"
"\n"

#: bayesml.multivariate_normal:56 of
#, python-brace-format
msgid ""
"\\mathbb{E}[\\boldsymbol{\\mu} | \\boldsymbol{x}^n] &= \\boldsymbol{m}_n & "
"(\\nu_n > D), \\\\\n"
"\\mathrm{Cov}[\\boldsymbol{\\mu} | \\boldsymbol{x}^n] &= \\frac{1}{\\kappa_n "
"(\\nu_n - D - 1)} \\boldsymbol{W}_n^{-1} & (\\nu_n > D + 1), \\\\\n"
"\\mathbb{E}[\\boldsymbol{\\Lambda} | \\boldsymbol{x}^n] &= \\nu_n "
"\\boldsymbol{W}_n,\n"
"\n"
msgstr ""
"\\mathbb{E}[\\boldsymbol{\\mu} | \\boldsymbol{x}^n] &= \\boldsymbol{m}_n & "
"(\\nu_n > D), \\\\\n"
"\\mathrm{Cov}[\\boldsymbol{\\mu} | \\boldsymbol{x}^n] &= \\frac{1}{\\kappa_n "
"(\\nu_n - D - 1)} \\boldsymbol{W}_n^{-1} & (\\nu_n > D + 1), \\\\\n"
"\\mathbb{E}[\\boldsymbol{\\Lambda} | \\boldsymbol{x}^n] &= \\nu_n "
"\\boldsymbol{W}_n,\n"
"\n"

#: bayesml.multivariate_normal:61 of
msgid "where the updating rule of the hyperparameters is"
msgstr "ここでハイパーパラメータの更新式は以下で与えられます"

#: bayesml.multivariate_normal:63 of
msgid ""
"\\bar{\\boldsymbol{x}} &= \\frac{1}{n} \\sum_{i=1}^n \\boldsymbol{x}_i, \\\\\n"
"\\boldsymbol{m}_n &= \\frac{\\kappa_0\\boldsymbol{\\mu}"
"_0+n\\bar{\\boldsymbol{x}}}{\\kappa_0+n}, \\\\\n"
"\\kappa_n &= \\kappa_0 + n, \\\\\n"
"\\boldsymbol{W}_n^{-1} &= \\boldsymbol{W}_0^{-1} + \\sum_{i=1}^{n}"
"(\\boldsymbol{x}_i-\\bar{\\boldsymbol{x}})(\\boldsymbol{x}_i-"
"\\bar{\\boldsymbol{x}})^\\top + \\frac{\\kappa_0 n}{\\kappa_0+n}"
"(\\bar{\\boldsymbol{x}}-\\boldsymbol{\\mu}_0)(\\bar{\\boldsymbol{x}}-"
"\\boldsymbol{\\mu}_0)^\\top, \\\\\n"
"\\nu_n &= \\nu_0 + n.\\\\\n"
"\n"
msgstr ""
"\\bar{\\boldsymbol{x}} &= \\frac{1}{n} \\sum_{i=1}^n \\boldsymbol{x}_i, \\\\\n"
"\\boldsymbol{m}_n &= \\frac{\\kappa_0\\boldsymbol{\\mu}"
"_0+n\\bar{\\boldsymbol{x}}}{\\kappa_0+n}, \\\\\n"
"\\kappa_n &= \\kappa_0 + n, \\\\\n"
"\\boldsymbol{W}_n^{-1} &= \\boldsymbol{W}_0^{-1} + \\sum_{i=1}^{n}"
"(\\boldsymbol{x}_i-\\bar{\\boldsymbol{x}})(\\boldsymbol{x}_i-"
"\\bar{\\boldsymbol{x}})^\\top + \\frac{\\kappa_0 n}{\\kappa_0+n}"
"(\\bar{\\boldsymbol{x}}-\\boldsymbol{\\mu}_0)(\\bar{\\boldsymbol{x}}-"
"\\boldsymbol{\\mu}_0)^\\top, \\\\\n"
"\\nu_n &= \\nu_0 + n.\\\\\n"
"\n"

#: bayesml.multivariate_normal:70 of
msgid "The predictive distribution is as follows:"
msgstr "予測分布は以下の通りです："

#: bayesml.multivariate_normal:72 of
#, python-brace-format
msgid ":math:`\\boldsymbol{x}_{n+1} \\in \\mathbb{R}^D`: a new data point"
msgstr ":math:`\\boldsymbol{x}_{n+1}\\in \\mathbb{R}^d`: 新たなデータ点"

#: bayesml.multivariate_normal:73 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{\\mu}_\\mathrm{p} \\in \\mathbb{R}^D`: the hyperparameter "
"of the predictive distribution"
msgstr ""
":math:`\\boldsymbol{\\mu}_\\mathrm{p} \\in \\mathbb{R}^D`: 予測分布のハイパー"
"パラメータ"

#: bayesml.multivariate_normal:74 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{\\Lambda}_\\mathrm{p} \\in \\mathbb{R}^{D \\times D}`: "
"the hyperparameter of the predictive distribution (a positive definite matrix)"
msgstr ""
":math:`\\boldsymbol{\\Lambda}_\\mathrm{p} \\in \\mathbb{R}^{D \\times D}`: 予"
"測分布のハイパーパラメータ（正定値行列）"

#: bayesml.multivariate_normal:75 of
#, python-brace-format
msgid ""
":math:`\\nu_\\mathrm{p} \\in \\mathbb{R}_{>0}`: the hyperparameter of the "
"predictive distribution"
msgstr ""
":math:`\\nu_\\mathrm{p} \\in \\mathbb{R}_{>0}`: 予測分布のハイパーパラメータ"

#: bayesml.multivariate_normal:77 of
msgid ""
"&p(x_{n+1}|x^n) \\\\\n"
"&= \\mathrm{St}(x_{n+1}|\\boldsymbol{\\mu}_\\mathrm{p},\\boldsymbol{\\Lambda}"
"_\\mathrm{p}, \\nu_\\mathrm{p}) \\\\\n"
"&= \\frac{\\Gamma (\\nu_\\mathrm{p} / 2 + D / 2)}{\\Gamma (\\nu_\\mathrm{p} / "
"2)} \\frac{|\\boldsymbol{\\Lambda}_\\mathrm{p}|^{1/2}}{(\\nu_\\mathrm{p} "
"\\pi)^{D/2}} \\left( 1 + \\frac{1}{\\nu_\\mathrm{p}} (\\boldsymbol{x}_{n+1} - "
"\\boldsymbol{\\mu}_\\mathrm{p})^\\top \\boldsymbol{\\Lambda}_\\mathrm{p} "
"(\\boldsymbol{x}_{n+1} - \\boldsymbol{\\mu}_\\mathrm{p}) \\right)^{-"
"\\nu_\\mathrm{p}/2 - D/2},\n"
"\n"
msgstr ""
"&p(x_{n+1}|x^n) \\\\\n"
"&= \\mathrm{St}(x_{n+1}|\\boldsymbol{\\mu}_\\mathrm{p},\\boldsymbol{\\Lambda}"
"_\\mathrm{p}, \\nu_\\mathrm{p}) \\\\\n"
"&= \\frac{\\Gamma (\\nu_\\mathrm{p} / 2 + D / 2)}{\\Gamma (\\nu_\\mathrm{p} / "
"2)} \\frac{|\\boldsymbol{\\Lambda}_\\mathrm{p}|^{1/2}}{(\\nu_\\mathrm{p} "
"\\pi)^{D/2}} \\left( 1 + \\frac{1}{\\nu_\\mathrm{p}} (\\boldsymbol{x}_{n+1} - "
"\\boldsymbol{\\mu}_\\mathrm{p})^\\top \\boldsymbol{\\Lambda}_\\mathrm{p} "
"(\\boldsymbol{x}_{n+1} - \\boldsymbol{\\mu}_\\mathrm{p}) \\right)^{-"
"\\nu_\\mathrm{p}/2 - D/2},\n"
"\n"

#: bayesml.multivariate_normal:82 of
msgid ""
"\\mathbb{E}[\\boldsymbol{x}_{n+1} | \\boldsymbol{x}^n] &= \\boldsymbol{\\mu}"
"_\\mathrm{p} & (\\nu_\\mathrm{p} > 1), \\\\\n"
"\\mathrm{Cov}[\\boldsymbol{x}_{n+1} | \\boldsymbol{x}^n] &= "
"\\frac{\\nu_\\mathrm{p}}{\\nu_\\mathrm{p}-2} \\boldsymbol{\\Lambda}"
"_\\mathrm{p}^{-1} & (\\nu_\\mathrm{p} > 2),\n"
"\n"
msgstr ""
"\\mathbb{E}[\\boldsymbol{x}_{n+1} | \\boldsymbol{x}^n] &= \\boldsymbol{\\mu}"
"_\\mathrm{p} & (\\nu_\\mathrm{p} > 1), \\\\\n"
"\\mathrm{Cov}[\\boldsymbol{x}_{n+1} | \\boldsymbol{x}^n] &= "
"\\frac{\\nu_\\mathrm{p}}{\\nu_\\mathrm{p}-2} \\boldsymbol{\\Lambda}"
"_\\mathrm{p}^{-1} & (\\nu_\\mathrm{p} > 2),\n"
"\n"

#: bayesml.multivariate_normal:86 of
msgid ""
"where the parameters are obtained from the hyperparameters of the posterior "
"distribution as follows:"
msgstr ""
"ここで、パラメータは事後分布のハイパーパラメータから以下のように求められます:"

#: bayesml.multivariate_normal:88 of
#, python-brace-format
msgid ""
"\\boldsymbol{\\mu}_\\mathrm{p} &= \\boldsymbol{m}_n, \\\\\n"
"\\boldsymbol{\\Lambda}_\\mathrm{p} &= \\frac{\\kappa_n (\\nu_n - D + 1)}"
"{\\kappa_n + 1} \\boldsymbol{W}_n, \\\\\n"
"\\nu_\\mathrm{p} &= \\nu_n - D + 1.\n"
"\n"
msgstr ""
"\\boldsymbol{\\mu}_\\mathrm{p} &= \\boldsymbol{m}_n, \\\\\n"
"\\boldsymbol{\\Lambda}_\\mathrm{p} &= \\frac{\\kappa_n (\\nu_n - D + 1)}"
"{\\kappa_n + 1} \\boldsymbol{W}_n, \\\\\n"
"\\nu_\\mathrm{p} &= \\nu_n - D + 1.\n"
"\n"

