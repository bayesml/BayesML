msgstr "bayesml.bernoulli package"

#: ../../bayesml.bernoulli.rst:5
msgid "Module contents"
msgstr "モジュール内容"

#: bayesml.bernoulli:1 of
msgid ""
"This module provides the Bernoulli distribution with the beta prior "
"distribution."
msgstr "このモジュールではベータ事前分布を用いたベルヌーイ分布を利用できます。"

#: bayesml.bernoulli:6 of
msgid "Stochastic Data Generative Model"
msgstr "確率的データ生成モデル"

#: bayesml.bernoulli:8 of
msgid "The stochastic data generative model is as follows:"
msgstr "確率的データ生成モデルは以下の通りです："

#: bayesml.bernoulli:10 of
#, python-brace-format
msgid ":math:`x \\in \\{ 0, 1\\}`: a data point"
msgstr ":math:`x \\in \\{ 0, 1\\}`: データ"

#: bayesml.bernoulli:11 of
msgid ":math:`\\theta \\in [0, 1]`: a parameter"
msgstr ":math:`\\theta \\in [0, 1]`: パラメータ"

#: bayesml.bernoulli:13 of
#, python-brace-format
msgid ""
"p(x | \\theta) = \\mathrm{Bern}(x|\\theta) = \\theta^x (1-\\theta)^{1-x}.\n"
"\n"
msgstr ""
"p(x | \\theta) = \\mathrm{Bern}(x|\\theta) = \\theta^x (1-\\theta)^{1-x}.\n"
"\n"

#: bayesml.bernoulli:16 of
#, python-brace-format
msgid ""
"\\mathbb{E}[x | \\theta] &= \\theta, \\\\\n"
"\\mathbb{V}[x | \\theta] &= \\theta (1 - \\theta).\n"
"\n"
msgstr ""
"\\mathbb{E}[x | \\theta] &= \\theta, \\\\\n"
"\\mathbb{V}[x | \\theta] &= \\theta (1 - \\theta).\n"
"\n"

#: bayesml.bernoulli:21 of
msgid "Prior Distribution"
msgstr "事前分布"

#: bayesml.bernoulli:23 of
msgid "The prior distribution is as follows:"
msgstr "事前分布は以下の通りです："

#: bayesml.bernoulli:25 of
#, python-brace-format
msgid ":math:`\\alpha_0 \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\alpha_0 \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.bernoulli:26 of
#, python-brace-format
msgid ":math:`\\beta_0 \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\beta_0 \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.bernoulli:27 of
#, python-brace-format
msgid ""
":math:`B(\\cdot,\\cdot): \\mathbb{R}_{>0} \\times \\mathbb{R}_{>0} \\to "
"\\mathbb{R}_{>0}`: the Beta function"
msgstr ""
":math:`B(\\cdot,\\cdot): \\mathbb{R}_{>0} \\times \\mathbb{R}_{>0} \\to "
"\\mathbb{R}_{>0}`: ベータ関数"

#: bayesml.bernoulli:29 of
#, python-brace-format
msgid ""
"p(\\theta) = \\mathrm{Beta}(\\theta|\\alpha_0,\\beta_0) = \\frac{1}"
"{B(\\alpha_0, \\beta_0)} \\theta^{\\alpha_0 - 1} (1-\\theta)^{\\beta_0 - 1}.\n"
"\n"
msgstr ""
"p(\\theta) = \\mathrm{Beta}(\\theta|\\alpha_0,\\beta_0) = \\frac{1}"
"{B(\\alpha_0, \\beta_0)} \\theta^{\\alpha_0 - 1} (1-\\theta)^{\\beta_0 - 1}.\n"
"\n"

#: bayesml.bernoulli:32 of
#, python-brace-format
msgid ""
"\\mathbb{E}[\\theta] &= \\frac{\\alpha_0}{\\alpha_0 + \\beta_0}, \\\\\n"
"\\mathbb{V}[\\theta] &= \\frac{\\alpha_0 \\beta_0}{(\\alpha_0 + \\beta_0)^2 "
"(\\alpha_0 + \\beta_0 + 1)}.\n"
"\n"
msgstr ""
"\\mathbb{E}[\\theta] &= \\frac{\\alpha_0}{\\alpha_0 + \\beta_0}, \\\\\n"
"\\mathbb{V}[\\theta] &= \\frac{\\alpha_0 \\beta_0}{(\\alpha_0 + \\beta_0)^2 "
"(\\alpha_0 + \\beta_0 + 1)}.\n"
"\n"

#: bayesml.bernoulli:37 of
msgid "Posterior Distribution"
msgstr "事後分布"

#: bayesml.bernoulli:39 of
msgid "The posterior distribution is as follows:"
msgstr "事後分布は以下の通りです："

#: bayesml.bernoulli:41 of
#, python-brace-format
msgid ":math:`x^n = (x_1, x_2, \\dots , x_n) \\in \\{ 0, 1\\}^n`: given data"
msgstr ""
":math:`x^n = (x_1, x_2, \\dots , x_n) \\in \\{ 0, 1\\}^n`: 与えられたデータ"

#: bayesml.bernoulli:42 of
#, python-brace-format
msgid ":math:`\\alpha_n \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\alpha_n \\in \\mathbb{R}_{>0}`:ハイパーパラメータ"

#: bayesml.bernoulli:43 of
#, python-brace-format
msgid ":math:`\\beta_n \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\beta_n \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.bernoulli:45 of
#, python-brace-format
msgid ""
"p(\\theta | x^n) = \\mathrm{Beta}(\\theta|\\alpha_n,\\beta_n) = \\frac{1}"
"{B(\\alpha_n, \\beta_n)} \\theta^{\\alpha_n - 1} (1-\\theta)^{\\beta_n - 1},\n"
"\n"
msgstr ""
"p(\\theta | x^n) = \\mathrm{Beta}(\\theta|\\alpha_n,\\beta_n) = \\frac{1}"
"{B(\\alpha_n, \\beta_n)} \\theta^{\\alpha_n - 1} (1-\\theta)^{\\beta_n - 1},\n"
"\n"

#: bayesml.bernoulli:48 of
#, python-brace-format
msgid ""
"\\mathbb{E}[\\theta | x^n] &= \\frac{\\alpha_n}{\\alpha_n + \\beta_n}, \\\\\n"
"\\mathbb{V}[\\theta | x^n] &= \\frac{\\alpha_n \\beta_n}{(\\alpha_n + "
"\\beta_n)^2 (\\alpha_n + \\beta_n + 1)},\n"
"\n"
msgstr ""
"\\mathbb{E}[\\theta | x^n] &= \\frac{\\alpha_n}{\\alpha_n + \\beta_n}, \\\\\n"
"\\mathbb{V}[\\theta | x^n] &= \\frac{\\alpha_n \\beta_n}{(\\alpha_n + "
"\\beta_n)^2 (\\alpha_n + \\beta_n + 1)},\n"
"\n"

#: bayesml.bernoulli:52 of
msgid "where the updating rule of the hyperparameters is"
msgstr "ここでハイパーパラメータの更新式は以下で与えられます"

#: bayesml.bernoulli:54 of
#, python-brace-format
msgid ""
"\\alpha_n = \\alpha_0 + \\sum_{i=1}^n I \\{ x_i = 1 \\},\\\\\n"
"\\beta_n = \\beta_0 + \\sum_{i=1}^n I \\{ x_i = 0 \\}.\n"
"\n"
msgstr ""
"\\alpha_n = \\alpha_0 + \\sum_{i=1}^n I \\{ x_i = 1 \\},\\\\\n"
"\\beta_n = \\beta_0 + \\sum_{i=1}^n I \\{ x_i = 0 \\}.\n"
"\n"

#: bayesml.bernoulli:59 of
msgid "Predictive Distribution"
msgstr "予測分布"

#: bayesml.bernoulli:61 of
msgid "The predictive distribution is as follows:"
msgstr "予測分布は以下の通りです："

#: bayesml.bernoulli:63 of
#, python-brace-format
msgid ":math:`x_{n+1} \\in \\{ 0, 1\\}`: a new data point"
msgstr ":math:`x_{n+1} \\in \\{ 0, 1\\}`: 新しいデータ点"

#: bayesml.bernoulli:64 of
#, python-brace-format
msgid ":math:`\\alpha_\\mathrm{p} \\in \\mathbb{R}_{>0}`: a parameter"
msgstr ":math:`\\alpha_\\mathrm{p} \\in \\mathbb{R}_{>0}`: パラメータ"

#: bayesml.bernoulli:65 of
#, python-brace-format
msgid ":math:`\\beta_\\mathrm{p} \\in \\mathbb{R}_{>0}`: a parameter"
msgstr ":math:`\\beta_\\mathrm{p} \\in \\mathbb{R}_{>0}`: パラメータ"

#: bayesml.bernoulli:66 of
#, python-brace-format
msgid ":math:`\\theta_\\mathrm{p} \\in [0,1]`: a parameter"
msgstr ":math:`\\theta_\\mathrm{p} \\in [0,1]`: パラメータ"

#: bayesml.bernoulli:68 of
msgid ""
"p(x_{n+1} | x^n) = \\mathrm{Bern}(x_{n+1}|\\theta_\\mathrm{p}) "
"=\\theta_\\mathrm{p}^{x_{n+1}}(1-\\theta_\\mathrm{p})^{1-x_{n+1}},\n"
"\n"
msgstr ""
"p(x_{n+1} | x^n) = \\mathrm{Bern}(x_{n+1}|\\theta_\\mathrm{p}) "
"=\\theta_\\mathrm{p}^{x_{n+1}}(1-\\theta_\\mathrm{p})^{1-x_{n+1}},\n"
"\n"

#: bayesml.bernoulli:71 of
#, python-brace-format
msgid ""
"\\mathbb{E}[x_{n+1} | x^n] &= \\theta_\\mathrm{p}, \\\\\n"
"\\mathbb{V}[x_{n+1} | x^n] &= \\theta_\\mathrm{p} (1 - \\theta_\\mathrm{p}),\n"
"\n"
msgstr ""
"\\mathbb{E}[x_{n+1} | x^n] &= \\theta_\\mathrm{p}, \\\\\n"
"\\mathbb{V}[x_{n+1} | x^n] &= \\theta_\\mathrm{p} (1 - \\theta_\\mathrm{p}),\n"
"\n"

#: bayesml.bernoulli:75 of
msgid ""
"where the parameters are obtained from the hyperparameters of the posterior "
"distribution as follows."
msgstr ""
"ここで、パラメータは事後分布のハイパーパラメータから以下のように求められます。"

#: bayesml.bernoulli:77 of
#, python-brace-format
msgid ""
"\\theta_\\mathrm{p} = \\frac{\\alpha_n}{\\alpha_n + \\beta_n}.\n"
"\n"
msgstr ""
"\\theta_\\mathrm{p} = \\frac{\\alpha_n}{\\alpha_n + \\beta_n}.\n"
"\n"

