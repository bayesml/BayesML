#: ../../bayesml.linearregression.rst:2
msgid "bayesml.linearregression package"
msgstr "bayesml.linearregression package"

#: ../../bayesml.linearregression.rst:5
msgid "Module contents"
msgstr "モジュール内容"

#: bayesml.linearregression:1 of
msgid "This module provides the linear regression model with the normal-gamma prior distribution."
msgstr "このモジュールでは正規ガンマ事前分布を用いた線形回帰モデルを利用できます。"

#: bayesml.linearregression:6 of
msgid "Stochastic Data Generative Model"
msgstr "確率的データ生成モデル"

#: bayesml.linearregression:8 of
msgid "The stochastic data generative model is as follows:"
msgstr "確率的データ生成モデルは以下の通りです："

#: bayesml.linearregression:10 of
msgid ":math:`d \\in \\mathbb N`: a dimension"
msgstr ":math:`d \\in \\mathbb N`: 次元"

#: bayesml.linearregression:11 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{x} = [x_1, x_2, \\dots , x_d] \\in \\mathbb{R}^d`: an explanatory variable. If you consider an "
"intercept term, it should be included as one of the elements of :math:`\\boldsymbol{x}`."
msgstr ""
":math:`\\boldsymbol{x} = [x_1, x_2, \\dots , x_d] \\in \\mathbb{R}^d`: 説明変数。切片項を考慮する場合、それ"
"は :math:`\\boldsymbol{x}` の要素の一つとして含める必要があります。"

#: bayesml.linearregression:12 of
#, python-brace-format
msgid ":math:`y\\in\\mathbb{R}`: an objective variable"
msgstr ":math:`y\\in\\mathbb{R}`: 目的変数"

#: bayesml.linearregression:13 of
#, python-brace-format
msgid ":math:`\\tau \\in\\mathbb{R}_{>0}`: a parameter"
msgstr ":math:`\\tau \\in\\mathbb{R}_{>0}`: パラメータ"

#: bayesml.linearregression:14 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\theta}\\in\\mathbb{R}^{d}`: a parameter"
msgstr ":math:`\\boldsymbol{\\theta}\\in\\mathbb{R}^{d}`: パラメータ"

#: bayesml.linearregression:16 of
msgid ""
"p(y|\\boldsymbol{x},\\boldsymbol{\\theta},\\tau) &= \\mathcal N (y| \\boldsymbol{\\theta}^{\\top} \\boldsymbol{x},"
"\\tau^{-1}) \\\\\n"
"&= \\sqrt{\\frac{\\tau}{2 \\pi}} \\exp \\left\\{ -\\frac{\\tau}{2} (y - \\boldsymbol{\\theta}^\\top \\boldsymbol{x})^2 "
"\\right\\}.\n"
"\n"
msgstr ""
"p(y|\\boldsymbol{x},\\boldsymbol{\\theta},\\tau) &= \\mathcal N (y| \\boldsymbol{\\theta}^{\\top} \\boldsymbol{x},"
"\\tau^{-1}) \\\\\n"
"&= \\sqrt{\\frac{\\tau}{2 \\pi}} \\exp \\left\\{ -\\frac{\\tau}{2} (y - \\boldsymbol{\\theta}^\\top \\boldsymbol{x})^2 "
"\\right\\}.\n"
"\n"

#: bayesml.linearregression:21 of
#, python-brace-format
msgid ""
"&\\mathbb{E}[ y | \\boldsymbol{x},\\boldsymbol{\\theta},\\tau] = \\boldsymbol{\\theta}^{\\top} \\boldsymbol{x}, \\\\\n"
"&\\mathbb{V}[ y | \\boldsymbol{x},\\boldsymbol{\\theta},\\tau ] = \\tau^{-1}.\n"
"\n"
msgstr ""
"&\\mathbb{E}[ y | \\boldsymbol{x},\\boldsymbol{\\theta},\\tau] = \\boldsymbol{\\theta}^{\\top} \\boldsymbol{x}, \\\\\n"
"&\\mathbb{V}[ y | \\boldsymbol{x},\\boldsymbol{\\theta},\\tau ] = \\tau^{-1}.\n"
"\n"

#: bayesml.linearregression:26 of
msgid "Prior Distribution"
msgstr "事前分布"

#: bayesml.linearregression:28 of
msgid "The prior distribution is as follows:"
msgstr "事前分布は以下の通りです："

#: bayesml.linearregression:30 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\mu_0} \\in \\mathbb{R}^d`: a hyperparameter"
msgstr ":math:`\\boldsymbol{\\mu_0} \\in \\mathbb{R}^d`: ハイパーパラメータ"

#: bayesml.linearregression:31 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\Lambda_0} \\in \\mathbb{R}^{d\\times d}`: a hyperparameter (a positive definite matrix)"
msgstr ":math:`\\boldsymbol{\\Lambda_0} \\in \\mathbb{R}^{d\\times d}`: ハイパーパラメータ（正定値行列）"

#: bayesml.linearregression:32 of
#, python-brace-format
msgid ":math:`\\alpha_0\\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\alpha_0 \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.linearregression:33 of
#, python-brace-format
msgid ":math:`\\beta_0\\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\beta_0 \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.linearregression:35 of
msgid ""
"p(\\boldsymbol{\\theta}, \\tau) &= \\mathcal{N}(\\boldsymbol{\\theta}|\\boldsymbol{\\mu}_0, (\\tau "
"\\boldsymbol{\\Lambda}_0)^{-1}) \\mathrm{Gam}(\\tau|\\alpha_0,\\beta_0)\\\\\n"
"&= \\frac{|\\tau \\boldsymbol{\\Lambda}_0|^{1/2}}{(2 \\pi)^{d/2}} \\exp \\left\\{ -\\frac{\\tau}{2} "
"(\\boldsymbol{\\theta} - \\boldsymbol{\\mu}_0)^\\top \\boldsymbol{\\Lambda}_0 (\\boldsymbol{\\theta} - "
"\\boldsymbol{\\mu}_0) \\right\\} \\frac{\\beta_0^{\\alpha_0}}{\\Gamma (\\alpha_0)} \\tau^{\\alpha_0 - 1} \\exp \\{ -"
"\\beta_0 \\tau \\} .\n"
"\n"
msgstr ""
"p(\\boldsymbol{\\theta}, \\tau) &= \\mathcal{N}(\\boldsymbol{\\theta}|\\boldsymbol{\\mu}_0, (\\tau "
"\\boldsymbol{\\Lambda}_0)^{-1}) \\mathrm{Gam}(\\tau|\\alpha_0,\\beta_0)\\\\\n"
"&= \\frac{|\\tau \\boldsymbol{\\Lambda}_0|^{1/2}}{(2 \\pi)^{d/2}} \\exp \\left\\{ -\\frac{\\tau}{2} "
"(\\boldsymbol{\\theta} - \\boldsymbol{\\mu}_0)^\\top \\boldsymbol{\\Lambda}_0 (\\boldsymbol{\\theta} - "
"\\boldsymbol{\\mu}_0) \\right\\} \\frac{\\beta_0^{\\alpha_0}}{\\Gamma (\\alpha_0)} \\tau^{\\alpha_0 - 1} \\exp \\{ -"
"\\beta_0 \\tau \\} .\n"
"\n"

#: bayesml.linearregression:39 of
#, python-brace-format
msgid ""
"\\mathbb{E}[\\boldsymbol{\\theta}] &= \\boldsymbol{\\mu}_0 & \\left( \\alpha_0 > \\frac{1}{2} \\right), \\\\\n"
"\\mathrm{Cov}[\\boldsymbol{\\theta}] &= \\frac{\\beta_0}{\\alpha_0 - 1} \\boldsymbol{\\Lambda}_0^{-1} & (\\alpha_0 > "
"1), \\\\\n"
"\\mathbb{E}[\\tau] &= \\frac{\\alpha_0}{\\beta_0}, \\\\\n"
"\\mathbb{V}[\\tau] &= \\frac{\\alpha_0}{\\beta_0^2}.\n"
"\n"
msgstr ""
"\\mathbb{E}[\\boldsymbol{\\theta}] &= \\boldsymbol{\\mu}_0 & \\left( \\alpha_0 > \\frac{1}{2} \\right), \\\\\n"
"\\mathrm{Cov}[\\boldsymbol{\\theta}] &= \\frac{\\beta_0}{\\alpha_0 - 1} \\boldsymbol{\\Lambda}_0^{-1} & (\\alpha_0 > "
"1), \\\\\n"
"\\mathbb{E}[\\tau] &= \\frac{\\alpha_0}{\\beta_0}, \\\\\n"
"\\mathbb{V}[\\tau] &= \\frac{\\alpha_0}{\\beta_0^2}.\n"
"\n"

#: bayesml.linearregression:46 of
msgid "Posterior Distribution"
msgstr "事後分布"

#: bayesml.linearregression:48 of
msgid "The posterior distribution is as follows:"
msgstr "事後分布は以下の通りです："

#: bayesml.linearregression:50 of
msgid ":math:`n \\in \\mathbb N`: a sample size"
msgstr ":math:`n \\in \\mathbb N`: サンプルサイズ"

#: bayesml.linearregression:51 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{X} = [\\boldsymbol{x}_1, \\boldsymbol{x}_2, \\dots , \\boldsymbol{x}_n]^\\top \\in \\mathbb{R}^{n "
"\\times d}`"
msgstr ""
":math:`\\boldsymbol{X} = [\\boldsymbol{x}_1, \\boldsymbol{x}_2, \\dots , \\boldsymbol{x}_n]^\\top \\in \\mathbb{R}^{n "
"\\times d}`"

#: bayesml.linearregression:52 of
#, python-brace-format
msgid ":math:`\\boldsymbol{y} = [y_1, y_2, \\dots , y_n]^\\top \\in \\mathbb{R}^n`"
msgstr ":math:`\\boldsymbol{y} = [y_1, y_2, \\dots , y_n]^\\top \\in \\mathbb{R}^n`"

#: bayesml.linearregression:53 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\mu}_n\\in \\mathbb{R}^d`: a hyperparameter"
msgstr ":math:`\\boldsymbol{\\mu}_n\\in \\mathbb{R}^d`: ハイパーパラメータ"

#: bayesml.linearregression:54 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\Lambda_n} \\in \\mathbb{R}^{d\\times d}`: a hyperparameter (a positive definite matrix)"
msgstr ":math:`\\boldsymbol{\\Lambda_n} \\in \\mathbb{R}^{d\\times d}`: ハイパーパラメータ（正定値行列）"

#: bayesml.linearregression:55 of
#, python-brace-format
msgid ":math:`\\alpha_n\\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\alpha_n \\in \\mathbb{R}_{>0}`:ハイパーパラメータ"

#: bayesml.linearregression:56 of
#, python-brace-format
msgid ":math:`\\beta_n\\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\beta_n \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.linearregression:58 of
msgid ""
"p(\\boldsymbol{\\theta}, \\tau | \\boldsymbol{X}, \\boldsymbol{y}) &= \\mathcal{N}(\\boldsymbol{\\theta}|"
"\\boldsymbol{\\mu}_n, (\\tau \\boldsymbol{\\Lambda}_n)^{-1}) \\mathrm{Gam}(\\tau|\\alpha_n,\\beta_n)\\\\\n"
"&= \\frac{|\\tau \\boldsymbol{\\Lambda}_n|^{1/2}}{(2 \\pi)^{d/2}} \\exp \\left\\{ -\\frac{\\tau}{2} "
"(\\boldsymbol{\\theta} - \\boldsymbol{\\mu}_n)^\\top \\boldsymbol{\\Lambda}_n (\\boldsymbol{\\theta} - "
"\\boldsymbol{\\mu}_n) \\right\\} \\frac{\\beta_n^{\\alpha_n}}{\\Gamma (\\alpha_n)} \\tau^{\\alpha_n - 1} \\exp \\{ -"
"\\beta_n \\tau \\} .\n"
"\n"
msgstr ""
"p(\\boldsymbol{\\theta}, \\tau | \\boldsymbol{X}, \\boldsymbol{y}) &= \\mathcal{N}(\\boldsymbol{\\theta}|"
"\\boldsymbol{\\mu}_n, (\\tau \\boldsymbol{\\Lambda}_n)^{-1}) \\mathrm{Gam}(\\tau|\\alpha_n,\\beta_n)\\\\\n"
"&= \\frac{|\\tau \\boldsymbol{\\Lambda}_n|^{1/2}}{(2 \\pi)^{d/2}} \\exp \\left\\{ -\\frac{\\tau}{2} "
"(\\boldsymbol{\\theta} - \\boldsymbol{\\mu}_n)^\\top \\boldsymbol{\\Lambda}_n (\\boldsymbol{\\theta} - "
"\\boldsymbol{\\mu}_n) \\right\\} \\frac{\\beta_n^{\\alpha_n}}{\\Gamma (\\alpha_n)} \\tau^{\\alpha_n - 1} \\exp \\{ -"
"\\beta_n \\tau \\} .\n"
"\n"

#: bayesml.linearregression:62 of
#, python-brace-format
msgid ""
"\\mathbb{E}[\\boldsymbol{\\theta} | \\boldsymbol{X}, \\boldsymbol{y}] &= \\boldsymbol{\\mu}_n & \\left( \\alpha_n > "
"\\frac{1}{2} \\right), \\\\\n"
"\\mathrm{Cov}[\\boldsymbol{\\theta} | \\boldsymbol{X}, \\boldsymbol{y}] &= \\frac{\\beta_n}{\\alpha_n - 1} "
"\\boldsymbol{\\Lambda}_n^{-1} & (\\alpha_n > 1), \\\\\n"
"\\mathbb{E}[\\tau | \\boldsymbol{X}, \\boldsymbol{y}] &= \\frac{\\alpha_n}{\\beta_n}, \\\\\n"
"\\mathbb{V}[\\tau | \\boldsymbol{X}, \\boldsymbol{y}] &= \\frac{\\alpha_n}{\\beta_n^2},\n"
"\n"
msgstr ""
"\\mathbb{E}[\\boldsymbol{\\theta} | \\boldsymbol{X}, \\boldsymbol{y}] &= \\boldsymbol{\\mu}_n & \\left( \\alpha_n > "
"\\frac{1}{2} \\right), \\\\\n"
"\\mathrm{Cov}[\\boldsymbol{\\theta} | \\boldsymbol{X}, \\boldsymbol{y}] &= \\frac{\\beta_n}{\\alpha_n - 1} "
"\\boldsymbol{\\Lambda}_n^{-1} & (\\alpha_n > 1), \\\\\n"
"\\mathbb{E}[\\tau | \\boldsymbol{X}, \\boldsymbol{y}] &= \\frac{\\alpha_n}{\\beta_n}, \\\\\n"
"\\mathbb{V}[\\tau | \\boldsymbol{X}, \\boldsymbol{y}] &= \\frac{\\alpha_n}{\\beta_n^2},\n"
"\n"

#: bayesml.linearregression:68 of
msgid "where the updating rules of the hyperparameters are"
msgstr "ただし、ハイパーパラメータの更新ルールは次の通りです"

#: bayesml.linearregression:70 of
#, python-brace-format
msgid ""
"\\boldsymbol{\\Lambda}_n &= \\boldsymbol{\\Lambda}_0 + \\boldsymbol{X}^\\top \\boldsymbol{X},\\\\\n"
"\\boldsymbol{\\mu}_n &= \\boldsymbol{\\Lambda}_n^{-1} (\\boldsymbol{\\Lambda}_0 \\boldsymbol{\\mu}_0 + \\boldsymbol{X}"
"^\\top \\boldsymbol{y}),\\\\\n"
"\\alpha_n &= \\alpha_0 + \\frac{n}{2},\\\\\n"
"\\beta_n &= \\beta_0 + \\frac{1}{2} \\left( -\\boldsymbol{\\mu}_n^\\top \\boldsymbol{\\Lambda}_n \\boldsymbol{\\mu}_n "
"+ \\boldsymbol{y}^\\top \\boldsymbol{y} + \\boldsymbol{\\mu}_0^\\top \\boldsymbol{\\Lambda}_0 \\boldsymbol{\\mu}_0 "
"\\right).\n"
"\n"
msgstr ""
"\\boldsymbol{\\Lambda}_n &= \\boldsymbol{\\Lambda}_0 + \\boldsymbol{X}^\\top \\boldsymbol{X},\\\\\n"
"\\boldsymbol{\\mu}_n &= \\boldsymbol{\\Lambda}_n^{-1} (\\boldsymbol{\\Lambda}_0 \\boldsymbol{\\mu}_0 + \\boldsymbol{X}"
"^\\top \\boldsymbol{y}),\\\\\n"
"\\alpha_n &= \\alpha_0 + \\frac{n}{2},\\\\\n"
"\\beta_n &= \\beta_0 + \\frac{1}{2} \\left( -\\boldsymbol{\\mu}_n^\\top \\boldsymbol{\\Lambda}_n \\boldsymbol{\\mu}_n "
"+ \\boldsymbol{y}^\\top \\boldsymbol{y} + \\boldsymbol{\\mu}_0^\\top \\boldsymbol{\\Lambda}_0 \\boldsymbol{\\mu}_0 "
"\\right).\n"
"\n"

#: bayesml.linearregression:77 of
msgid "Predictive Distribution"
msgstr "予測分布"

#: bayesml.linearregression:79 of
msgid "The predictive distribution is as follows:"
msgstr "予測分布は以下の通りです："

#: bayesml.linearregression:81 of
#, python-brace-format
msgid ":math:`\\boldsymbol{x}_{n+1}\\in \\mathbb{R}^d`: a new data point"
msgstr ":math:`\\boldsymbol{x}_{n+1}\\in \\mathbb{R}^d`: 新たなデータ点"

#: bayesml.linearregression:82 of
#, python-brace-format
msgid ":math:`y_{n+1}\\in \\mathbb{R}`: a new objective variable"
msgstr ":math:`y_{n+1}\\in \\mathbb{R}`: 新たな目的変数"

#: bayesml.linearregression:83 of
#, python-brace-format
msgid ":math:`m_\\mathrm{p}\\in \\mathbb{R}`: a parameter"
msgstr ":math:`m_\\mathrm{p} \\in \\mathbb{R}`: パラメータ"

#: bayesml.linearregression:84 of
#, python-brace-format
msgid ":math:`\\lambda_\\mathrm{p}\\in \\mathbb{R}_{>0}`: a parameter"
msgstr ":math:`\\lambda_\\mathrm{p}\\in \\mathbb{R}`: パラメータ"

#: bayesml.linearregression:85 of
#, python-brace-format
msgid ":math:`\\nu_\\mathrm{p}\\in \\mathbb{R}_{>0}`: a parameter"
msgstr ":math:`\\nu_\\mathrm{p}\\in \\mathbb{R}`: パラメータ"

#: bayesml.linearregression:87 of
msgid ""
"p(y_{n+1} | \\boldsymbol{X}, \\boldsymbol{y}, \\boldsymbol{x}_{n+1} ) &= \\mathrm{St}\\left(y_{n+1} \\mid "
"m_\\mathrm{p}, \\lambda_\\mathrm{p}, \\nu_\\mathrm{p}\\right) \\\\\n"
"&= \\frac{\\Gamma (\\nu_\\mathrm{p} / 2 + 1/2 )}{\\Gamma (\\nu_\\mathrm{p} / 2)} \\left( \\frac{\\lambda_\\mathrm{p}}"
"{\\pi \\nu_\\mathrm{p}} \\right)^{1/2} \\left( 1 + \\frac{\\lambda_\\mathrm{p} (y_{n+1} - m_\\mathrm{p})^2}"
"{\\nu_\\mathrm{p}} \\right)^{-\\nu_\\mathrm{p}/2 - 1/2},\n"
"\n"
msgstr ""
"p(y_{n+1} | \\boldsymbol{X}, \\boldsymbol{y}, \\boldsymbol{x}_{n+1} ) &= \\mathrm{St}\\left(y_{n+1} \\mid "
"m_\\mathrm{p}, \\lambda_\\mathrm{p}, \\nu_\\mathrm{p}\\right) \\\\\n"
"&= \\frac{\\Gamma (\\nu_\\mathrm{p} / 2 + 1/2 )}{\\Gamma (\\nu_\\mathrm{p} / 2)} \\left( \\frac{\\lambda_\\mathrm{p}}"
"{\\pi \\nu_\\mathrm{p}} \\right)^{1/2} \\left( 1 + \\frac{\\lambda_\\mathrm{p} (y_{n+1} - m_\\mathrm{p})^2}"
"{\\nu_\\mathrm{p}} \\right)^{-\\nu_\\mathrm{p}/2 - 1/2},\n"
"\n"

#: bayesml.linearregression:91 of
msgid ""
"\\mathbb{E}[y_{n+1} | \\boldsymbol{X}, \\boldsymbol{y}, \\boldsymbol{x}_{n+1}] &= m_\\mathrm{p} & (\\nu_\\mathrm{p} > "
"1), \\\\\n"
"\\mathbb{V}[y_{n+1} | \\boldsymbol{X}, \\boldsymbol{y}, \\boldsymbol{x}_{n+1}] &= \\frac{1}{\\lambda_\\mathrm{p}} "
"\\frac{\\nu_\\mathrm{p}}{\\nu_\\mathrm{p}-2} & (\\nu_\\mathrm{p} > 2),\n"
"\n"
msgstr ""
"\\mathbb{E}[y_{n+1} | \\boldsymbol{X}, \\boldsymbol{y}, \\boldsymbol{x}_{n+1}] &= m_\\mathrm{p} & (\\nu_\\mathrm{p} > "
"1), \\\\\n"
"\\mathbb{V}[y_{n+1} | \\boldsymbol{X}, \\boldsymbol{y}, \\boldsymbol{x}_{n+1}] &= \\frac{1}{\\lambda_\\mathrm{p}} "
"\\frac{\\nu_\\mathrm{p}}{\\nu_\\mathrm{p}-2} & (\\nu_\\mathrm{p} > 2),\n"
"\n"

#: bayesml.linearregression:95 of
msgid "where the parameters are obtained from the hyperparameters of the posterior distribution as follows."
msgstr "ここで、パラメータは事後分布のハイパーパラメータから以下のように求められます。"

#: bayesml.linearregression:97 of
msgid ""
"m_\\mathrm{p} &= \\boldsymbol{x}_{n+1}^{\\top} \\boldsymbol{\\mu}_{n}, \\\\\n"
"\\lambda_\\mathrm{p} &= \\frac{\\alpha_{n}}{\\beta_{n}}\\left(1+\\boldsymbol{x}_{n+1}^{\\top} \\boldsymbol{\\Lambda}"
"_{n} \\boldsymbol{x}_{n+1}\\right)^{-1}, \\\\\n"
"\\nu_\\mathrm{p} &= 2 \\alpha_{n}.\n"
"\n"
msgstr ""
"m_\\mathrm{p} &= \\boldsymbol{x}_{n+1}^{\\top} \\boldsymbol{\\mu}_{n}, \\\\\n"
"\\lambda_\\mathrm{p} &= \\frac{\\alpha_{n}}{\\beta_{n}}\\left(1+\\boldsymbol{x}_{n+1}^{\\top} \\boldsymbol{\\Lambda}"
"_{n} \\boldsymbol{x}_{n+1}\\right)^{-1}, \\\\\n"
"\\nu_\\mathrm{p} &= 2 \\alpha_{n}.\n"
"\n"

