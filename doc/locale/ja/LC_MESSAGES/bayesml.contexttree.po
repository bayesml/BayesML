msgstr "ベイズリスク関数の基礎となる損失関数で、デフォルトは「KL」です。この関数は「KL」および「0-1」をサポートしています。"

#: bayesml.contexttree._contexttree.LearnModel.pred_and_update:19 of
msgid "The predicted value under the given loss function."
msgstr "与えられた損失関数に基づく予測値です。"

#~ msgid "The stochastic data generative model is as follows:"
#~ msgstr ""

#~ msgid ":math:`\\mathcal{X}=\\{1,2,\\ldots,K\\}` : a space of a source symbol"
#~ msgstr ""

#~ msgid ""
#~ ":math:`x^n = x_1 x_2 \\cdots x_n "
#~ "\\in \\mathcal{X}^n~(n\\in\\mathbb{N})` : an "
#~ "source sequence"
#~ msgstr ""

#~ msgid ""
#~ ":math:`D_\\mathrm{max} \\in \\mathbb{N}` : the"
#~ " maximum depth of context tree models"
#~ msgstr ""

#~ msgid ""
#~ ":math:`T` : a context tree model, "
#~ ":math:`K`-ary regular tree whose depth "
#~ "is smaller than or equal to "
#~ ":math:`D_\\mathrm{max}`, where \"regular\" means "
#~ "that all inner nodes have :math:`K` "
#~ "child nodes"
#~ msgstr ""

#~ msgid ":math:`\\mathcal{T}` : a set of :math:`T`"
#~ msgstr ""

#~ msgid ":math:`s` : a node of a context tree model"
#~ msgstr ""

#~ msgid ":math:`\\mathcal{I}(T)` : a set of inner nodes of :math:`T`"
#~ msgstr ""

#~ msgid ":math:`\\mathcal{L}(T)` : a set of leaf nodes of :math:`T`"
#~ msgstr ""

#~ msgid ""
#~ ":math:`\\mathcal{S}(T)` : a set of all"
#~ " nodes of :math:`T`, i.e., "
#~ ":math:`\\mathcal{S}(T) = \\mathcal{I}(T) \\cup "
#~ "\\mathcal{L}(T)`"
#~ msgstr ""

#~ msgid ""
#~ ":math:`s_T(x^{n-1}) \\in \\mathcal{L}(T)` : a"
#~ " leaf node of :math:`T` corresponding "
#~ "to :math:`x^{n-1} = x_1 x_2\\cdots "
#~ "x_{n-1}`"
#~ msgstr ""

#~ msgid ""
#~ ":math:`\\boldsymbol{\\theta}_s = (\\theta_{1|s}, "
#~ "\\theta_{2|s}, \\ldots, \\theta_{K|s})` : a"
#~ " parameter on a leaf node, where "
#~ ":math:`\\theta_{k|s}` denotes the occurrence "
#~ "probability of :math:`k\\in\\mathcal{X}`"
#~ msgstr ""

#~ msgid ""
#~ "p(x_n | x^{n-1}, \\boldsymbol{\\theta}_T, "
#~ "T)=\\theta_{x_n|s_T(x^{n-1})}.\n"
#~ "\n"
#~ msgstr ""

#~ msgid "The prior distribution is as follows:"
#~ msgstr ""

#~ msgid ""
#~ ":math:`g_{0,s} \\in [0,1]` : a "
#~ "hyperparameter assigned to :math:`s \\in "
#~ "\\mathcal{S}(T)`"
#~ msgstr ""

#~ msgid ""
#~ ":math:`\\beta_0(k|s) \\in\\mathbb{R}_{>0}` : a "
#~ "hyperparameter of the Dirichlet distribution"
#~ msgstr ""

#~ msgid ""
#~ ":math:`\\boldsymbol{\\beta}_0(s) = (\\beta_0(1|s), "
#~ "\\beta_0(2|s), \\ldots, \\beta_0(K|s)) "
#~ "\\in\\mathbb{R}^{K}_{>0}`"
#~ msgstr ""

#~ msgid ""
#~ ":math:`C(\\boldsymbol{\\beta}_0(s)) = "
#~ "\\frac{\\Gamma\\left(\\sum_{k=1}^{K} "
#~ "\\beta_0(k|s)\\right)}{\\prod_{k=1}^{K} "
#~ "\\Gamma\\left(\\beta_0(k|s)\\right)}`"
#~ msgstr ""

#~ msgid ""
#~ "For :math:`\\boldsymbol{\\theta}_s` on "
#~ ":math:`s\\in\\mathcal{L}(T)`, the Dirichlet "
#~ "distribution is assumed as the prior "
#~ "distribution as follows:"
#~ msgstr ""

#~ msgid ""
#~ "p(\\boldsymbol{\\theta}_s|T) = "
#~ "\\mathrm{Dir}(\\boldsymbol{\\theta}_s|\\,\\boldsymbol{\\beta}_0(s))"
#~ " = C(\\boldsymbol{\\beta}_0(s)) \\prod_{k=1}^{K} "
#~ "\\theta_{k|s}^{\\beta_0(k|s)-1}.\n"
#~ "\n"
#~ msgstr ""

#~ msgid "For :math:`T \\in \\mathcal{T}`,"
#~ msgstr ""

#~ msgid ""
#~ "p(T)=\\prod_{s \\in \\mathcal{I}(T)} g_{0,s} "
#~ "\\prod_{s' \\in \\mathcal{L}(T)} (1-g_{0,s'}),\n"
#~ ""
#~ "\n"
#~ msgstr ""

#~ msgid ""
#~ "where :math:`g_{0,s}=0` if the depth of"
#~ " :math:`s` is :math:`D_\\mathrm{max}`."
#~ msgstr ""

#~ msgid "The posterior distribution is as follows:"
#~ msgstr ""

#~ msgid ":math:`g_{n,s} \\in [0,1]` : the updated hyperparameter"
#~ msgstr ""

#~ msgid ""
#~ ":math:`T_\\mathrm{max}` : a superposed context"
#~ " tree, :math:`K`-ary perfect tree whose "
#~ "depth is :math:`D_\\mathrm{max}`"
#~ msgstr ""

#~ msgid ":math:`s_\\lambda` : the root node"
#~ msgstr ""

#~ msgid ""
#~ ":math:`\\beta_n(k|s) \\in\\mathbb{R}_{>0}` : a "
#~ "hyperparameter of the posterior Dirichlet "
#~ "distribution"
#~ msgstr ""

#~ msgid ""
#~ ":math:`\\boldsymbol{\\beta}_n(s) = (\\beta_n(1|s), "
#~ "\\beta_n(2|s), \\ldots, \\beta_n(K|s)) "
#~ "\\in\\mathbb{R}^{K}_{>0}`"
#~ msgstr ""

#~ msgid ":math:`I \\{ \\cdot \\}`: the indicator function"
#~ msgstr ""

#~ msgid "For :math:`\\boldsymbol{\\theta}_s \\in\\mathcal{L}(T_\\mathrm{max})`,"
#~ msgstr ""

#~ msgid ""
#~ "p(\\boldsymbol{\\theta}_s|x^n) = "
#~ "\\mathrm{Dir}(\\boldsymbol{\\theta}_s|\\,\\boldsymbol{\\beta}_n(s))"
#~ " = C(\\boldsymbol{\\beta}_n(s)) \\prod_{k=1}^{K} "
#~ "\\theta_{k|s}^{\\beta_n(k|s)-1},\n"
#~ "\n"
#~ msgstr ""

#~ msgid "where the updating rule of the hyperparameter is as follows:"
#~ msgstr ""

#~ msgid ""
#~ "\\beta_n(k|s) = \\beta_0(k|s) + \\sum_{i=1}^n"
#~ " I \\left\\{ s \\ \\mathrm{is \\ "
#~ "the \\ ancestor \\ of} \\ "
#~ "s_{T_\\mathrm{max}}(x^{i-1}) \\ \\mathrm{and} \\ "
#~ "x_i=k \\right\\}.\n"
#~ "\n"
#~ msgstr ""

#~ msgid ""
#~ "p(T|x^{n-1})=\\prod_{s \\in \\mathcal{I}(T)} g_{n,s}"
#~ " \\prod_{s' \\in \\mathcal{L}(T)} (1-g_{n,s'}),"
#~ "\n"
#~ "\n"
#~ msgstr ""

#~ msgid "where the updating rules of the hyperparameter are as follows:"
#~ msgstr ""

#~ msgid ""
#~ "g_{n,s} =\n"
#~ "\\begin{cases}\n"
#~ "    g_{0,s}, & n=0, \\\\\n"
#~ "    \\frac{ g_{n-1,s} "
#~ "\\tilde{q}_{s_{\\mathrm{child}}} (x_n|x^{n-1}) }\n"
#~ "    { \\tilde{q}_s(x_n|x^{n-1}) } & \\mathrm{otherwise},\n"
#~ "\\end{cases}\n"
#~ "\n"
#~ msgstr ""

#~ msgid ""
#~ "where :math:`s_{\\mathrm{child}}` is the child"
#~ " node of :math:`s` on the path "
#~ "from :math:`s_\\lambda` to "
#~ ":math:`s_{T_\\mathrm{max}}(x^n)` and"
#~ msgstr ""

#~ msgid ""
#~ "\\tilde{q}_s(x_n|x^{n-1}) =\n"
#~ "\\begin{cases}\n"
#~ "    q_s(x_n|x^{n-1}) & s\\in\\mathcal{L}(T_\\mathrm{max}), \\\\\n"
#~ "    (1-g_{n-1,s}) q_s(x_n|x^{n-1}) + g_{n-1,s}"
#~ " \\tilde{q}_{s_{\\mathrm{child}}}(x_n|x^{n-1}) & "
#~ "\\mathrm{otherwise}.\n"
#~ "\\end{cases}\n"
#~ "\n"
#~ msgstr ""

#~ msgid "Here,"
#~ msgstr ""

#~ msgid ""
#~ "q_s(x_n|x^{n-1}) = \\frac{ \\beta_{n-1}(x_n|s) }\n"
#~ "{\\sum_{k'=1}^{K} \\beta_{n-1}(k'|s)}.\n"
#~ "\n"
#~ msgstr ""

#~ msgid "The predictive distribution is as follows:"
#~ msgstr ""

#~ msgid ""
#~ ":math:`\\boldsymbol{\\theta}_\\mathrm{p} = "
#~ "(\\theta_{\\mathrm{p},1}, \\theta_{\\mathrm{p},2}, "
#~ "\\ldots, \\theta_{\\mathrm{p},K})` : a "
#~ "parameter of the predictive distribution, "
#~ "where :math:`\\theta_{\\mathrm{p},k}` denotes the"
#~ " occurrence probability of "
#~ ":math:`k\\in\\mathcal{X}`."
#~ msgstr ""

#~ msgid ""
#~ "p(x_n|x^{n-1}) = \\theta_{\\mathrm{p},x_n},\n"
#~ "\n"
#~ msgstr ""

#~ msgid ""
#~ "where the updating rule of the "
#~ "parameters of the pridictive distribution "
#~ "is as follows."
#~ msgstr ""

#~ msgid ""
#~ "\\theta_{\\mathrm{p}, k} = \\tilde{q}_{s_\\lambda}(k|x^{n-1})\n"
#~ "\n"
#~ msgstr ""

