#: ../../bayesml.poisson.rst:5
msgid "Module contents"
msgstr "モジュール内容"

#: bayesml.poisson:1 of
msgid ""
"This module provides the Poisson distribution with the gamma prior distribution."
msgstr "このモジュールではガンマ事前分布を用いたポアソン分布を利用できます。"

#: bayesml.poisson:6 of
msgid "Stochastic Data Generative Model"
msgstr "確率的データ生成モデル"

#: bayesml.poisson:8 of
msgid "The stochastic data generative model is as follows:"
msgstr "確率的データ生成モデルは以下の通りです："

#: bayesml.poisson:10 of
#, python-brace-format
msgid ":math:`x \\in \\mathbb{N}`: a data point"
msgstr ":math:`x \\in \\mathbb{N}`: データ点"

#: bayesml.poisson:11 of
#, python-brace-format
msgid ":math:`\\lambda \\in \\mathbb{R}_{>0}`: a parameter"
msgstr ":math:`\\lambda \\in \\mathbb{R}_{>0}`: パラメータ"

#: bayesml.poisson:13 of
msgid ""
"p(x | \\lambda) = \\mathrm{Po}(x|\\lambda) = \\frac{ \\lambda^{x} }{x!}\\exp \\"
"{ -\\lambda \\}.\n"
"\n"
msgstr ""
"p(x | \\lambda) = \\mathrm{Po}(x|\\lambda) = \\frac{ \\lambda^{x} }{x!}\\exp \\"
"{ -\\lambda \\}.\n"
"\n"

#: bayesml.poisson:17 of
msgid "Prior Distribution"
msgstr "事前分布"

#: bayesml.poisson:19 of
msgid "The prior distribution is as follows:"
msgstr "事前分布は以下の通りです："

#: bayesml.poisson:21 of
#, python-brace-format
msgid ":math:`\\alpha_0 \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\alpha_0 \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.poisson:22 of
#, python-brace-format
msgid ":math:`\\beta_0 \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\beta_0 \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.poisson:23 of
#, python-brace-format
msgid ""
":math:`\\Gamma(\\cdot): \\mathbb{R}_{>0} \\to \\mathbb{R}_{>0}`: the Gamma "
"function"
msgstr ""
":math:`\\Gamma(\\cdot): \\mathbb{R}_{>0} \\to \\mathbb{R}_{>0}`: ガンマ関数"

#: bayesml.poisson:25 of
msgid ""
"p(\\lambda) = \\mathrm{Gam}(\\lambda|\\alpha_0,\\beta_0) = "
"\\frac{\\beta_0^{\\alpha_0}}{\\Gamma (\\alpha_0)} \\lambda^{\\alpha_0 - 1} "
"\\exp \\{ -\\beta_0 \\lambda \\},\n"
"\n"
msgstr ""
"p(\\lambda) = \\mathrm{Gam}(\\lambda|\\alpha_0,\\beta_0) = "
"\\frac{\\beta_0^{\\alpha_0}}{\\Gamma (\\alpha_0)} \\lambda^{\\alpha_0 - 1} "
"\\exp \\{ -\\beta_0 \\lambda \\},\n"
"\n"

#: bayesml.poisson:28 of
#, python-brace-format
msgid ""
"\\mathbb{E}[\\lambda] &= \\frac{\\alpha_0}{\\beta_0}, \\\\\n"
"\\mathbb{V}[\\lambda] &= \\frac{\\alpha_0}{\\beta_0^2}.\n"
"\n"
msgstr ""
"\\mathbb{E}[\\lambda] &= \\frac{\\alpha_0}{\\beta_0}, \\\\\n"
"\\mathbb{V}[\\lambda] &= \\frac{\\alpha_0}{\\beta_0^2}.\n"
"\n"

#: bayesml.poisson:33 of
msgid "Posterior Distribution"
msgstr "事後分布"

#: bayesml.poisson:35 of
msgid "The posterior distribution is as follows:"
msgstr "事後分布は以下の通りです："

#: bayesml.poisson:37 of
#, python-brace-format
msgid ":math:`x^n = (x_1, x_2, \\dots , x_n) \\in \\mathbb{N}^n`: given data"
msgstr ""
":math:`x^n = (x_1, x_2, \\dots , x_n) \\in \\mathbb{N}^n`: 与えられたデータ"

#: bayesml.poisson:38 of
#, python-brace-format
msgid ":math:`\\alpha_n \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\alpha_n \\in \\mathbb{R}_{>0}`:ハイパーパラメータ"

#: bayesml.poisson:39 of
#, python-brace-format
msgid ":math:`\\beta_n \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\beta_n \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.poisson:41 of
msgid ""
"p(\\lambda | x^n) = \\mathrm{Gam}(\\lambda|\\alpha_n,\\beta_n) = "
"\\frac{\\beta_n^{\\alpha_n}}{\\Gamma (\\alpha_n)} \\lambda^{\\alpha_n - 1} "
"\\exp \\{ -\\beta_n \\lambda \\},\n"
"\n"
msgstr ""
"p(\\lambda | x^n) = \\mathrm{Gam}(\\lambda|\\alpha_n,\\beta_n) = "
"\\frac{\\beta_n^{\\alpha_n}}{\\Gamma (\\alpha_n)} \\lambda^{\\alpha_n - 1} "
"\\exp \\{ -\\beta_n \\lambda \\},\n"
"\n"

#: bayesml.poisson:44 of
#, python-brace-format
msgid ""
"\\mathbb{E}[\\lambda | x^n] &= \\frac{\\alpha_n}{\\beta_n}, \\\\\n"
"\\mathbb{V}[\\lambda | x^n] &= \\frac{\\alpha_n}{\\beta_n^2},\n"
"\n"
msgstr ""
"\\mathbb{E}[\\lambda | x^n] &= \\frac{\\alpha_n}{\\beta_n}, \\\\\n"
"\\mathbb{V}[\\lambda | x^n] &= \\frac{\\alpha_n}{\\beta_n^2},\n"
"\n"

#: bayesml.poisson:48 of
msgid "where the updating rule of the hyperparameters is"
msgstr "ここでハイパーパラメータの更新式は以下で与えられます"

#: bayesml.poisson:50 of
#, python-brace-format
msgid ""
"\\alpha_n &= \\alpha_0 + \\sum_{i=1}^n x_i,\\\\\n"
"\\beta_n &= \\beta_0 + n.\n"
"\n"
msgstr ""
"\\alpha_n &= \\alpha_0 + \\sum_{i=1}^n x_i,\\\\\n"
"\\beta_n &= \\beta_0 + n.\n"
"\n"

#: bayesml.poisson:55 of
msgid "Predictive Distribution"
msgstr "予測分布"

#: bayesml.poisson:57 of
msgid "The predictive distribution is as follows:"
msgstr "予測分布は以下の通りです："

#: bayesml.poisson:59 of
#, python-brace-format
msgid ":math:`x_{n+1} \\in \\mathbb{N}`: a new data point"
msgstr ":math:`x_{n+1} \\in \\mathbb{N}`: 新たなデータ点"

#: bayesml.poisson:60 of
#, python-brace-format
msgid ""
":math:`\\theta_\\mathrm{p} \\in \\mathbb{R}_{>0}, 0<\\theta_\\mathrm{p}<1`: the "
"hyperparameter of the posterior"
msgstr ""
":math:`\\theta_\\mathrm{p} \\in \\mathbb{R}_{>0}, 0<\\theta_\\mathrm{p}<1`: 事後"
"分布のハイパーパラメータ"

#: bayesml.poisson:61 of
#, python-brace-format
msgid ""
":math:`r_\\mathrm{p} \\in \\mathbb{N}`: the hyperparameter of the posterior"
msgstr ":math:`r_\\mathrm{p} \\in \\mathbb{N}`: 事後分布のハイパーパラメータ"

#: bayesml.poisson:63 of
msgid ""
"\\mathrm{NB}(x_{n+1}|r_\\mathrm{p},\\theta_\\mathrm{p}) = "
"\\frac{\\Gamma(x_{n+1}+r_\\mathrm{p})}{\\Gamma(x_{n+1}+1)\\Gamma(r_\\mathrm{p})}"
"\\theta_\\mathrm{p}^{x_{n+1}}(1-\\theta_\\mathrm{p})^{r_\\mathrm{p}},\n"
"\n"
msgstr ""
"\\mathrm{NB}(x_{n+1}|r_\\mathrm{p},\\theta_\\mathrm{p}) = "
"\\frac{\\Gamma(x_{n+1}+r_\\mathrm{p})}{\\Gamma(x_{n+1}+1)\\Gamma(r_\\mathrm{p})}"
"\\theta_\\mathrm{p}^{x_{n+1}}(1-\\theta_\\mathrm{p})^{r_\\mathrm{p}},\n"
"\n"

#: bayesml.poisson:66 of
msgid ""
"\\mathbb{E}[x_{n+1} | x^n] &= \\frac{r_\\mathrm{p} \\theta_\\mathrm{p}}{1 - "
"\\theta_\\mathrm{p}}, \\\\\n"
"\\mathbb{V}[x_{n+1} | x^n] &= \\frac{r_\\mathrm{p} \\theta_\\mathrm{p}}{(1 - "
"\\theta_\\mathrm{p})^2},\n"
"\n"
msgstr ""
"\\mathbb{E}[x_{n+1} | x^n] &= \\frac{r_\\mathrm{p} \\theta_\\mathrm{p}}{1 - "
"\\theta_\\mathrm{p}}, \\\\\n"
"\\mathbb{V}[x_{n+1} | x^n] &= \\frac{r_\\mathrm{p} \\theta_\\mathrm{p}}{(1 - "
"\\theta_\\mathrm{p})^2},\n"
"\n"

#: bayesml.poisson:70 of
msgid ""
"where the parameters are obtained from the hyperparameters of the posterior "
"distribution as follows:"
msgstr ""
"ここで、パラメータは事後分布のハイパーパラメータから以下のように求められます:"

#: bayesml.poisson:72 of
#, python-brace-format
msgid ""
"&r_\\mathrm{p}=\\alpha_n, \\\\\n"
"&\\theta_\\mathrm{p} = \\frac{1}{\\beta_n + 1}.\n"
"\n"
msgstr ""
"&r_\\mathrm{p}=\\alpha_n, \\\\\n"
"&\\theta_\\mathrm{p} = \\frac{1}{\\beta_n + 1}.\n"
"\n"

