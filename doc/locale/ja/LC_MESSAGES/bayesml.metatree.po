#~ msgid "Parameters"
#~ msgstr ""

#~ msgid "**c_dim_continuous**"
#~ msgstr ""

#~ msgid "int"
#~ msgstr ""

#~ msgid "A non-negative integer"
#~ msgstr ""

#~ msgid "**c_dim_categorical**"
#~ msgstr ""

#~ msgid "**c_num_children_vec**"
#~ msgstr ""

#~ msgid "numpy.ndarray, optional"
#~ msgstr ""

#~ msgid ""
#~ "A vector of positive integers whose "
#~ "length is  ``c_dim_continuous+c_dim_categorical``, "
#~ "by default [2,2,...,2]. The first "
#~ "``c_dim_continuous`` elements represent  the "
#~ "numbers of children of continuous "
#~ "features at  inner nodes. The other "
#~ "``c_dim_categorial`` elements  represent those "
#~ "of categorical features. If a single "
#~ "integer is input, it will be "
#~ "broadcasted."
#~ msgstr ""

#~ msgid "**c_max_depth**"
#~ msgstr ""

#~ msgid "int, optional"
#~ msgstr ""

#~ msgid "A positive integer, by default 2"
#~ msgstr ""

#~ msgid "**c_num_assignment_vec**"
#~ msgstr ""

#~ msgid ""
#~ "A vector of positive integers whose "
#~ "length is  ``c_dim_continuous+c_dim_categorical``.  "
#~ "The first ``c_dim_continuous`` elements "
#~ "represent  the maximum assignment numbers "
#~ "of continuous features  on a path. "
#~ "The other ``c_dim_categorial`` elements  "
#~ "represent those of categorical features. "
#~ "If it  has a negative element "
#~ "(e.g., -1), the corresponding  feature "
#~ "will be assigned any number of "
#~ "times.  By default [-1,...,-1]."
#~ msgstr ""

#~ msgid "**c_ranges**"
#~ msgstr ""

#~ msgid ""
#~ "A numpy.ndarray whose size is "
#~ "(c_dim_continuous,2). A threshold for the "
#~ "``k``-th continuous feature will be  "
#~ "generated between ``c_ranges[k,0]`` and "
#~ "``c_ranges[k,1]``.  By default, "
#~ "[[-3,3],[-3,3],...,[-3,3]]."
#~ msgstr ""

#~ msgid "**SubModel**"
#~ msgstr ""

#~ msgid "class, optional"
#~ msgstr ""

#~ msgid ""
#~ "bernoulli, categorical, poisson, normal, "
#~ "exponential,  or linearregression, by default"
#~ " bernoulli"
#~ msgstr ""

#~ msgid "**sub_constants**"
#~ msgstr ""

#~ msgid "dict, optional"
#~ msgstr ""

#~ msgid "constants for self.SubModel.GenModel, by default {}"
#~ msgstr ""

#~ msgid "**root**"
#~ msgstr ""

#~ msgid "metatree._Node, optional"
#~ msgstr ""

#~ msgid ""
#~ "A root node of a meta-tree,  "
#~ "by default a tree consists of only"
#~ " one node."
#~ msgstr ""

#~ msgid "**h_k_weight_vec**"
#~ msgstr ""

#~ msgid ""
#~ "A vector of positive real numbers "
#~ "whose length is  "
#~ "``c_dim_continuous+c_dim_categorical``,  by default "
#~ "[1,...,1]."
#~ msgstr ""

#~ msgid "**h_g**"
#~ msgstr ""

#~ msgid "float, optional"
#~ msgstr ""

#~ msgid "A real number in :math:`[0, 1]`, by default 0.5"
#~ msgstr ""

#~ msgid "**sub_h_params**"
#~ msgstr ""

#~ msgid "h_params for self.SubModel.GenModel, by default {}"
#~ msgstr ""

#~ msgid "**h_metatree_list**"
#~ msgstr ""

#~ msgid "list of metatree._Node, optional"
#~ msgstr ""

#~ msgid "Root nodes of meta-trees, by default []"
#~ msgstr ""

#~ msgid "**h_metatree_prob_vec**"
#~ msgstr ""

#~ msgid ""
#~ "A vector of real numbers in "
#~ ":math:`[0, 1]`  that represents prior "
#~ "distribution of h_metatree_list,  by default"
#~ " uniform distribution Sum of its "
#~ "elements must be 1.0."
#~ msgstr ""

