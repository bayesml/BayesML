#: ../../bayesml.autoregressive.rst:2
msgid "bayesml.autoregressive package"
msgstr "bayesml.autoregressive package"

#: ../../bayesml.autoregressive.rst:5
msgid "Module contents"
msgstr "モジュール内容"

#: bayesml.autoregressive:1 of
msgid "This module provides the linear autoregressive model with the normal-gamma prior distribution."
msgstr "このモジュールでは正規ガンマ事前分布を用いた線形自己回帰モデルを利用できます。"

#: bayesml.autoregressive:6 of
msgid "Stochastic Data Generative Model"
msgstr "確率的データ生成モデル"

#: bayesml.autoregressive:8 of
msgid "The stochastic data generative model is as follows:"
msgstr "確率的データ生成モデルは以下の通りです："

#: bayesml.autoregressive:10 of
#, python-brace-format
msgid ":math:`d \\in \\mathbb{N}`: the degree of the model"
msgstr ":math:`d \\in \\mathbb{N}`: モデルの次数"

#: bayesml.autoregressive:11 of
#, python-brace-format
msgid ":math:`n \\in \\mathbb{N}`: time index"
msgstr ":math:`n \\in \\mathbb{N}`: 時間インデックス"

#: bayesml.autoregressive:12 of
#, python-brace-format
msgid ":math:`x_n \\in \\mathbb{R}`: a data point at :math:`n`"
msgstr ":math:`x_n \\in \\mathbb{R}`: 時点 :math:`n` におけるデータ点"

#: bayesml.autoregressive:13 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{x}'_n := [1, x_{n-d}, x_{n-d+1}, \\dots , x_{n-1}]^\\top \\in \\mathbb{R}^{d+1}`. Here we assume :math:`x_n` "
"for :math:`n < 1` is given as a initial value."
msgstr ""
":math:`\\boldsymbol{x}'_n := [1, x_{n-d}, x_{n-d+1}, \\dots , x_{n-1}]^\\top \\in \\mathbb{R}^{d+1}`。ここで、:math:`n < 1` に対す"
"る :math:`x_n` は初期値として与えられているものと仮定します。"

#: bayesml.autoregressive:14 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\theta} \\in \\mathbb{R}^{d+1}`: a regression coefficient parameter"
msgstr ":math:`\\boldsymbol{\\theta} \\in \\mathbb{R}^{d+1}`: 回帰係数パラメータ"

#: bayesml.autoregressive:15 of
#, python-brace-format
msgid ":math:`\\tau \\in \\mathbb{R}_{>0}`: a precision parameter of noise"
msgstr ":math:`\\tau \\in \\mathbb{R}_{>0}`: ノイズの精度パラメータ"

#: bayesml.autoregressive:17 of
msgid ""
"p(x_n | \\boldsymbol{x}'_{n-1}, \\boldsymbol{\\theta}, \\tau) &= \\mathcal{N}(x_n|\\boldsymbol{\\theta}^\\top "
"\\boldsymbol{x}'_{n-1}, \\tau^{-1}) \\\\\n"
"&= \\sqrt{\\frac{\\tau}{2 \\pi}} \\exp \\left\\{ -\\frac{\\tau}{2} (x_n - \\boldsymbol{\\theta}^\\top \\boldsymbol{x}'_{n-1})^2 "
"\\right\\}.\n"
"\n"
msgstr ""
"p(x_n | \\boldsymbol{x}'_{n-1}, \\boldsymbol{\\theta}, \\tau) &= \\mathcal{N}(x_n|\\boldsymbol{\\theta}^\\top "
"\\boldsymbol{x}'_{n-1}, \\tau^{-1}) \\\\\n"
"&= \\sqrt{\\frac{\\tau}{2 \\pi}} \\exp \\left\\{ -\\frac{\\tau}{2} (x_n - \\boldsymbol{\\theta}^\\top \\boldsymbol{x}'_{n-1})^2 "
"\\right\\}.\n"
"\n"

#: bayesml.autoregressive:21 of
#, python-brace-format
msgid ""
"&\\mathbb{E}[ x_n | \\boldsymbol{x}'_{n-1},\\boldsymbol{\\theta},\\tau] = \\boldsymbol{\\theta}^{\\top} \\boldsymbol{x}'_{n-1}, \\"
"\\\n"
"&\\mathbb{V}[ x_n | \\boldsymbol{x}'_{n-1},\\boldsymbol{\\theta},\\tau ] = \\tau^{-1}.\n"
"\n"
msgstr ""
"&\\mathbb{E}[ x_n | \\boldsymbol{x}'_{n-1},\\boldsymbol{\\theta},\\tau] = \\boldsymbol{\\theta}^{\\top} \\boldsymbol{x}'_{n-1}, \\"
"\\\n"
"&\\mathbb{V}[ x_n | \\boldsymbol{x}'_{n-1},\\boldsymbol{\\theta},\\tau ] = \\tau^{-1}.\n"
"\n"

#: bayesml.autoregressive:26 of
msgid "Prior Distribution"
msgstr "事前分布"

#: bayesml.autoregressive:28 of
msgid "The prior distribution is as follows:"
msgstr "事前分布は以下の通りです："

#: bayesml.autoregressive:30 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\mu}_0 \\in \\mathbb{R}^{d+1}`: a hyperparameter for :math:`\\boldsymbol{\\theta}`"
msgstr ":math:`\\boldsymbol{\\mu}_0 \\in \\mathbb{R}^{d+1}`: :math:`\\boldsymbol{\\theta}` のハイパーパラメータ"

#: bayesml.autoregressive:31 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{\\Lambda}_0 \\in \\mathbb{R}^{(d+1) \\times (d+1)}`: a hyperparameter for :math:`\\boldsymbol{\\theta}` (a "
"positive definite matrix)"
msgstr ""
":math:`\\boldsymbol{\\Lambda}_0 \\in \\mathbb{R}^{(d+1) \\times (d+1)}`: :math:`\\boldsymbol{\\theta}` のハイパーパラメータ（正定値"
"行列）"

#: bayesml.autoregressive:32 of
#, python-brace-format
msgid ":math:`| \\boldsymbol{\\Lambda}_0 | \\in \\mathbb{R}`: the determinant of :math:`\\boldsymbol{\\Lambda}_0`"
msgstr ":math:`| \\boldsymbol{\\Lambda}_0 | \\in \\mathbb{R}`: :math:`\\boldsymbol{\\Lambda}_0` の行列式"

#: bayesml.autoregressive:33 of
#, python-brace-format
msgid ":math:`\\alpha_0 \\in \\mathbb{R}_{>0}`: a hyperparameter for :math:`\\tau`"
msgstr ":math:`\\alpha_0 \\in \\mathbb{R}_{>0}`: :math:`\\tau` のハイパーパラメータ"

#: bayesml.autoregressive:34 of
#, python-brace-format
msgid ":math:`\\beta_0 \\in \\mathbb{R}_{>0}`: a hyperparameter for :math:`\\tau`"
msgstr ":math:`\\beta_0 \\in \\mathbb{R}_{>0}`: :math:`\\tau` のハイパーパラメータ"

#: bayesml.autoregressive:35 of
#, python-brace-format
msgid ":math:`\\Gamma(\\cdot): \\mathbb{R}_{>0} \\to \\mathbb{R}`: the Gamma function"
msgstr ":math:`\\Gamma(\\cdot): \\mathbb{R}_{>0} \\to \\mathbb{R}`: ガンマ関数"

#: bayesml.autoregressive:37 of
msgid ""
"p(\\boldsymbol{\\theta}, \\tau) &= \\mathcal{N}(\\boldsymbol{\\theta}|\\boldsymbol{\\mu}_0, (\\tau \\boldsymbol{\\Lambda}_0)^{-1}) "
"\\mathrm{Gam}(\\tau|\\alpha_0,\\beta_0)\\\\\n"
"&= \\frac{|\\tau \\boldsymbol{\\Lambda}_0|^{1/2}}{(2 \\pi)^{(d+1)/2}} \n"
"\\exp \\left\\{ -\\frac{\\tau}{2} (\\boldsymbol{\\theta} - \\boldsymbol{\\mu}_0)^\\top \n"
"\\boldsymbol{\\Lambda}_0 (\\boldsymbol{\\theta} - \\boldsymbol{\\mu}_0) \\right\\}\n"
"\\frac{\\beta_0^{\\alpha_0}}{\\Gamma (\\alpha_0)} \\tau^{\\alpha_0 - 1} \\exp \\{ -\\beta_0 \\tau \\} .\n"
"\n"
msgstr ""
"p(\\boldsymbol{\\theta}, \\tau) &= \\mathcal{N}(\\boldsymbol{\\theta}|\\boldsymbol{\\mu}_0, (\\tau \\boldsymbol{\\Lambda}_0)^{-1}) "
"\\mathrm{Gam}(\\tau|\\alpha_0,\\beta_0)\\\\\n"
"&= \\frac{|\\tau \\boldsymbol{\\Lambda}_0|^{1/2}}{(2 \\pi)^{(d+1)/2}} \n"
"\\exp \\left\\{ -\\frac{\\tau}{2} (\\boldsymbol{\\theta} - \\boldsymbol{\\mu}_0)^\\top \n"
"\\boldsymbol{\\Lambda}_0 (\\boldsymbol{\\theta} - \\boldsymbol{\\mu}_0) \\right\\}\n"
"\\frac{\\beta_0^{\\alpha_0}}{\\Gamma (\\alpha_0)} \\tau^{\\alpha_0 - 1} \\exp \\{ -\\beta_0 \\tau \\} .\n"
"\n"

#: bayesml.autoregressive:44 of
#, python-brace-format
msgid ""
"\\mathbb{E}[\\boldsymbol{\\theta}] &= \\boldsymbol{\\mu}_0 & \\left( \\alpha_0 > \\frac{1}{2} \\right), \\\\\n"
"\\mathrm{Cov}[\\boldsymbol{\\theta}] &= \\frac{\\beta_0}{\\alpha_0 - 1} \\boldsymbol{\\Lambda}_0^{-1} & (\\alpha_0 > 1), \\\\\n"
"\\mathbb{E}[\\tau] &= \\frac{\\alpha_0}{\\beta_0}, \\\\\n"
"\\mathbb{V}[\\tau] &= \\frac{\\alpha_0}{\\beta_0^2}.\n"
"\n"
msgstr ""
"\\mathbb{E}[\\boldsymbol{\\theta}] &= \\boldsymbol{\\mu}_0 & \\left( \\alpha_0 > \\frac{1}{2} \\right), \\\\\n"
"\\mathrm{Cov}[\\boldsymbol{\\theta}] &= \\frac{\\beta_0}{\\alpha_0 - 1} \\boldsymbol{\\Lambda}_0^{-1} & (\\alpha_0 > 1), \\\\\n"
"\\mathbb{E}[\\tau] &= \\frac{\\alpha_0}{\\beta_0}, \\\\\n"
"\\mathbb{V}[\\tau] &= \\frac{\\alpha_0}{\\beta_0^2}.\n"
"\n"

#: bayesml.autoregressive:51 of
msgid "Posterior Distribution"
msgstr "事後分布"

#: bayesml.autoregressive:53 of
msgid "The posterior distribution is as follows:"
msgstr "事後分布は以下の通りです："

#: bayesml.autoregressive:55 of
#, python-brace-format
msgid ":math:`x^n := [x_1, x_2, \\dots , x_n]^\\top \\in \\mathbb{R}^n`: given data"
msgstr ":math:`x^n := [x_1, x_2, \\dots , x_n]^\\top \\in \\mathbb{R}^n`: 与えられたデータ"

#: bayesml.autoregressive:56 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{X}_n = [\\boldsymbol{x}'_1, \\boldsymbol{x}'_2, \\dots , \\boldsymbol{x}'_n]^\\top \\in \\mathbb{R}^{n \\times "
"(d+1)}`"
msgstr ""
":math:`\\boldsymbol{X}_n = [\\boldsymbol{x}'_1, \\boldsymbol{x}'_2, \\dots , \\boldsymbol{x}'_n]^\\top \\in \\mathbb{R}^{n \\times "
"(d+1)}`"

#: bayesml.autoregressive:57 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\mu}_n \\in \\mathbb{R}^{d+1}`: a hyperparameter for :math:`\\boldsymbol{\\theta}`"
msgstr ":math:`\\boldsymbol{\\mu}_n \\in \\mathbb{R}^{d+1}`: :math:`\\boldsymbol{\\theta}` のハイパーパラメータ"

#: bayesml.autoregressive:58 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{\\Lambda}_n \\in \\mathbb{R}^{(d+1) \\times (d+1)}`: a hyperparameter for :math:`\\boldsymbol{\\theta}` (a "
"positive definite matrix)"
msgstr ""
":math:`\\boldsymbol{\\Lambda}_n \\in \\mathbb{R}^{(d+1) \\times (d+1)}`: :math:`\\boldsymbol{\\theta}` のハイパーパラメータ（正定値"
"行列）"

#: bayesml.autoregressive:59 of
#, python-brace-format
msgid ":math:`\\alpha_n \\in \\mathbb{R}_{>0}`: a hyperparameter for :math:`\\tau`"
msgstr ":math:`\\alpha_n \\in \\mathbb{R}_{>0}`: :math:`\\tau` のハイパーパラメータ"

#: bayesml.autoregressive:60 of
#, python-brace-format
msgid ":math:`\\beta_n \\in \\mathbb{R}_{>0}`: a hyperparameter for :math:`\\tau`"
msgstr ":math:`\\beta_n \\in \\mathbb{R}_{>0}`: :math:`\\tau` のハイパーパラメータ"

#: bayesml.autoregressive:62 of
msgid ""
"p(\\boldsymbol{\\theta}, \\tau | x^n) &= \\mathcal{N}(\\boldsymbol{\\theta}|\\boldsymbol{\\mu}_n, (\\tau \\boldsymbol{\\Lambda}"
"_n)^{-1}) \\mathrm{Gam}(\\tau|\\alpha_n,\\beta_n)\\\\\n"
"&= \\frac{|\\boldsymbol{\\tau \\Lambda}_n|^{1/2}}{(2 \\pi)^{(d+1)/2}}\n"
"\\exp \\left\\{ -\\frac{\\tau}{2} (\\boldsymbol{\\theta} - \\boldsymbol{\\mu}_n)^\\top \n"
"\\boldsymbol{\\Lambda}_n (\\boldsymbol{\\theta} - \\boldsymbol{\\mu}_n) \\right\\}\n"
"\\frac{\\beta_n^{\\alpha_n}}{\\Gamma (\\alpha_n)} \\tau^{\\alpha_n - 1} \\exp \\{ -\\beta_n \\tau \\} .\n"
"\n"
msgstr ""
"p(\\boldsymbol{\\theta}, \\tau | x^n) &= \\mathcal{N}(\\boldsymbol{\\theta}|\\boldsymbol{\\mu}_n, (\\tau \\boldsymbol{\\Lambda}"
"_n)^{-1}) \\mathrm{Gam}(\\tau|\\alpha_n,\\beta_n)\\\\\n"
"&= \\frac{|\\boldsymbol{\\tau \\Lambda}_n|^{1/2}}{(2 \\pi)^{(d+1)/2}}\n"
"\\exp \\left\\{ -\\frac{\\tau}{2} (\\boldsymbol{\\theta} - \\boldsymbol{\\mu}_n)^\\top \n"
"\\boldsymbol{\\Lambda}_n (\\boldsymbol{\\theta} - \\boldsymbol{\\mu}_n) \\right\\}\n"
"\\frac{\\beta_n^{\\alpha_n}}{\\Gamma (\\alpha_n)} \\tau^{\\alpha_n - 1} \\exp \\{ -\\beta_n \\tau \\} .\n"
"\n"

#: bayesml.autoregressive:69 of
#, python-brace-format
msgid ""
"\\mathbb{E}[\\boldsymbol{\\theta} | x^n] &= \\boldsymbol{\\mu}_n & \\left( \\alpha_n > \\frac{1}{2} \\right), \\\\\n"
"\\mathrm{Cov}[\\boldsymbol{\\theta} | x^n] &= \\frac{\\beta_n}{\\alpha_n - 1} \\boldsymbol{\\Lambda}_n^{-1} & (\\alpha_n > 1), \\"
"\\\n"
"\\mathbb{E}[\\tau | x^n] &= \\frac{\\alpha_n}{\\beta_n}, \\\\\n"
"\\mathbb{V}[\\tau | x^n] &= \\frac{\\alpha_n}{\\beta_n^2},\n"
"\n"
msgstr ""
"\\mathbb{E}[\\boldsymbol{\\theta} | x^n] &= \\boldsymbol{\\mu}_n & \\left( \\alpha_n > \\frac{1}{2} \\right), \\\\\n"
"\\mathrm{Cov}[\\boldsymbol{\\theta} | x^n] &= \\frac{\\beta_n}{\\alpha_n - 1} \\boldsymbol{\\Lambda}_n^{-1} & (\\alpha_n > 1), \\"
"\\\n"
"\\mathbb{E}[\\tau | x^n] &= \\frac{\\alpha_n}{\\beta_n}, \\\\\n"
"\\mathbb{V}[\\tau | x^n] &= \\frac{\\alpha_n}{\\beta_n^2},\n"
"\n"

#: bayesml.autoregressive:75 of
msgid "where the updating rules of the hyperparameters are"
msgstr "ただし、ハイパーパラメータの更新ルールは次の通りです"

#: bayesml.autoregressive:77 of
#, python-brace-format
msgid ""
"\\boldsymbol{\\Lambda}_n &= \\boldsymbol{\\Lambda}_0 + \\boldsymbol{X}_n^\\top \\boldsymbol{X}_n,\\\\\n"
"\\boldsymbol{\\mu}_n &= \\boldsymbol{\\Lambda}_n^{-1} (\\boldsymbol{\\Lambda}_0 \\boldsymbol{\\mu}_0 + \\boldsymbol{X}_n^\\top "
"x^n),\\\\\n"
"\\alpha_n &= \\alpha_0 + \\frac{n}{2},\\\\\n"
"\\beta_n &= \\beta_0 + \\frac{1}{2} \\left( -\\boldsymbol{\\mu}_n^\\top \\boldsymbol{\\Lambda}_n \\boldsymbol{\\mu}_n \n"
"+ (x^n)^\\top x^n + \\boldsymbol{\\mu}_0^\\top \\boldsymbol{\\Lambda}_0 \\boldsymbol{\\mu}_0 \\right).\n"
"\n"
msgstr ""
"\\boldsymbol{\\Lambda}_n &= \\boldsymbol{\\Lambda}_0 + \\boldsymbol{X}_n^\\top \\boldsymbol{X}_n,\\\\\n"
"\\boldsymbol{\\mu}_n &= \\boldsymbol{\\Lambda}_n^{-1} (\\boldsymbol{\\Lambda}_0 \\boldsymbol{\\mu}_0 + \\boldsymbol{X}_n^\\top "
"x^n),\\\\\n"
"\\alpha_n &= \\alpha_0 + \\frac{n}{2},\\\\\n"
"\\beta_n &= \\beta_0 + \\frac{1}{2} \\left( -\\boldsymbol{\\mu}_n^\\top \\boldsymbol{\\Lambda}_n \\boldsymbol{\\mu}_n \n"
"+ (x^n)^\\top x^n + \\boldsymbol{\\mu}_0^\\top \\boldsymbol{\\Lambda}_0 \\boldsymbol{\\mu}_0 \\right).\n"
"\n"

#: bayesml.autoregressive:85 of
msgid "Predictive Distribution"
msgstr "予測分布"

#: bayesml.autoregressive:87 of
msgid "The predictive distribution is as follows:"
msgstr "予測分布は以下の通りです："

#: bayesml.autoregressive:89 of
#, python-brace-format
msgid ":math:`x_{n+1} \\in \\mathbb{R}`: a new data point"
msgstr ":math:`x_{n+1} \\in \\mathbb{R}`: 新たなデータ点"

#: bayesml.autoregressive:90 of
#, python-brace-format
msgid ":math:`m_\\mathrm{p} \\in \\mathbb{R}`: a parameter"
msgstr ":math:`m_\\mathrm{p} \\in \\mathbb{R}`: パラメータ"

#: bayesml.autoregressive:91 of
#, python-brace-format
msgid ":math:`\\lambda_\\mathrm{p} \\in \\mathbb{R}_{>0}`: a parameter"
msgstr ":math:`\\lambda_\\mathrm{p} \\in \\mathbb{R}_{>0}`: パラメータ"

#: bayesml.autoregressive:92 of
#, python-brace-format
msgid ":math:`\\nu_\\mathrm{p} \\in \\mathbb{R}_{>0}`: a parameter"
msgstr ":math:`\\nu_\\mathrm{p} \\in \\mathbb{R}_{>0}`: パラメータ"

#: bayesml.autoregressive:94 of
msgid ""
"\\mathrm{St}(x_{n+1}|m_\\mathrm{p}, \\lambda_\\mathrm{p}, \\nu_\\mathrm{p})\n"
"= \\frac{\\Gamma (\\nu_\\mathrm{p}/2 + 1/2)}{\\Gamma (\\nu_\\mathrm{p}/2)}\n"
"\\left( \\frac{\\lambda_\\mathrm{p}}{\\pi \\nu_\\mathrm{p}} \\right)^{1/2}\n"
"\\left[ 1 + \\frac{\\lambda_\\mathrm{p}(x_{n+1}-m_\\mathrm{p})^2}{\\nu_\\mathrm{p}} \\right]^{-\\nu_\\mathrm{p}/2 - 1/2}.\n"
"\n"
msgstr ""
"\\mathrm{St}(x_{n+1}|m_\\mathrm{p}, \\lambda_\\mathrm{p}, \\nu_\\mathrm{p})\n"
"= \\frac{\\Gamma (\\nu_\\mathrm{p}/2 + 1/2)}{\\Gamma (\\nu_\\mathrm{p}/2)}\n"
"\\left( \\frac{\\lambda_\\mathrm{p}}{\\pi \\nu_\\mathrm{p}} \\right)^{1/2}\n"
"\\left[ 1 + \\frac{\\lambda_\\mathrm{p}(x_{n+1}-m_\\mathrm{p})^2}{\\nu_\\mathrm{p}} \\right]^{-\\nu_\\mathrm{p}/2 - 1/2}.\n"
"\n"

#: bayesml.autoregressive:100 of
msgid ""
"\\mathbb{E}[x_{n+1} | x^n] &= m_\\mathrm{p} & (\\nu_\\mathrm{p} > 1), \\\\\n"
"\\mathbb{V}[x_{n+1} | x^n] &= \\frac{1}{\\lambda_\\mathrm{p}} \\frac{\\nu_\\mathrm{p}}{\\nu_\\mathrm{p}-2} & (\\nu_\\mathrm{p} > "
"2),\n"
"\n"
msgstr ""
"\\mathbb{E}[x_{n+1} | x^n] &= m_\\mathrm{p} & (\\nu_\\mathrm{p} > 1), \\\\\n"
"\\mathbb{V}[x_{n+1} | x^n] &= \\frac{1}{\\lambda_\\mathrm{p}} \\frac{\\nu_\\mathrm{p}}{\\nu_\\mathrm{p}-2} & (\\nu_\\mathrm{p} > "
"2),\n"
"\n"

#: bayesml.autoregressive:104 of
msgid "where the parameters are obtained from the hyperparameters of the posterior distribution as follows."
msgstr "ここで、パラメータは事後分布のハイパーパラメータから以下のように求められます。"

#: bayesml.autoregressive:106 of
#, python-brace-format
msgid ""
"m_\\mathrm{p} &= \\boldsymbol{\\mu}_n^\\top \\boldsymbol{x}'_n,\\\\\n"
"\\lambda_\\mathrm{p} &= \\frac{\\alpha_n}{\\beta_n} (1 + (\\boldsymbol{x}'_n)^\\top \\boldsymbol{\\Lambda}_n^{-1} "
"\\boldsymbol{x}'_n)^{-1},\\\\\n"
"\\nu_\\mathrm{p} &= 2 \\alpha_n.\n"
"\n"
msgstr ""
"m_\\mathrm{p} &= \\boldsymbol{\\mu}_n^\\top \\boldsymbol{x}'_n,\\\\\n"
"\\lambda_\\mathrm{p} &= \\frac{\\alpha_n}{\\beta_n} (1 + (\\boldsymbol{x}'_n)^\\top \\boldsymbol{\\Lambda}_n^{-1} "
"\\boldsymbol{x}'_n)^{-1},\\\\\n"
"\\nu_\\mathrm{p} &= 2 \\alpha_n.\n"
"\n"

