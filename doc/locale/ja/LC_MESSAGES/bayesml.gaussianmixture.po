#: bayesml.gaussianmixture:1 of
msgid "This module provides the Gaussian mixture model with the Gauss-Wishart prior distribution and the Dirichlet prior distribution."
msgstr "このモジュールではガウス・ウィシャート事前分布とディリクレ事前分布を用いたガウス混合モデルを利用できます。"

#: bayesml.gaussianmixture:6 of
msgid "Stochastic Data Generative Model"
msgstr "確率的データ生成モデル"

#: bayesml.gaussianmixture:8 of
msgid "The stochastic data generative model is as follows:"
msgstr "確率的データ生成モデルは以下の通りです："

#: bayesml.gaussianmixture:10 of
#, python-brace-format
msgid ":math:`K \\in \\mathbb{N}`: number of latent classes"
msgstr ":math:`K \\in \\mathbb{N}`: 潜在クラスの数"

#: bayesml.gaussianmixture:11 of
#, python-brace-format
msgid ":math:`\\boldsymbol{z} \\in \\{ 0, 1 \\}^K`: a one-hot vector representing the latent class (latent variable)"
msgstr ":math:`\\boldsymbol{z} \\in \\{ 0, 1 \\}^K`: 潜在クラス（潜在変数）を表すone-hotベクトル"

#: bayesml.gaussianmixture:12 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\pi} \\in [0, 1]^K`: a parameter for latent classes, (:math:`\\sum_{k=1}^K \\pi_k=1`)"
msgstr ":math:`\\boldsymbol{\\pi} \\in [0, 1]^K`：潜在クラスのパラメータ（:math:`\\sum_{k=1}^K \\pi_k=1`）"

#: bayesml.gaussianmixture:13 of
#, python-brace-format
msgid ":math:`D \\in \\mathbb{N}`: a dimension of data"
msgstr ":math:`D \\in \\mathbb{N}`: データの次元"

#: bayesml.gaussianmixture:14 of
#, python-brace-format
msgid ":math:`\\boldsymbol{x} \\in \\mathbb{R}^D`: a data point"
msgstr ":math:`\\boldsymbol{x} \\in \\mathbb{R}^D`: データ点"

#: bayesml.gaussianmixture:15 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\mu}_k \\in \\mathbb{R}^D`: a parameter"
msgstr ":math:`\\boldsymbol{\\mu}_k \\in \\mathbb{R}^D`: パラメータ"

#: bayesml.gaussianmixture:16 of
msgid ":math:`\\boldsymbol{\\mu} = \\{ \\boldsymbol{\\mu}_k \\}_{k=1}^K`"
msgstr ":math:`\\boldsymbol{\\mu} = \\{ \\boldsymbol{\\mu}_k \\}_{k=1}^K`"

#: bayesml.gaussianmixture:17 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\Lambda}_k \\in \\mathbb{R}^{D\\times D}` : a parameter (a positive definite matrix)"
msgstr ":math:`\\boldsymbol{\\Lambda}_k \\in \\mathbb{R}^{D\\times D}` : パラメータ（正定値行列）"

#: bayesml.gaussianmixture:18 of
msgid ":math:`\\boldsymbol{\\Lambda} = \\{ \\boldsymbol{\\Lambda}_k \\}_{k=1}^K`"
msgstr ":math:`\\boldsymbol{\\Lambda} = \\{ \\boldsymbol{\\Lambda}_k \\}_{k=1}^K`"

#: bayesml.gaussianmixture:19 of
#, python-brace-format
msgid ":math:`| \\boldsymbol{\\Lambda}_k | \\in \\mathbb{R}`: the determinant of :math:`\\boldsymbol{\\Lambda}_k`"
msgstr ":math:`| \\boldsymbol{\\Lambda}_k | \\in \\mathbb{R}`: :math:`\\boldsymbol{\\Lambda}_k` の行列式"

#: bayesml.gaussianmixture:21 of
msgid ""
"p(\\boldsymbol{z} | \\boldsymbol{\\pi}) &= \\mathrm{Cat}(\\boldsymbol{z}|\\boldsymbol{\\pi}) = \\prod_{k=1}^K \\pi_k^{z_k},\\\\\n"
"p(\\boldsymbol{x} | \\boldsymbol{\\mu}, \\boldsymbol{\\Lambda}, \\boldsymbol{z}) &= \\prod_{k=1}^K \\mathcal{N}(\\boldsymbol{x}|"
"\\boldsymbol{\\mu}_k,\\boldsymbol{\\Lambda}_k^{-1})^{z_k} \\\\\n"
"&= \\prod_{k=1}^K \\left( \\frac{| \\boldsymbol{\\Lambda}_k |^{1/2}}{(2\\pi)^{D/2}} \\exp \\left\\{ -\\frac{1}{2}(\\boldsymbol{x}-"
"\\boldsymbol{\\mu}_k)^\\top \\boldsymbol{\\Lambda}_k (\\boldsymbol{x}-\\boldsymbol{\\mu}_k) \\right\\} \\right)^{z_k}.\n"
"\n"
msgstr ""
"p(\\boldsymbol{z} | \\boldsymbol{\\pi}) &= \\mathrm{Cat}(\\boldsymbol{z}|\\boldsymbol{\\pi}) = \\prod_{k=1}^K \\pi_k^{z_k},\\\\\n"
"p(\\boldsymbol{x} | \\boldsymbol{\\mu}, \\boldsymbol{\\Lambda}, \\boldsymbol{z}) &= \\prod_{k=1}^K \\mathcal{N}(\\boldsymbol{x}|"
"\\boldsymbol{\\mu}_k,\\boldsymbol{\\Lambda}_k^{-1})^{z_k} \\\\\n"
"&= \\prod_{k=1}^K \\left( \\frac{| \\boldsymbol{\\Lambda}_k |^{1/2}}{(2\\pi)^{D/2}} \\exp \\left\\{ -\\frac{1}{2}(\\boldsymbol{x}-"
"\\boldsymbol{\\mu}_k)^\\top \\boldsymbol{\\Lambda}_k (\\boldsymbol{x}-\\boldsymbol{\\mu}_k) \\right\\} \\right)^{z_k}.\n"
"\n"

#: bayesml.gaussianmixture:27 of
msgid "Prior Distribution"
msgstr "事前分布"

#: bayesml.gaussianmixture:29 of
msgid "The prior distribution is as follows:"
msgstr "事前分布は以下の通りです："

#: bayesml.gaussianmixture:31 of
#, python-brace-format
msgid ":math:`\\boldsymbol{m}_0 \\in \\mathbb{R}^{D}`: a hyperparameter"
msgstr ":math:`\\boldsymbol{m}_0 \\in \\mathbb{R}^{D}`: ハイパーパラメータ"

#: bayesml.gaussianmixture:32 of
#, python-brace-format
msgid ":math:`\\kappa_0 \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\kappa_0 \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.gaussianmixture:33 of
#, python-brace-format
msgid ":math:`\\nu_0 \\in \\mathbb{R}`: a hyperparameter (:math:`\\nu_0 > D-1`)"
msgstr ":math:`\\nu_0 \\in \\mathbb{R}`: ハイパーパラメータ（:math:`\\nu_0 > D-1`）"

#: bayesml.gaussianmixture:34 of
#, python-brace-format
msgid ":math:`\\boldsymbol{W}_0 \\in \\mathbb{R}^{D\\times D}`: a hyperparameter (a positive definite matrix)"
msgstr ":math:`\\boldsymbol{W}_0 \\in \\mathbb{R}^{D\\times D}`: ハイパーパラメータ（正定値行列）"

#: bayesml.gaussianmixture:35 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\alpha}_0 \\in \\mathbb{R}_{> 0}^K`: a hyperparameter"
msgstr ":math:`\\boldsymbol{\\alpha}_0 \\in \\mathbb{R}_{> 0}^K`: ハイパーパラメータ"

#: bayesml.gaussianmixture:36 of
#, python-brace-format
msgid ":math:`\\mathrm{Tr} \\{ \\cdot \\}`: a trace of a matrix"
msgstr ":math:`\\mathrm{Tr} \\{ \\cdot \\}`: 行列のトレース"

#: bayesml.gaussianmixture:37 of
msgid ":math:`\\Gamma (\\cdot)`: the gamma function"
msgstr ":math:`\\Gamma (\\cdot)`: ガンマ関数"

#: bayesml.gaussianmixture:39 of
msgid ""
"p(\\boldsymbol{\\mu},\\boldsymbol{\\Lambda},\\boldsymbol{\\pi}) &= \\left\\{ \\prod_{k=1}^K \\mathcal{N}(\\boldsymbol{\\mu}_k|\\boldsymbol{m}_0,"
"(\\kappa_0 \\boldsymbol{\\Lambda}_k)^{-1})\\mathcal{W}(\\boldsymbol{\\Lambda}_k|\\boldsymbol{W}_0, \\nu_0) \\right\\} \\mathrm{Dir}"
"(\\boldsymbol{\\pi}|\\boldsymbol{\\alpha}_0) \\\\\n"
"&= \\Biggl[\\, \\prod_{k=1}^K \\left( \\frac{\\kappa_0}{2\\pi} \\right)^{D/2} |\\boldsymbol{\\Lambda}_k|^{1/2} \\exp \\left\\{ -"
"\\frac{\\kappa_0}{2}(\\boldsymbol{\\mu}_k -\\boldsymbol{m}_0)^\\top \\boldsymbol{\\Lambda}_k (\\boldsymbol{\\mu}_k - \\boldsymbol{m}_0) "
"\\right\\} \\notag \\\\\n"
"&\\qquad \\times B(\\boldsymbol{W}_0, \\nu_0) | \\boldsymbol{\\Lambda}_k |^{(\\nu_0 - D - 1) / 2} \\exp \\left\\{ -\\frac{1}{2} \\mathrm{Tr} \\"
"{ \\boldsymbol{W}_0^{-1} \\boldsymbol{\\Lambda}_k \\} \\right\\} \\Biggr] \\notag \\\\\n"
"&\\qquad \\times C(\\boldsymbol{\\alpha}_0)\\prod_{k=1}^K \\pi_k^{\\alpha_{0,k}-1},\\\\\n"
"\n"
msgstr ""
"p(\\boldsymbol{\\mu},\\boldsymbol{\\Lambda},\\boldsymbol{\\pi}) &= \\left\\{ \\prod_{k=1}^K \\mathcal{N}(\\boldsymbol{\\mu}_k|\\boldsymbol{m}_0,"
"(\\kappa_0 \\boldsymbol{\\Lambda}_k)^{-1})\\mathcal{W}(\\boldsymbol{\\Lambda}_k|\\boldsymbol{W}_0, \\nu_0) \\right\\} \\mathrm{Dir}"
"(\\boldsymbol{\\pi}|\\boldsymbol{\\alpha}_0) \\\\\n"
"&= \\Biggl[\\, \\prod_{k=1}^K \\left( \\frac{\\kappa_0}{2\\pi} \\right)^{D/2} |\\boldsymbol{\\Lambda}_k|^{1/2} \\exp \\left\\{ -"
"\\frac{\\kappa_0}{2}(\\boldsymbol{\\mu}_k -\\boldsymbol{m}_0)^\\top \\boldsymbol{\\Lambda}_k (\\boldsymbol{\\mu}_k - \\boldsymbol{m}_0) "
"\\right\\} \\notag \\\\\n"
"&\\qquad \\times B(\\boldsymbol{W}_0, \\nu_0) | \\boldsymbol{\\Lambda}_k |^{(\\nu_0 - D - 1) / 2} \\exp \\left\\{ -\\frac{1}{2} \\mathrm{Tr} \\"
"{ \\boldsymbol{W}_0^{-1} \\boldsymbol{\\Lambda}_k \\} \\right\\} \\Biggr] \\notag \\\\\n"
"&\\qquad \\times C(\\boldsymbol{\\alpha}_0)\\prod_{k=1}^K \\pi_k^{\\alpha_{0,k}-1},\\\\\n"
"\n"

#: bayesml.gaussianmixture:45 of
#, python-brace-format
msgid "where :math:`B(\\boldsymbol{W}_0, \\nu_0)` and :math:`C(\\boldsymbol{\\alpha}_0)` are defined as follows:"
msgstr "ここで、:math:`B(\\boldsymbol{W}_0, \\nu_0)` および :math:`C(\\boldsymbol{\\alpha}_0)` は次のように定義されます："

#: bayesml.gaussianmixture:47 of
msgid ""
"B(\\boldsymbol{W}_0, \\nu_0) &= | \\boldsymbol{W}_0 |^{-\\nu_0 / 2} \\left( 2^{\\nu_0 D / 2} \\pi^{D(D-1)/4} \\prod_{i=1}^D \\Gamma "
"\\left( \\frac{\\nu_0 + 1 - i}{2} \\right) \\right)^{-1}, \\\\\n"
"C(\\boldsymbol{\\alpha}_0) &= \\frac{\\Gamma(\\sum_{k=1}^K \\alpha_{0,k})}{\\Gamma(\\alpha_{0,1})\\cdots\\Gamma(\\alpha_{0,K})}.\n"
"\n"
msgstr ""
"B(\\boldsymbol{W}_0, \\nu_0) &= | \\boldsymbol{W}_0 |^{-\\nu_0 / 2} \\left( 2^{\\nu_0 D / 2} \\pi^{D(D-1)/4} \\prod_{i=1}^D \\Gamma "
"\\left( \\frac{\\nu_0 + 1 - i}{2} \\right) \\right)^{-1}, \\\\\n"
"C(\\boldsymbol{\\alpha}_0) &= \\frac{\\Gamma(\\sum_{k=1}^K \\alpha_{0,k})}{\\Gamma(\\alpha_{0,1})\\cdots\\Gamma(\\alpha_{0,K})}.\n"
"\n"

#: bayesml.gaussianmixture:52 of
msgid "Posterior Distribution"
msgstr "事後分布"

#: bayesml.gaussianmixture:54 of
msgid "The apporoximate posterior distribution in the :math:`t`-th iteration of a variational Bayesian method is as follows:"
msgstr "変分ベイズ法の :math:`t` 回目の反復における近似事後分布は、以下の通りです："

#: bayesml.gaussianmixture:56 of
#, python-brace-format
msgid ":math:`\\boldsymbol{x}^n = (\\boldsymbol{x}_1, \\boldsymbol{x}_2, \\dots , \\boldsymbol{x}_n) \\in \\mathbb{R}^{D \\times n}`: given data"
msgstr ""
":math:`\\boldsymbol{x}^n = (\\boldsymbol{x}_1, \\boldsymbol{x}_2, \\dots , \\boldsymbol{x}_n) \\in \\mathbb{R}^{D\\times n}`: 与えられたデータ"

#: bayesml.gaussianmixture:57 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{z}^n = (\\boldsymbol{z}_1, \\boldsymbol{z}_2, \\dots , \\boldsymbol{z}_n) \\in \\{ 0, 1 \\}^{K \\times n}`: latent classes "
"of given data"
msgstr ""
":math:`\\boldsymbol{z}^n = (\\boldsymbol{z}_1, \\boldsymbol{z}_2, \\dots , \\boldsymbol{z}_n) \\in \\{ 0, 1 \\}^{K \\times n}`: 与えられたデータ"
"の潜在クラス"

#: bayesml.gaussianmixture:58 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{r}_i^{(t)} = (r_{i,1}^{(t)}, r_{i,2}^{(t)}, \\dots , r_{i,K}^{(t)}) \\in [0, 1]^K`: a parameter for the :math:`i`-th latent "
"class. (:math:`\\sum_{k=1}^K r_{i, k}^{(t)} = 1`)"
msgstr ""
":math:`\\boldsymbol{r}_i^{(t)} = (r_{i,1}^{(t)}, r_{i,2}^{(t)}, \\dots , r_{i,K}^{(t)}) \\in [0, 1]^K`: :math:`i`番目の潜在クラスに対するパラ"
"メータです。 (:math:`\\sum_{k=1}^K r_{i, k}^{(t)} = 1`)"

#: bayesml.gaussianmixture:59 of
#, python-brace-format
msgid ":math:`\\boldsymbol{m}_{n,k}^{(t)} \\in \\mathbb{R}^{D}`: a hyperparameter"
msgstr ":math:`\\boldsymbol{m}_{n,k}^{(t)} \\in \\mathbb{R}^{D}`: ハイパーパラメータ"

#: bayesml.gaussianmixture:60 of
#, python-brace-format
msgid ":math:`\\kappa_{n,k}^{(t)} \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\kappa_{n,k}^{(t)} \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.gaussianmixture:61 of
#, python-brace-format
msgid ":math:`\\nu_{n,k}^{(t)} \\in \\mathbb{R}`: a hyperparameter :math:`(\\nu_n > D-1)`"
msgstr ":math:`\\nu_{n,k}^{(t)} \\in \\mathbb{R}`: ハイパーパラメータ :math:`(\\nu_n > D-1)`"

#: bayesml.gaussianmixture:62 of
#, python-brace-format
msgid ":math:`\\boldsymbol{W}_{n,k}^{(t)} \\in \\mathbb{R}^{D\\times D}`: a hyperparameter (a positive definite matrix)"
msgstr ":math:`\\boldsymbol{W}_{n,k}^{(t)} \\in \\mathbb{R}^{D\\times D}`: ハイパーパラメータ（正定値行列）"

#: bayesml.gaussianmixture:63 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\alpha}_n^{(t)} \\in \\mathbb{R}_{> 0}^K`: a hyperparameter"
msgstr ":math:`\\boldsymbol{\\alpha}_n^{(t)} \\in \\mathbb{R}_{> 0}^K`: ハイパーパラメータ"

#: bayesml.gaussianmixture:65 of
msgid ""
"q(\\boldsymbol{z}^n, \\boldsymbol{\\mu},\\boldsymbol{\\Lambda},\\boldsymbol{\\pi}) &= \\left\\{ \\prod_{i=1}^n \\mathrm{Cat} (\\boldsymbol{z}_i "
"| \\boldsymbol{r}_i^{(t)}) \\right\\} \\left\\{ \\prod_{k=1}^K \\mathcal{N}(\\boldsymbol{\\mu}_k|\\boldsymbol{m}_{n,k}^{(t)},(\\kappa_{n,k}"
"^{(t)} \\boldsymbol{\\Lambda}_k)^{-1})\\mathcal{W}(\\boldsymbol{\\Lambda}_k|\\boldsymbol{W}_{n,k}^{(t)}, \\nu_{n,k}^{(t)}) \\right\\} "
"\\mathrm{Dir}(\\boldsymbol{\\pi}|\\boldsymbol{\\alpha}_n^{(t)}) \\\\\n"
"&= \\Biggl[\\, \\prod_{i=1}^n \\prod_{k=1}^K (r_{i,k}^{(t)})^{z_{i,k}} \\Biggr] \\Biggl[\\, \\prod_{k=1}^K \\left( \\frac{\\kappa_{n,k}^{(t)}}"
"{2\\pi} \\right)^{D/2} |\\boldsymbol{\\Lambda}_k|^{1/2} \\exp \\left\\{ -\\frac{\\kappa_{n,k}^{(t)}}{2}(\\boldsymbol{\\mu}_k -\\boldsymbol{m}"
"_{n,k}^{(t)})^\\top \\boldsymbol{\\Lambda}_k (\\boldsymbol{\\mu}_k - \\boldsymbol{m}_{n,k}^{(t)}) \\right\\} \\\\\n"
"&\\qquad \\times B(\\boldsymbol{W}_{n,k}^{(t)}, \\nu_{n,k}^{(t)}) | \\boldsymbol{\\Lambda}_k |^{(\\nu_{n,k}^{(t)} - D - 1) / 2} \\exp \\left\\"
"{ -\\frac{1}{2} \\mathrm{Tr} \\{ ( \\boldsymbol{W}_{n,k}^{(t)} )^{-1} \\boldsymbol{\\Lambda}_k \\} \\right\\} \\Biggr] \\\\\n"
"&\\qquad \\times C(\\boldsymbol{\\alpha}_n^{(t)})\\prod_{k=1}^K \\pi_k^{\\alpha_{n,k}^{(t)}-1},\\\\\n"
"\n"
msgstr ""
"q(\\boldsymbol{z}^n, \\boldsymbol{\\mu},\\boldsymbol{\\Lambda},\\boldsymbol{\\pi}) &= \\left\\{ \\prod_{i=1}^n \\mathrm{Cat} (\\boldsymbol{z}_i "
"| \\boldsymbol{r}_i^{(t)}) \\right\\} \\left\\{ \\prod_{k=1}^K \\mathcal{N}(\\boldsymbol{\\mu}_k|\\boldsymbol{m}_{n,k}^{(t)},(\\kappa_{n,k}"
"^{(t)} \\boldsymbol{\\Lambda}_k)^{-1})\\mathcal{W}(\\boldsymbol{\\Lambda}_k|\\boldsymbol{W}_{n,k}^{(t)}, \\nu_{n,k}^{(t)}) \\right\\} "
"\\mathrm{Dir}(\\boldsymbol{\\pi}|\\boldsymbol{\\alpha}_n^{(t)}) \\\\\n"
"&= \\Biggl[\\, \\prod_{i=1}^n \\prod_{k=1}^K (r_{i,k}^{(t)})^{z_{i,k}} \\Biggr] \\Biggl[\\, \\prod_{k=1}^K \\left( \\frac{\\kappa_{n,k}^{(t)}}"
"{2\\pi} \\right)^{D/2} |\\boldsymbol{\\Lambda}_k|^{1/2} \\exp \\left\\{ -\\frac{\\kappa_{n,k}^{(t)}}{2}(\\boldsymbol{\\mu}_k -\\boldsymbol{m}"
"_{n,k}^{(t)})^\\top \\boldsymbol{\\Lambda}_k (\\boldsymbol{\\mu}_k - \\boldsymbol{m}_{n,k}^{(t)}) \\right\\} \\\\\n"
"&\\qquad \\times B(\\boldsymbol{W}_{n,k}^{(t)}, \\nu_{n,k}^{(t)}) | \\boldsymbol{\\Lambda}_k |^{(\\nu_{n,k}^{(t)} - D - 1) / 2} \\exp \\left\\"
"{ -\\frac{1}{2} \\mathrm{Tr} \\{ ( \\boldsymbol{W}_{n,k}^{(t)} )^{-1} \\boldsymbol{\\Lambda}_k \\} \\right\\} \\Biggr] \\\\\n"
"&\\qquad \\times C(\\boldsymbol{\\alpha}_n^{(t)})\\prod_{k=1}^K \\pi_k^{\\alpha_{n,k}^{(t)}-1},\\\\\n"
"\n"

#: bayesml.gaussianmixture:71 of
msgid "where the updating rule of the hyperparameters is as follows."
msgstr "ハイパーパラメータの更新ルールは以下の通りです。"

#: bayesml.gaussianmixture:73 of
msgid ""
"N_k^{(t)} &= \\sum_{i=1}^n r_{i,k}^{(t)}, \\\\\n"
"\\bar{\\boldsymbol{x}}_k^{(t)} &= \\frac{1}{N_k^{(t)}} \\sum_{i=1}^n r_{i,k}^{(t)} \\boldsymbol{x}_i, \\\\\n"
"\\boldsymbol{m}_{n,k}^{(t+1)} &= \\frac{\\kappa_0\\boldsymbol{m}_0 + N_k^{(t)} \\bar{\\boldsymbol{x}}_k^{(t)}}{\\kappa_0 + N_k^{(t)}}, \\\\\n"
"\\kappa_{n,k}^{(t+1)} &= \\kappa_0 + N_k^{(t)}, \\\\\n"
"(\\boldsymbol{W}_{n,k}^{(t+1)})^{-1} &= \\boldsymbol{W}_0^{-1} + \\sum_{i=1}^{n} r_{i,k}^{(t)} (\\boldsymbol{x}_i-\\bar{\\boldsymbol{x}}"
"_k^{(t)})(\\boldsymbol{x}_i-\\bar{\\boldsymbol{x}}_k^{(t)})^\\top + \\frac{\\kappa_0 N_k^{(t)}}{\\kappa_0 + N_k^{(t)}}(\\bar{\\boldsymbol{x}}"
"_k^{(t)}-\\boldsymbol{m}_0)(\\bar{\\boldsymbol{x}}_k^{(t)}-\\boldsymbol{m}_0)^\\top, \\\\\n"
"\\nu_{n,k}^{(t+1)} &= \\nu_0 + N_k^{(t)},\\\\\n"
"\\alpha_{n,k}^{(t+1)} &= \\alpha_{0,k} + N_k^{(t)}, \\\\\n"
"\\ln \\rho_{i,k}^{(t+1)} &= \\psi (\\alpha_{n,k}^{(t+1)}) - \\psi ( {\\textstyle \\sum_{k=1}^K \\alpha_{n,k}^{(t+1)}} ) \\notag \\\\\n"
"&\\qquad + \\frac{1}{2} \\Biggl[\\, \\sum_{d=1}^D \\psi \\left( \\frac{\\nu_{n,k}^{(t+1)} + 1 - d}{2} \\right) + D \\ln 2 + \\ln | "
"\\boldsymbol{W}_{n,k}^{(t+1)} | \\notag \\\\\n"
"&\\qquad - D \\ln (2 \\pi ) - \\frac{D}{\\kappa_{n,k}^{(t+1)}} - \\nu_{n,k}^{(t+1)} (\\boldsymbol{x}_i - \\boldsymbol{m}_{n,k}^{(t+1)})^\\top "
"\\boldsymbol{W}_{n,k}^{(t+1)} (\\boldsymbol{x}_i - \\boldsymbol{m}_{n,k}^{(t+1)}) \\Biggr], \\\\\n"
"r_{i,k}^{(t+1)} &= \\frac{\\rho_{i,k}^{(t+1)}}{\\sum_{j=1}^K \\rho_{i,j}^{(t+1)}}.\n"
"\n"
msgstr ""
"N_k^{(t)} &= \\sum_{i=1}^n r_{i,k}^{(t)}, \\\\\n"
"\\bar{\\boldsymbol{x}}_k^{(t)} &= \\frac{1}{N_k^{(t)}} \\sum_{i=1}^n r_{i,k}^{(t)} \\boldsymbol{x}_i, \\\\\n"
"\\boldsymbol{m}_{n,k}^{(t+1)} &= \\frac{\\kappa_0\\boldsymbol{m}_0 + N_k^{(t)} \\bar{\\boldsymbol{x}}_k^{(t)}}{\\kappa_0 + N_k^{(t)}}, \\\\\n"
"\\kappa_{n,k}^{(t+1)} &= \\kappa_0 + N_k^{(t)}, \\\\\n"
"(\\boldsymbol{W}_{n,k}^{(t+1)})^{-1} &= \\boldsymbol{W}_0^{-1} + \\sum_{i=1}^{n} r_{i,k}^{(t)} (\\boldsymbol{x}_i-\\bar{\\boldsymbol{x}}"
"_k^{(t)})(\\boldsymbol{x}_i-\\bar{\\boldsymbol{x}}_k^{(t)})^\\top + \\frac{\\kappa_0 N_k^{(t)}}{\\kappa_0 + N_k^{(t)}}(\\bar{\\boldsymbol{x}}"
"_k^{(t)}-\\boldsymbol{m}_0)(\\bar{\\boldsymbol{x}}_k^{(t)}-\\boldsymbol{m}_0)^\\top, \\\\\n"
"\\nu_{n,k}^{(t+1)} &= \\nu_0 + N_k^{(t)},\\\\\n"
"\\alpha_{n,k}^{(t+1)} &= \\alpha_{0,k} + N_k^{(t)}, \\\\\n"
"\\ln \\rho_{i,k}^{(t+1)} &= \\psi (\\alpha_{n,k}^{(t+1)}) - \\psi ( {\\textstyle \\sum_{k=1}^K \\alpha_{n,k}^{(t+1)}} ) \\notag \\\\\n"
"&\\qquad + \\frac{1}{2} \\Biggl[\\, \\sum_{d=1}^D \\psi \\left( \\frac{\\nu_{n,k}^{(t+1)} + 1 - d}{2} \\right) + D \\ln 2 + \\ln | "
"\\boldsymbol{W}_{n,k}^{(t+1)} | \\notag \\\\\n"
"&\\qquad - D \\ln (2 \\pi ) - \\frac{D}{\\kappa_{n,k}^{(t+1)}} - \\nu_{n,k}^{(t+1)} (\\boldsymbol{x}_i - \\boldsymbol{m}_{n,k}^{(t+1)})^\\top "
"\\boldsymbol{W}_{n,k}^{(t+1)} (\\boldsymbol{x}_i - \\boldsymbol{m}_{n,k}^{(t+1)}) \\Biggr], \\\\\n"
"r_{i,k}^{(t+1)} &= \\frac{\\rho_{i,k}^{(t+1)}}{\\sum_{j=1}^K \\rho_{i,j}^{(t+1)}}.\n"
"\n"

#: bayesml.gaussianmixture:87 of
msgid "Predictive Distribution"
msgstr "予測分布"

#: bayesml.gaussianmixture:89 of
msgid "The approximate predictive distribution is as follows:"
msgstr "近似予測分布は以下の通りです："

#: bayesml.gaussianmixture:91 of
#, python-brace-format
msgid ":math:`\\boldsymbol{x}_{n+1} \\in \\mathbb{R}^D`: a new data point"
msgstr ":math:`\\boldsymbol{x}_{n+1}\\in \\mathbb{R}^d`: 新たなデータ点"

#: bayesml.gaussianmixture:92 of
msgid ":math:`\\boldsymbol{\\mu}_{\\mathrm{p},k} \\in \\mathbb{R}^D`: the parameter of the predictive distribution"
msgstr ":math:`\\boldsymbol{\\mu}_{\\mathrm{p},k} \\in \\mathbb{R}^D`: 予測分布のパラメータ"

#: bayesml.gaussianmixture:93 of
msgid ""
":math:`\\boldsymbol{\\Lambda}_{\\mathrm{p},k} \\in \\mathbb{R}^{D \\times D}`: the parameter of the predictive distribution (a positive "
"definite matrix)"
msgstr ":math:`\\boldsymbol{\\Lambda}_{\\mathrm{p},k} \\in \\mathbb{R}^{D \\times D}`: 予測分布のパラメータ（正定値行列）"

#: bayesml.gaussianmixture:94 of
msgid ":math:`\\nu_{\\mathrm{p},k} \\in \\mathbb{R}_{>0}`: the parameter of the predictive distribution"
msgstr ":math:`\\nu_{\\mathrm{p},k} \\in \\mathbb{R}_{>0}`: 予測分布のパラメータ"

#: bayesml.gaussianmixture:96 of
msgid ""
"&p(x_{n+1}|x^n) \\\\\n"
"&= \\frac{1}{\\sum_{k=1}^K \\alpha_{n,k}^{(t)}} \\sum_{k=1}^K \\alpha_{n,k}^{(t)} \\mathrm{St}(x_{n+1}|\\boldsymbol{\\mu}_{\\mathrm{p},k},"
"\\boldsymbol{\\Lambda}_{\\mathrm{p},k}, \\nu_{\\mathrm{p},k}) \\\\\n"
"&= \\frac{1}{\\sum_{k=1}^K \\alpha_{n,k}^{(t)}} \\sum_{k=1}^K \\alpha_{n,k}^{(t)} \\Biggl[ \\frac{\\Gamma (\\nu_{\\mathrm{p},k} / 2 + D / 2)}"
"{\\Gamma (\\nu_{\\mathrm{p},k} / 2)} \\frac{|\\boldsymbol{\\Lambda}_{\\mathrm{p},k}|^{1/2}}{(\\nu_{\\mathrm{p},k} \\pi)^{D/2}} \\notag \\\\\n"
"&\\qquad \\qquad \\qquad \\qquad \\qquad \\times \\left( 1 + \\frac{1}{\\nu_{\\mathrm{p},k}} (\\boldsymbol{x}_{n+1} - \\boldsymbol{\\mu}"
"_{\\mathrm{p},k})^\\top \\boldsymbol{\\Lambda}_{\\mathrm{p},k} (\\boldsymbol{x}_{n+1} - \\boldsymbol{\\mu}_{\\mathrm{p},k}) \\right)^{-"
"\\nu_{\\mathrm{p},k}/2 - D/2} \\Biggr],\n"
"\n"
msgstr ""
"&p(x_{n+1}|x^n) \\\\\n"
"&= \\frac{1}{\\sum_{k=1}^K \\alpha_{n,k}^{(t)}} \\sum_{k=1}^K \\alpha_{n,k}^{(t)} \\mathrm{St}(x_{n+1}|\\boldsymbol{\\mu}_{\\mathrm{p},k},"
"\\boldsymbol{\\Lambda}_{\\mathrm{p},k}, \\nu_{\\mathrm{p},k}) \\\\\n"
"&= \\frac{1}{\\sum_{k=1}^K \\alpha_{n,k}^{(t)}} \\sum_{k=1}^K \\alpha_{n,k}^{(t)} \\Biggl[ \\frac{\\Gamma (\\nu_{\\mathrm{p},k} / 2 + D / 2)}"
"{\\Gamma (\\nu_{\\mathrm{p},k} / 2)} \\frac{|\\boldsymbol{\\Lambda}_{\\mathrm{p},k}|^{1/2}}{(\\nu_{\\mathrm{p},k} \\pi)^{D/2}} \\notag \\\\\n"
"&\\qquad \\qquad \\qquad \\qquad \\qquad \\times \\left( 1 + \\frac{1}{\\nu_{\\mathrm{p},k}} (\\boldsymbol{x}_{n+1} - \\boldsymbol{\\mu}"
"_{\\mathrm{p},k})^\\top \\boldsymbol{\\Lambda}_{\\mathrm{p},k} (\\boldsymbol{x}_{n+1} - \\boldsymbol{\\mu}_{\\mathrm{p},k}) \\right)^{-"
"\\nu_{\\mathrm{p},k}/2 - D/2} \\Biggr],\n"
"\n"

#: bayesml.gaussianmixture:102 of
msgid "where the parameters are obtained from the hyperparameters of the posterior distribution as follows:"
msgstr "ここで、パラメータは事後分布のハイパーパラメータから以下のように求められます:"

#: bayesml.gaussianmixture:104 of
msgid ""
"\\boldsymbol{\\mu}_{\\mathrm{p},k} &= \\boldsymbol{m}_{n,k}^{(t)}, \\\\\n"
"\\nu_{\\mathrm{p},k} &= \\nu_{n,k}^{(t)} - D + 1,\\\\\n"
"\\boldsymbol{\\Lambda}_{\\mathrm{p},k} &= \\frac{\\kappa_{n,k}^{(t)} \\nu_{\\mathrm{p},k}}{\\kappa_{n,k}^{(t)} + 1} \\boldsymbol{W}_{n,k}"
"^{(t)}.\n"
"\n"
msgstr ""
"\\boldsymbol{\\mu}_{\\mathrm{p},k} &= \\boldsymbol{m}_{n,k}^{(t)}, \\\\\n"
"\\nu_{\\mathrm{p},k} &= \\nu_{n,k}^{(t)} - D + 1,\\\\\n"
"\\boldsymbol{\\Lambda}_{\\mathrm{p},k} &= \\frac{\\kappa_{n,k}^{(t)} \\nu_{\\mathrm{p},k}}{\\kappa_{n,k}^{(t)} + 1} \\boldsymbol{W}_{n,k}"
"^{(t)}.\n"
"\n"

