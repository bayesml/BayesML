msgstr "モジュール内容"

#: bayesml.normal:1 of
msgid ""
"This module provides the normal distribution with the normal-gamma prior "
"distribution."
msgstr "このモジュールでは正規-ガンマ事前分布を用いた正規分布を利用できます。"

#: bayesml.normal:6 of
msgid "Stochastic Data Generative Model"
msgstr "確率的データ生成モデル"

#: bayesml.normal:8 of
msgid "The stochastic data generative model is as follows:"
msgstr "確率的データ生成モデルは以下の通りです："

#: bayesml.normal:10 of
#, python-brace-format
msgid ":math:`x \\in \\mathbb{R}`: a data point"
msgstr ":math:`x \\in \\mathbb{R}`: データ点"

#: bayesml.normal:11 of
#, python-brace-format
msgid ":math:`\\mu \\in \\mathbb{R}`: a mean parameter"
msgstr ":math:`\\mu \\in \\mathbb{R}`: 平均パラメータ"

#: bayesml.normal:12 of
#, python-brace-format
msgid ":math:`\\tau \\in \\mathbb{R}_{>0}`: a precision parameter"
msgstr ":math:`\\tau \\in \\mathbb{R}_{>0}`: ノイズの精度パラメータ"

#: bayesml.normal:14 of
msgid ""
"p(x | \\mu, \\tau) &= \\mathcal{N}(x|\\mu,\\tau^{-1})\\\\\n"
"&= \\sqrt{\\frac{\\tau}{2\\pi}} \\exp \\left\\{ -\\frac{\\tau}{2}(x-\\mu)^2 "
"\\right\\},\n"
"\n"
msgstr ""
"p(x | \\mu, \\tau) &= \\mathcal{N}(x|\\mu,\\tau^{-1})\\\\\n"
"&= \\sqrt{\\frac{\\tau}{2\\pi}} \\exp \\left\\{ -\\frac{\\tau}{2}(x-\\mu)^2 "
"\\right\\},\n"
"\n"

#: bayesml.normal:19 of
#, python-brace-format
msgid ""
"&\\mathbb{E}[x | \\mu, \\tau] = \\mu, \\\\\n"
"&\\mathbb{V}[x | \\mu, \\tau] = \\tau^{-1}.\n"
"\n"
msgstr ""
"&\\mathbb{E}[x | \\mu, \\tau] = \\mu, \\\\\n"
"&\\mathbb{V}[x | \\mu, \\tau] = \\tau^{-1}.\n"
"\n"

#: bayesml.normal:24 of
msgid "Prior Distribution"
msgstr "事前分布"

#: bayesml.normal:26 of
msgid "The prior distribution is as follows:"
msgstr "事前分布は以下の通りです："

#: bayesml.normal:28 of
#, python-brace-format
msgid ":math:`m_0 \\in \\mathbb{R}`: a hyperparameter"
msgstr ":math:`m_0 \\in \\mathbb{R}`: ハイパーパラメータ"

#: bayesml.normal:29 of
#, python-brace-format
msgid ":math:`\\kappa_0 \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\kappa_0 \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.normal:30 of
#, python-brace-format
msgid ":math:`\\alpha_0 \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\alpha_0 \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.normal:31 of
#, python-brace-format
msgid ":math:`\\beta_0 \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\beta_0 \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.normal:32 bayesml.normal:54 of
msgid ":math:`\\Gamma ( \\cdot )`: the gamma function"
msgstr ":math:`\\Gamma (\\cdot)`: ガンマ関数"

#: bayesml.normal:34 of
msgid ""
"p(\\mu, \\tau) &= \\mathcal{N}(\\mu|m_0,(\\kappa_0 \\tau)^{-1}) \\mathrm{Gam}"
"(\\tau | \\alpha_0, \\beta_0) \\\\\n"
"&= \\sqrt{\\frac{\\kappa_0 \\tau}{2\\pi}} \\exp \\left\\{ -\\frac{\\kappa_0 "
"\\tau}{2}(\\mu-m_0)^2 \\right\\} \\frac{\\beta_0^{\\alpha_0}}{\\Gamma "
"(\\alpha_0)} \\tau^{\\alpha_0 - 1} \\exp \\{ -\\beta_0 \\tau \\},\n"
"\n"
msgstr ""
"p(\\mu, \\tau) &= \\mathcal{N}(\\mu|m_0,(\\kappa_0 \\tau)^{-1}) \\mathrm{Gam}"
"(\\tau | \\alpha_0, \\beta_0) \\\\\n"
"&= \\sqrt{\\frac{\\kappa_0 \\tau}{2\\pi}} \\exp \\left\\{ -\\frac{\\kappa_0 "
"\\tau}{2}(\\mu-m_0)^2 \\right\\} \\frac{\\beta_0^{\\alpha_0}}{\\Gamma "
"(\\alpha_0)} \\tau^{\\alpha_0 - 1} \\exp \\{ -\\beta_0 \\tau \\},\n"
"\n"

#: bayesml.normal:38 of
#, python-brace-format
msgid ""
"\\mathbb{E}[\\mu] &= m_0 & \\left( \\alpha_0 > \\frac{1}{2} \\right), \\\\\n"
"\\mathbb{V}[\\mu] &= \\frac{\\beta_0}{\\kappa_0 (\\alpha_0 - 1)} & (\\alpha_0 > "
"1), \\\\\n"
"\\mathbb{E}[\\tau] &= \\frac{\\alpha_0}{\\beta_0}, \\\\\n"
"\\mathbb{V}[\\tau] &= \\frac{\\alpha_0}{\\beta_0^2}.\n"
"\n"
msgstr ""
"\\mathbb{E}[\\mu] &= m_0 & \\left( \\alpha_0 > \\frac{1}{2} \\right), \\\\\n"
"\\mathbb{V}[\\mu] &= \\frac{\\beta_0}{\\kappa_0 (\\alpha_0 - 1)} & (\\alpha_0 > "
"1), \\\\\n"
"\\mathbb{E}[\\tau] &= \\frac{\\alpha_0}{\\beta_0}, \\\\\n"
"\\mathbb{V}[\\tau] &= \\frac{\\alpha_0}{\\beta_0^2}.\n"
"\n"

#: bayesml.normal:45 of
msgid "Posterior Distribution"
msgstr "事後分布"

#: bayesml.normal:47 of
msgid "The posterior distribution is as follows:"
msgstr "事後分布は以下の通りです："

#: bayesml.normal:49 of
#, python-brace-format
msgid ":math:`x^n = (x_1, x_2, \\dots , x_n) \\in \\mathbb{R}^n`: given data"
msgstr ""
":math:`x^n = (x_1, x_2, \\dots , x_n) \\in \\mathbb{R}^n`: 与えられたデータ"

#: bayesml.normal:50 of
#, python-brace-format
msgid ":math:`m_n \\in \\mathbb{R}`: a hyperparameter"
msgstr ":math:`m_n \\in \\mathbb{R}`: ハイパーパラメータ"

#: bayesml.normal:51 of
#, python-brace-format
msgid ":math:`\\kappa_n \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\kappa_n \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.normal:52 of
#, python-brace-format
msgid ":math:`\\alpha_n \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\alpha_n \\in \\mathbb{R}_{>0}`:ハイパーパラメータ"

#: bayesml.normal:53 of
#, python-brace-format
msgid ":math:`\\beta_n \\in \\mathbb{R}_{>0}`: a hyperparameter"
msgstr ":math:`\\beta_n \\in \\mathbb{R}_{>0}`: ハイパーパラメータ"

#: bayesml.normal:56 of
msgid ""
"p(\\mu, \\tau | x^n) &= \\mathcal{N}(\\mu|m_n,(\\kappa_n \\tau)^{-1}) "
"\\mathrm{Gam}(\\tau | \\alpha_n, \\beta_n) \\\\\n"
"&= \\sqrt{\\frac{\\kappa_n \\tau}{2\\pi}} \\exp \\left\\{ -\\frac{\\kappa_n "
"\\tau}{2}(\\mu-m_n)^2 \\right\\} \\frac{\\beta_n^{\\alpha_n}}{\\Gamma "
"(\\alpha_n)} \\tau^{\\alpha_n - 1} \\exp \\{ -\\beta_n \\tau \\},\n"
"\n"
msgstr ""
"p(\\mu, \\tau | x^n) &= \\mathcal{N}(\\mu|m_n,(\\kappa_n \\tau)^{-1}) "
"\\mathrm{Gam}(\\tau | \\alpha_n, \\beta_n) \\\\\n"
"&= \\sqrt{\\frac{\\kappa_n \\tau}{2\\pi}} \\exp \\left\\{ -\\frac{\\kappa_n "
"\\tau}{2}(\\mu-m_n)^2 \\right\\} \\frac{\\beta_n^{\\alpha_n}}{\\Gamma "
"(\\alpha_n)} \\tau^{\\alpha_n - 1} \\exp \\{ -\\beta_n \\tau \\},\n"
"\n"

#: bayesml.normal:60 of
#, python-brace-format
msgid ""
"\\mathbb{E}[\\mu | x^n] &= m_n & \\left( \\alpha_n > \\frac{1}{2} \\right), \\"
"\\\n"
"\\mathbb{V}[\\mu | x^n] &= \\frac{\\beta_n}{\\kappa_n (\\alpha_n - 1)} & "
"(\\alpha_n > 1), \\\\\n"
"\\mathbb{E}[\\tau | x^n] &= \\frac{\\alpha_n}{\\beta_n}, \\\\\n"
"\\mathbb{V}[\\tau | x^n] &= \\frac{\\alpha_n}{\\beta_n^2},\n"
"\n"
msgstr ""
"\\mathbb{E}[\\mu | x^n] &= m_n & \\left( \\alpha_n > \\frac{1}{2} \\right), \\"
"\\\n"
"\\mathbb{V}[\\mu | x^n] &= \\frac{\\beta_n}{\\kappa_n (\\alpha_n - 1)} & "
"(\\alpha_n > 1), \\\\\n"
"\\mathbb{E}[\\tau | x^n] &= \\frac{\\alpha_n}{\\beta_n}, \\\\\n"
"\\mathbb{V}[\\tau | x^n] &= \\frac{\\alpha_n}{\\beta_n^2},\n"
"\n"

#: bayesml.normal:66 of
msgid "where the updating rule of the hyperparameters is"
msgstr "ここでハイパーパラメータの更新式は以下で与えられます"

#: bayesml.normal:68 of
msgid ""
"\\bar{x} &= \\frac{1}{n} \\sum_{i=1}^n x_i, \\\\\n"
"m_n &= \\frac{\\kappa_0 m_0 + n \\bar{x}}{\\kappa_0 + n}, \\\\\n"
"\\kappa_n &= \\kappa_0 + n, \\\\\n"
"\\alpha_n &= \\alpha_0 + \\frac{n}{2}, \\\\\n"
"\\beta_n &=  \\beta_0 + \\frac{1}{2} \\left( \\sum_{i=1}^n (x_i - \\bar{x})^2 + "
"\\frac{\\kappa_0 n}{\\kappa_0 + n} (\\bar{x} - m_0)^2 \\right).\n"
"\n"
msgstr ""
"\\bar{x} &= \\frac{1}{n} \\sum_{i=1}^n x_i, \\\\\n"
"m_n &= \\frac{\\kappa_0 m_0 + n \\bar{x}}{\\kappa_0 + n}, \\\\\n"
"\\kappa_n &= \\kappa_0 + n, \\\\\n"
"\\alpha_n &= \\alpha_0 + \\frac{n}{2}, \\\\\n"
"\\beta_n &=  \\beta_0 + \\frac{1}{2} \\left( \\sum_{i=1}^n (x_i - \\bar{x})^2 + "
"\\frac{\\kappa_0 n}{\\kappa_0 + n} (\\bar{x} - m_0)^2 \\right).\n"
"\n"

#: bayesml.normal:76 of
msgid "Predictive Distribution"
msgstr "予測分布"

#: bayesml.normal:78 of
msgid "The predictive distribution is as follows:"
msgstr "予測分布は以下の通りです："

#: bayesml.normal:80 of
#, python-brace-format
msgid ":math:`x_{n+1} \\in \\mathbb{R}`: a new data point"
msgstr ":math:`x_{n+1} \\in \\mathbb{R}`: 新たなデータ点"

#: bayesml.normal:81 of
#, python-brace-format
msgid ""
":math:`\\mu_\\mathrm{p} \\in \\mathbb{R}`: the hyperparameter of the predictive "
"distribution"
msgstr ":math:`\\mu_\\mathrm{p} \\in \\mathbb{R}`: 予測分布のハイパーパラメータ"

#: bayesml.normal:82 of
#, python-brace-format
msgid ""
":math:`\\lambda_\\mathrm{p} \\in \\mathbb{R}_{>0}`: the hyperparameter of the "
"predictive distribution"
msgstr ""
":math:`\\lambda_\\mathrm{p} \\in \\mathbb{R}_{>0}`: 予測分布のハイパーパラメータ"

#: bayesml.normal:83 of
#, python-brace-format
msgid ""
":math:`\\nu_\\mathrm{p} \\in \\mathbb{R}_{>0}`: the hyperparameter of the "
"predictive distribution"
msgstr ""
":math:`\\nu_\\mathrm{p} \\in \\mathbb{R}_{>0}`: 予測分布のハイパーパラメータ"

#: bayesml.normal:85 of
msgid ""
"p(x_{n+1} | x^{n} ) &= \\mathrm{St}(x_{n+1} | \\mu_\\mathrm{p}, "
"\\lambda_\\mathrm{p}, \\nu_\\mathrm{p}) \\\\\n"
"&= \\frac{\\Gamma (\\nu_\\mathrm{p} / 2 + 1/2 )}{\\Gamma (\\nu_\\mathrm{p} / 2)} "
"\\left( \\frac{\\lambda_\\mathrm{p}}{\\pi \\nu_\\mathrm{p}} \\right)^{1/2} "
"\\left( 1 + \\frac{\\lambda_\\mathrm{p} (x_{n+1} - \\mu_\\mathrm{p})^2}"
"{\\nu_\\mathrm{p}} \\right)^{-\\nu_\\mathrm{p}/2 - 1/2},\n"
"\n"
msgstr ""
"p(x_{n+1} | x^{n} ) &= \\mathrm{St}(x_{n+1} | \\mu_\\mathrm{p}, "
"\\lambda_\\mathrm{p}, \\nu_\\mathrm{p}) \\\\\n"
"&= \\frac{\\Gamma (\\nu_\\mathrm{p} / 2 + 1/2 )}{\\Gamma (\\nu_\\mathrm{p} / 2)} "
"\\left( \\frac{\\lambda_\\mathrm{p}}{\\pi \\nu_\\mathrm{p}} \\right)^{1/2} "
"\\left( 1 + \\frac{\\lambda_\\mathrm{p} (x_{n+1} - \\mu_\\mathrm{p})^2}"
"{\\nu_\\mathrm{p}} \\right)^{-\\nu_\\mathrm{p}/2 - 1/2},\n"
"\n"

#: bayesml.normal:89 of
msgid ""
"\\mathbb{E}[x_{n+1} | x^n] &= \\mu_\\mathrm{p} & (\\nu_\\mathrm{p} > 1), \\\\\n"
"\\mathbb{V}[x_{n+1} | x^n] &= \\frac{1}{\\lambda_\\mathrm{p}} "
"\\frac{\\nu_\\mathrm{p}}{\\nu_\\mathrm{p}-2} & (\\nu_\\mathrm{p} > 2),\n"
"\n"
msgstr ""
"\\mathbb{E}[x_{n+1} | x^n] &= \\mu_\\mathrm{p} & (\\nu_\\mathrm{p} > 1), \\\\\n"
"\\mathbb{V}[x_{n+1} | x^n] &= \\frac{1}{\\lambda_\\mathrm{p}} "
"\\frac{\\nu_\\mathrm{p}}{\\nu_\\mathrm{p}-2} & (\\nu_\\mathrm{p} > 2),\n"
"\n"

#: bayesml.normal:94 of
msgid ""
"where the parameters are obtained from the hyperparameters of the posterior "
"distribution as follows:"
msgstr ""
"ここで、パラメータは事後分布のハイパーパラメータから以下のように求められます:"

#: bayesml.normal:96 of
#, python-brace-format
msgid ""
"\\mu_\\mathrm{p} &= \\mu_n, \\\\\n"
"\\lambda_\\mathrm{p} &= \\frac{\\kappa_n}{\\kappa_n + 1} \\frac{\\alpha_n}"
"{\\beta_n}, \\\\\n"
"\\nu_\\mathrm{p} &= 2 \\alpha_n.\n"
"\n"
msgstr ""
"\\mu_\\mathrm{p} &= \\mu_n, \\\\\n"
"\\lambda_\\mathrm{p} &= \\frac{\\kappa_n}{\\kappa_n + 1} \\frac{\\alpha_n}"
"{\\beta_n}, \\\\\n"
"\\nu_\\mathrm{p} &= 2 \\alpha_n.\n"
"\n"

