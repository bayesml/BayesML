msgstr "(mu_lower, mu_upper),(tau_lower, tau_upper): float"

#: bayesml.normal._normal.LearnModel.estimate_interval:15 of
msgid "The lower and the upper bounds of the intervals"
msgstr "区間の下端と上端"

