#: ../../bayesml.categorical.rst:2
msgid "bayesml.categorical package"
msgstr "bayesml.categorical package"

#: ../../bayesml.categorical.rst:7
msgid "Module contents"
msgstr "モジュール内容"

#: bayesml.categorical:1 of
msgid "The categorical distribution with the dirichlet prior distribution"
msgstr "ディリクレ事前分布を用いたカテゴリカル分布"

#: bayesml.categorical:3 of
msgid "The stochastic data generative model is as follows:"
msgstr "確率的データ生成モデルは以下の通りです："

#: bayesml.categorical:5 of
#, python-brace-format
msgid ":math:`d\\in \\mathbb{Z}`: a dimension (:math:`d \\geq 2`)"
msgstr ":math:`d\\in \\mathbb{Z}`: 次元 (:math:`d \\geq 2`)"

#: bayesml.categorical:6 of
#, python-brace-format
msgid ":math:`\\boldsymbol{x} \\in \\{ 0, 1\\}^d`: a data point, (a one-hot vector, i.e., :math:`\\sum_{k=1}^d x_k=1`)"
msgstr ":math:`\\boldsymbol{x} \\in \\{ 0, 1\\}^d`: データ点（one-hot ベクトル、すなわち :math:`\\sum_{k=1}^d x_k=1`）"

#: bayesml.categorical:7 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\theta} \\in [0, 1]^d`: a parameter, (:math:`\\sum_{k=1}^d \\theta_k=1`)"
msgstr ":math:`\\boldsymbol{\\theta} \\in [0, 1]^d`: パラメータ, (:math:`\\sum_{k=1}^d \\theta_k=1`)"

#: bayesml.categorical:9 of
#, python-brace-format
msgid ""
"p(\\boldsymbol{x} | \\boldsymbol{\\theta}) = \\mathrm{Cat}(\\boldsymbol{x}|\\boldsymbol{\\theta}) = \\prod_{k=1}^d "
"\\theta_k^{x_k},\n"
"\n"
msgstr ""
"p(\\boldsymbol{x} | \\boldsymbol{\\theta}) = \\mathrm{Cat}(\\boldsymbol{x}|\\boldsymbol{\\theta}) = \\prod_{k=1}^d "
"\\theta_k^{x_k},\n"
"\n"

#: bayesml.categorical:12 of
#, python-brace-format
msgid ""
"\\mathbb{E}[\\boldsymbol{x} | \\boldsymbol{\\theta}] &= \\boldsymbol{\\theta}, \\\\\n"
"\\mathbb{V}[x_k | \\boldsymbol{\\theta}] &= \\theta_k (1 - \\theta_k), \\\\\n"
"\\mathrm{Cov}[x_k, x_{k'} | \\boldsymbol{\\theta}] &= -\\theta_k \\theta_{k'}.\n"
"\n"
msgstr ""
"\\mathbb{E}[\\boldsymbol{x} | \\boldsymbol{\\theta}] &= \\boldsymbol{\\theta}, \\\\\n"
"\\mathbb{V}[x_k | \\boldsymbol{\\theta}] &= \\theta_k (1 - \\theta_k), \\\\\n"
"\\mathrm{Cov}[x_k, x_{k'} | \\boldsymbol{\\theta}] &= -\\theta_k \\theta_{k'}.\n"
"\n"

#: bayesml.categorical:18 of
msgid "The prior distribution is as follows:"
msgstr "事前分布は以下の通りです："

#: bayesml.categorical:20 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\alpha}_0 \\in \\mathbb{R}_{>0}^d`: a hyperparameter"
msgstr ":math:`\\boldsymbol{\\alpha}_0 \\in \\mathbb{R}_{>0}^d`: ハイパーパラメータ"

#: bayesml.categorical:21 of
msgid ":math:`\\Gamma (\\cdot)`: the gamma function"
msgstr ":math:`\\Gamma (\\cdot)`: ガンマ関数"

#: bayesml.categorical:22 of
#, python-brace-format
msgid ":math:`\\tilde{\\alpha}_0 = \\sum_{k=1}^d \\alpha_{0,k}`"
msgstr ":math:`\\tilde{\\alpha}_0 = \\sum_{k=1}^d \\alpha_{0,k}`"

#: bayesml.categorical:23 of
msgid ":math:`C(\\boldsymbol{\\alpha}_0)=\\frac{\\Gamma(\\tilde{\\alpha}_0)}{\\Gamma(\\alpha_{0,1})\\cdots\\Gamma(\\alpha_{0,d})}`"
msgstr ""
":math:`C(\\boldsymbol{\\alpha}_0)=\\frac{\\Gamma(\\tilde{\\alpha}_0)}{\\Gamma(\\alpha_{0,1})\\cdots\\Gamma(\\alpha_{0,d})}`"

#: bayesml.categorical:25 of
msgid ""
"p(\\boldsymbol{\\theta}) = \\mathrm{Dir}(\\boldsymbol{\\theta}|\\boldsymbol{\\alpha}_0) = C(\\boldsymbol{\\alpha}_0)\\prod_{k=1}"
"^d\\theta_k^{\\alpha_{0,k}-1},\n"
"\n"
msgstr ""
"p(\\boldsymbol{\\theta}) = \\mathrm{Dir}(\\boldsymbol{\\theta}|\\boldsymbol{\\alpha}_0) = C(\\boldsymbol{\\alpha}_0)\\prod_{k=1}"
"^d\\theta_k^{\\alpha_{0,k}-1},\n"
"\n"

#: bayesml.categorical:28 of
msgid ""
"\\mathbb{E}[\\boldsymbol{\\theta}] &= \\frac{\\boldsymbol{\\alpha}_0}{\\tilde{\\alpha}_0}, \\\\\n"
"\\mathbb{V}[\\theta_k] &= \\frac{1}{\\tilde{\\alpha}_0 + 1} \\frac{\\alpha_{0,k}}{\\tilde{\\alpha}_0} \\left(1 - "
"\\frac{\\alpha_{0,k}}{\\tilde{\\alpha}_0} \\right), \\\\\n"
"\\mathrm{Cov}[\\theta_k, \\theta_{k'}] &= - \\frac{1}{\\tilde{\\alpha}_0 + 1} \\frac{\\alpha_{0,k}}{\\tilde{\\alpha}_0} "
"\\frac{\\alpha_{0,k'}}{\\tilde{\\alpha}_0}.\n"
"\n"
msgstr ""
"\\mathbb{E}[\\boldsymbol{\\theta}] &= \\frac{\\boldsymbol{\\alpha}_0}{\\tilde{\\alpha}_0}, \\\\\n"
"\\mathbb{V}[\\theta_k] &= \\frac{1}{\\tilde{\\alpha}_0 + 1} \\frac{\\alpha_{0,k}}{\\tilde{\\alpha}_0} \\left(1 - "
"\\frac{\\alpha_{0,k}}{\\tilde{\\alpha}_0} \\right), \\\\\n"
"\\mathrm{Cov}[\\theta_k, \\theta_{k'}] &= - \\frac{1}{\\tilde{\\alpha}_0 + 1} \\frac{\\alpha_{0,k}}{\\tilde{\\alpha}_0} "
"\\frac{\\alpha_{0,k'}}{\\tilde{\\alpha}_0}.\n"
"\n"

#: bayesml.categorical:33 of
msgid "The posterior distribution is as follows:"
msgstr "事後分布は以下の通りです："

#: bayesml.categorical:35 of
#, python-brace-format
msgid ""
":math:`\\boldsymbol{x}^n = (\\boldsymbol{x}_1, \\boldsymbol{x}_2, \\dots , \\boldsymbol{x}_n) \\in \\{ 0, 1\\}^{d\\times n}`: "
"given data"
msgstr ""
":math:`\\boldsymbol{x}^n = (\\boldsymbol{x}_1, \\boldsymbol{x}_2, \\dots , \\boldsymbol{x}_n) \\in \\{ 0, 1\\}^{d\\times n}`: 与"
"えられたデータ"

#: bayesml.categorical:36 of
#, python-brace-format
msgid ":math:`\\boldsymbol{\\alpha}_n \\in \\mathbb{R}_{>0}^d`: a hyperparameter"
msgstr ":math:`\\boldsymbol{\\alpha}_n \\in \\mathbb{R}_{>0}^d`: ハイパーパラメータ"

#: bayesml.categorical:37 of
#, python-brace-format
msgid ":math:`\\tilde{\\alpha}_n = \\sum_{k=1}^d \\alpha_{n,k}`"
msgstr ":math:`\\tilde{\\alpha}_n = \\sum_{k=1}^d \\alpha_{n,k}`"

#: bayesml.categorical:38 of
msgid ":math:`C(\\boldsymbol{\\alpha}_n)=\\frac{\\Gamma(\\tilde{\\alpha}_n)}{\\Gamma(\\alpha_{n,1})\\cdots\\Gamma(\\alpha_{n,d})}`"
msgstr ""
":math:`C(\\boldsymbol{\\alpha}_n)=\\frac{\\Gamma(\\tilde{\\alpha}_n)}{\\Gamma(\\alpha_{n,1})\\cdots\\Gamma(\\alpha_{n,d})}`"

#: bayesml.categorical:40 of
msgid ""
"p(\\boldsymbol{\\theta} | \\boldsymbol{x}^n) = \\mathrm{Dir}(\\boldsymbol{\\theta}|\\boldsymbol{\\alpha}_n) = "
"C(\\boldsymbol{\\alpha}_n)\\prod_{k=1}^d\\theta_k^{\\alpha_{n,k}-1},\n"
"\n"
msgstr ""
"p(\\boldsymbol{\\theta} | \\boldsymbol{x}^n) = \\mathrm{Dir}(\\boldsymbol{\\theta}|\\boldsymbol{\\alpha}_n) = "
"C(\\boldsymbol{\\alpha}_n)\\prod_{k=1}^d\\theta_k^{\\alpha_{n,k}-1},\n"
"\n"

#: bayesml.categorical:43 of
msgid ""
"\\mathbb{E}[\\boldsymbol{\\theta} | \\boldsymbol{x}^n] &= \\frac{\\boldsymbol{\\alpha}_n}{\\tilde{\\alpha}_n}, \\\\\n"
"\\mathbb{V}[\\theta_k | \\boldsymbol{x}^n] &= \\frac{1}{\\tilde{\\alpha}_n + 1} \\frac{\\alpha_{n,k}}{\\tilde{\\alpha}_n} "
"\\left(1 - \\frac{\\alpha_{n,k}}{\\tilde{\\alpha}_n} \\right), \\\\\n"
"\\mathrm{Cov}[\\theta_k, \\theta_{k'} | \\boldsymbol{x}^n] &= - \\frac{1}{\\tilde{\\alpha}_n + 1} \\frac{\\alpha_{n,k}}"
"{\\tilde{\\alpha}_n} \\frac{\\alpha_{n,k'}}{\\tilde{\\alpha}_n},\n"
"\n"
msgstr ""
"\\mathbb{E}[\\boldsymbol{\\theta} | \\boldsymbol{x}^n] &= \\frac{\\boldsymbol{\\alpha}_n}{\\tilde{\\alpha}_n}, \\\\\n"
"\\mathbb{V}[\\theta_k | \\boldsymbol{x}^n] &= \\frac{1}{\\tilde{\\alpha}_n + 1} \\frac{\\alpha_{n,k}}{\\tilde{\\alpha}_n} "
"\\left(1 - \\frac{\\alpha_{n,k}}{\\tilde{\\alpha}_n} \\right), \\\\\n"
"\\mathrm{Cov}[\\theta_k, \\theta_{k'} | \\boldsymbol{x}^n] &= - \\frac{1}{\\tilde{\\alpha}_n + 1} \\frac{\\alpha_{n,k}}"
"{\\tilde{\\alpha}_n} \\frac{\\alpha_{n,k'}}{\\tilde{\\alpha}_n},\n"
"\n"

#: bayesml.categorical:48 of
msgid "where the updating rule of the hyperparameters is as follows."
msgstr "ハイパーパラメータの更新ルールは以下の通りです。"

#: bayesml.categorical:50 of
#, python-brace-format
msgid ""
"\\alpha_{n,k} = \\alpha_{0,k} + \\sum_{i=1}^n x_{i,k}, \\quad (k \\in \\{ 1, 2, \\dots , d \\}).\n"
"\n"
msgstr ""
"\\alpha_{n,k} = \\alpha_{0,k} + \\sum_{i=1}^n x_{i,k}, \\quad (k \\in \\{ 1, 2, \\dots , d \\}).\n"
"\n"

#: bayesml.categorical:53 of
msgid "The predictive distribution is as follows:"
msgstr "予測分布は以下の通りです："

#: bayesml.categorical:55 of
#, python-brace-format
msgid ":math:`\\boldsymbol{x}_{n+1} \\in \\{ 0, 1\\}^d`: a new data point"
msgstr ":math:`\\boldsymbol{x}_{n+1} \\in \\{ 0, 1\\}^d`: 新たなデータ点"

#: bayesml.categorical:56 of
msgid ""
":math:`\\boldsymbol{\\theta}_\\mathrm{p} \\in [0, 1]^d`: the hyperparameter of the posterior (:math:`\\sum_{k=1}^d "
"\\theta_{\\mathrm{p},k} = 1`)"
msgstr ""
":math:`\\boldsymbol{\\theta}_\\mathrm{p} \\in [0, 1]^d`: 事後分布のハイパーパラメータ (:math:`\\sum_{k=1}^d "
"\\theta_{\\mathrm{p},k} = 1`)"

#: bayesml.categorical:58 of
msgid ""
"p(\\boldsymbol{x}_{n+1} | \\boldsymbol{x}^n) = \\mathrm{Cat}(\\boldsymbol{x}_{n+1}|\\boldsymbol{\\theta}_\\mathrm{p}) = "
"\\prod_{k=1}^d \\theta_{\\mathrm{p},k}^{x_{n+1,k}},\n"
"\n"
msgstr ""
"p(\\boldsymbol{x}_{n+1} | \\boldsymbol{x}^n) = \\mathrm{Cat}(\\boldsymbol{x}_{n+1}|\\boldsymbol{\\theta}_\\mathrm{p}) = "
"\\prod_{k=1}^d \\theta_{\\mathrm{p},k}^{x_{n+1,k}},\n"
"\n"

#: bayesml.categorical:61 of
msgid ""
"\\mathbb{E}[\\boldsymbol{x}_{n+1} | \\boldsymbol{x}^n] &= \\boldsymbol{\\theta}_\\mathrm{p}, \\\\\n"
"\\mathbb{V}[x_{n+1,k} | \\boldsymbol{x}^n] &= \\theta_{\\mathrm{p},k} (1 - \\theta_{\\mathrm{p},k}), \\\\\n"
"\\mathrm{Cov}[x_{n+1,k}, x_{n+1,k'} | \\boldsymbol{x}^n] &= -\\theta_{\\mathrm{p},k} \\theta_{\\mathrm{p},k'},\n"
"\n"
msgstr ""
"\\mathbb{E}[\\boldsymbol{x}_{n+1} | \\boldsymbol{x}^n] &= \\boldsymbol{\\theta}_\\mathrm{p}, \\\\\n"
"\\mathbb{V}[x_{n+1,k} | \\boldsymbol{x}^n] &= \\theta_{\\mathrm{p},k} (1 - \\theta_{\\mathrm{p},k}), \\\\\n"
"\\mathrm{Cov}[x_{n+1,k}, x_{n+1,k'} | \\boldsymbol{x}^n] &= -\\theta_{\\mathrm{p},k} \\theta_{\\mathrm{p},k'},\n"
"\n"

#: bayesml.categorical:66 of
msgid "where the parameters are obtained from the hyperparameters of the posterior distribution as follows:"
msgstr "ここで、パラメータは事後分布のハイパーパラメータから以下のように求められます:"

#: bayesml.categorical:68 of
msgid ""
"\\theta_{\\mathrm{p},k} = \\frac{\\alpha_{n,k}}{\\sum_{k=1}^d \\alpha_{n,k}}, \\quad (k \\in \\{ 1, 2, \\dots , d \\}).\n"
"\n"
msgstr ""
"\\theta_{\\mathrm{p},k} = \\frac{\\alpha_{n,k}}{\\sum_{k=1}^d \\alpha_{n,k}}, \\quad (k \\in \\{ 1, 2, \\dots , d \\}).\n"
"\n"

